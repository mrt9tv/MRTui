using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.IO;
using System.IO.MemoryMappedFiles;
using System.Linq;
using System.Runtime.InteropServices;
using System.Runtime.Versioning;
using System.Text;
using System.Threading;
using System.Threading.Tasks;
using Microsoft.Extensions.Logging;

namespace iRacingOverlay.Core.Telemetry
{
    /// <summary>
    /// Custom iRacing SDK implementation using memory mapped files
    /// This provides direct access to iRacing telemetry data without external dependencies
    /// </summary>
    [SupportedOSPlatform("windows")]
    public class CustomIRacingSDK : IDisposable
    {
        private readonly ILogger<CustomIRacingSDK> _logger;
        
        // .NET managed approach (fallback)
        private MemoryMappedFile? _dataMemoryMappedFile;
        private MemoryMappedViewAccessor? _dataViewAccessor;
        
        // Direct Win32 API approach (primary)
        private IntPtr _hMemMapFile = IntPtr.Zero;
        private IntPtr _pSharedMem = IntPtr.Zero;
        private bool _usingDirectAccess = false;
        
        private bool _isConnected;
        private bool _disposed;
        private Timer? _dataUpdateTimer;
        private CancellationTokenSource? _cancellationTokenSource;
        
        // iRacing memory mapped file constants
        // Note: The exact name might need to be verified with actual iRacing installation
        private const string IRSDK_MEMMAPFILENAME = "Local\\IRSDKMemMapFileName";
        private const string IRSDK_MEMMAPFILENAME_ALT = "IRSDKMemMapFileName"; // Alternative without Local\\ prefix
        private const string IRSDK_DATAVALIDEVENTNAME = "Local\\IRSDKDataValidEvent"; // Data valid event name
        private const int IRSDK_MAX_BUFS = 4;
        private const int IRSDK_MAX_STRING = 32;
        
        // Data update frequency (60Hz target) - fallback if event monitoring fails
        private readonly TimeSpan _updateInterval = TimeSpan.FromMilliseconds(16.67); // ~60Hz
        
        // Event-based monitoring (preferred method per reference guide)
        private IntPtr _dataValidEvent = IntPtr.Zero;
        private Thread? _eventMonitorThread;
        private int _lastValidTick = 0; // Track last valid tick for freshness checking

        public bool IsConnected => _isConnected && !_disposed;
        public SessionState CurrentSessionState { get; private set; } = SessionState.Unknown;

        public event EventHandler? Connected;
        public event EventHandler? Disconnected; 
        public event EventHandler? TelemetryDataUpdated;
        public event EventHandler<SessionState>? SessionStateChanged;

        public CustomIRacingSDK(ILogger<CustomIRacingSDK> logger)
        {
            _logger = logger;
        }

        public async Task<bool> ConnectAsync(CancellationToken cancellationToken = default)
        {
            if (_disposed)
                throw new ObjectDisposedException(nameof(CustomIRacingSDK));

            if (_isConnected)
                return true;

            try
            {
                _logger.LogInformation("Attempting to connect to iRacing...");
                
                // Check for various iRacing process names
                var processNames = new[] { "iRacingSim64", "iRacingSim64DX11", "iRacingService", "iRacingSim" };
                var iRacingProcesses = new List<Process>();
                
                foreach (var processName in processNames)
                {
                    var processes = Process.GetProcessesByName(processName);
                    if (processes.Length > 0)
                    {
                        _logger.LogInformation("Found {ProcessCount} '{ProcessName}' processes", processes.Length, processName);
                        iRacingProcesses.AddRange(processes);
                    }
                }
                
                _logger.LogInformation("Total iRacing processes found: {ProcessCount}", iRacingProcesses.Count);
                
                if (iRacingProcesses.Count == 0)
                {
                    _logger.LogWarning("iRacing is not running. Please start iRacing and enter a session.");
                    return false;
                }
                
                // Dispose process handles
                foreach (var process in iRacingProcesses)
                    process.Dispose();

                _logger.LogInformation("Looking for memory mapped file: {FileName}", IRSDK_MEMMAPFILENAME);

                // Try direct Win32 API approach first (more permissive)
                bool directAccessSuccess = TryDirectMemoryAccess();
                
                if (!directAccessSuccess)
                {
                    _logger.LogInformation("Direct access failed, trying .NET managed approach...");
                    
                    // Fallback to .NET managed approach
                    MemoryMappedFile? mmf = null;
                    try
                    {
                        mmf = MemoryMappedFile.OpenExisting(IRSDK_MEMMAPFILENAME);
                        _logger.LogInformation("Successfully opened iRacing memory mapped file with primary name (managed)");
                    }
                    catch (FileNotFoundException)
                    {
                        _logger.LogInformation("Primary MMF name failed, trying alternative: {FileName}", IRSDK_MEMMAPFILENAME_ALT);
                        try
                        {
                            mmf = MemoryMappedFile.OpenExisting(IRSDK_MEMMAPFILENAME_ALT);
                            _logger.LogInformation("Successfully opened iRacing memory mapped file with alternative name (managed)");
                        }
                        catch (FileNotFoundException)
                        {
                            _logger.LogWarning("Neither memory mapped file name worked - iRacing may not be running or in session");
                            throw new FileNotFoundException($"Could not find iRacing memory mapped file. Tried: {IRSDK_MEMMAPFILENAME}, {IRSDK_MEMMAPFILENAME_ALT}");
                        }
                    }

                    _dataMemoryMappedFile = mmf;
                    _dataViewAccessor = _dataMemoryMappedFile.CreateViewAccessor();
                    _logger.LogInformation("Created memory view accessor (managed)");
                    _usingDirectAccess = false;
                }
                else
                {
                    _logger.LogInformation("Successfully connected using direct Win32 API access");
                    _usingDirectAccess = true;
                }

                // Validate that we have valid data
                var header = ReadHeader();
                _logger.LogInformation("Read header - Version: {Version}, Status: {Status}, TickRate: {TickRate}, IsValid: {IsValid}, Method: {Method}", 
                    header.Version, header.Status, header.TickRate, header.IsValid, _usingDirectAccess ? "Direct" : "Managed");

                if (header.IsValid)
                {
                    _isConnected = true;
                    
                    // Parse variable headers to get correct offsets
                    _logger.LogInformation("First connection established - parsing iRacing variable headers...");
                    Console.WriteLine("=== FIRST CONNECTION - STARTING VARIABLE PARSING ===");
                    ParseVariableHeaders();
                    
                    // Debug: More comprehensive memory analysis
                    Console.WriteLine("=== MEMORY ANALYSIS ON FIRST CONNECTION ===");
                    DebugDumpMemory(0, 128); // Dump first 128 bytes (header area)
                    
                    // If variable parsing failed, try manual header analysis
                    if (!_variablesCached || _variableCache.Count == 0)
                    {
                        Console.WriteLine("=== VARIABLE PARSING FAILED - MANUAL HEADER ANALYSIS ===");
                        var debugHeader = ReadSDKHeader();
                        DebugDumpMemory(debugHeader.VarHeaderOffset, 256); // Dump variable header area
                    }
                    else
                    {
                        Console.WriteLine($"=== VARIABLE PARSING SUCCESS - {_variableCache.Count} variables cached ===");
                    }
                    
                    // Try to open the data valid event for efficient monitoring (recommended by reference guide)
                    _logger.LogInformation("Attempting to open iRacing data valid event: {EventName}", IRSDK_DATAVALIDEVENTNAME);
                    _dataValidEvent = Win32Api.OpenEvent(Win32Api.EVENT_ALL_ACCESS, false, IRSDK_DATAVALIDEVENTNAME);
                    
                    if (_dataValidEvent != IntPtr.Zero)
                    {
                        _logger.LogInformation("Successfully opened data valid event - using event-based monitoring (recommended)");
                        
                        // Start event monitoring thread
                        _cancellationTokenSource = new CancellationTokenSource();
                        _eventMonitorThread = new Thread(() => EventMonitorThreadProc(_cancellationTokenSource.Token))
                        {
                            Name = "iRacing Event Monitor",
                            IsBackground = true
                        };
                        _eventMonitorThread.Start();
                    }
                    else
                    {
                        _logger.LogWarning("Could not open data valid event - falling back to timer-based polling");
                        
                        // Fallback to timer-based approach
                        _cancellationTokenSource = new CancellationTokenSource();
                        _dataUpdateTimer = new Timer(TelemetryUpdateCallback, null, TimeSpan.Zero, _updateInterval);
                    }
                    
                    _logger.LogInformation("Successfully connected to iRacing SDK - starting 60Hz telemetry updates");
                    
                    // DEBUG: Parse variables and show what we have
                    if (!_variablesCached)
                    {
                        Console.WriteLine("FORCING variable parsing on connection...");
                        ParseVariableHeaders();
                    }
                    Console.WriteLine("DEBUG: Listing cached variables after connection...");
                    DebugListCachedVariables();
                    
                    Connected?.Invoke(this, EventArgs.Empty);
                    return true;
                }
                else
                {
                    _logger.LogWarning("Connected to iRacing memory, but data appears invalid - Header: Version={Version}, Status={Status}, TickRate={TickRate}", 
                        header.Version, header.Status, header.TickRate);
                    await DisconnectAsync();
                    return false;
                }
            }
            catch (FileNotFoundException ex)
            {
                _logger.LogWarning("iRacing memory mapped file not found - iRacing may not be running or no active session. File: {FileName}, Error: {Error}", 
                    IRSDK_MEMMAPFILENAME, ex.Message);
                return false;
            }
            catch (UnauthorizedAccessException ex)
            {
                _logger.LogError("Access denied to iRacing memory mapped file - Administrator privileges may be required. Error: {Error}", ex.Message);
                return false;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Failed to connect to iRacing SDK - Unexpected error");
                await DisconnectAsync();
                return false;
            }
        }

        public async Task DisconnectAsync()
        {
            if (!_isConnected)
                return;

            try
            {
                _logger.LogInformation("Disconnecting from iRacing SDK...");

                // Stop data updates
                _cancellationTokenSource?.Cancel();
                
                // Clean up event monitoring
                if (_eventMonitorThread != null)
                {
                    _logger.LogInformation("Stopping event monitor thread...");
                    _eventMonitorThread.Join(TimeSpan.FromSeconds(2)); // Wait up to 2 seconds
                    _eventMonitorThread = null;
                }
                
                if (_dataValidEvent != IntPtr.Zero)
                {
                    Win32Api.CloseHandle(_dataValidEvent);
                    _dataValidEvent = IntPtr.Zero;
                }
                
                // Clean up timer fallback
                _dataUpdateTimer?.Change(Timeout.Infinite, Timeout.Infinite);
                _dataUpdateTimer?.Dispose();
                _dataUpdateTimer = null;

                // Clean up direct access if used
                if (_usingDirectAccess)
                {
                    CleanupDirectAccess();
                    _usingDirectAccess = false;
                }
                else
                {
                    // Clean up managed access
                    _dataViewAccessor?.Dispose();
                    _dataViewAccessor = null;

                    _dataMemoryMappedFile?.Dispose();
                    _dataMemoryMappedFile = null;
                }

                _isConnected = false;
                
                _logger.LogInformation("Disconnected from iRacing SDK");
                Disconnected?.Invoke(this, EventArgs.Empty);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error during SDK disconnection");
            }

            // Small delay to allow cleanup
            await Task.Delay(10);
        }

        public float GetFloat(string variableName)
        {
            if (!IsConnected)
                return 0f;
                
            if (_usingDirectAccess && _pSharedMem == IntPtr.Zero)
                return 0f;
                
            if (!_usingDirectAccess && _dataViewAccessor == null)
                return 0f;

            try
            {
                // CRITICAL: Add explicit variable cache debugging
                Console.WriteLine($"=== GetFloat('{variableName}') called ===");
                Console.WriteLine($"Variables cached: {_variablesCached}");
                Console.WriteLine($"Variable cache count: {_variableCache.Count}");
                
                // Parse variable headers if not done yet
                if (!_variablesCached)
                {
                    Console.WriteLine("Variables not cached - calling ParseVariableHeaders()");
                    ParseVariableHeaders();
                    Console.WriteLine($"After parsing - cached: {_variablesCached}, count: {_variableCache.Count}");
                }
                else
                {
                    Console.WriteLine("Variables already cached");
                }

                // Look up the variable in our cache
                Console.WriteLine($"Searching for '{variableName}' in cache of {_variableCache.Count} variables");
                
                if (_variableCache.TryGetValue(variableName, out var varHeader))
                {
                    Console.WriteLine($"FOUND '{variableName}' in cache: Type={varHeader.Type}, Offset=0x{varHeader.Offset:X}, Count={varHeader.Count}");
                    
                    if (varHeader.Type == IRSDK_FLOAT) // Float type
                    {
                        int dataBufferOffset = GetCurrentDataBufferOffset();
                        int actualOffset = dataBufferOffset + varHeader.Offset;
                        
                        Console.WriteLine($"Buffer offset: 0x{dataBufferOffset:X}, Variable offset: 0x{varHeader.Offset:X}, Final offset: 0x{actualOffset:X}");
                        
                        var value = ReadFloatFromOffset(actualOffset);
                        Console.WriteLine($"Read value: {value} from offset 0x{actualOffset:X}");
                        
                        // Log more details for important variables
                        if (variableName == "Speed" || variableName == "RPM" || variableName == "Gear")
                        {
                            Console.WriteLine($"IMPORTANT VARIABLE '{variableName}' = {value}");
                            _logger.LogInformation("Read '{VariableName}' (float): DataBufferOffset=0x{DataOffset:X}, VarOffset=0x{VarOffset:X}, ActualOffset=0x{ActualOffset:X}, Value={Value}", 
                                variableName, dataBufferOffset, varHeader.Offset, actualOffset, value);
                        }
                        else
                        {
                            _logger.LogDebug("Read '{VariableName}' (float) from offset 0x{Offset:X}: {Value} {Unit}", 
                                variableName, actualOffset, value, varHeader.Unit);
                        }
                        return value;
                    }
                    else
                    {
                        Console.WriteLine($"ERROR: '{variableName}' is not a float (type: {varHeader.Type})");
                        _logger.LogWarning("Variable '{VariableName}' is not a float (type: {Type})", variableName, varHeader.Type);
                        return 0f;
                    }
                }
                else
                {
                    Console.WriteLine($"VARIABLE '{variableName}' NOT FOUND in cache");
                    _logger.LogWarning("Variable '{VariableName}' not found in variable cache", variableName);
                    
                    // List similar variables for debugging
                    var similarVars = _variableCache.Keys.Where(k => k.ToLower().Contains(variableName.ToLower())).ToList();
                    if (similarVars.Any())
                    {
                        Console.WriteLine($"Similar variables found: {string.Join(", ", similarVars)}");
                        _logger.LogInformation("Similar variables found: {Variables}", string.Join(", ", similarVars));
                    }
                    else
                    {
                        Console.WriteLine("No similar variables found");
                        // List first 20 variables in cache for debugging
                        var firstVars = string.Join(", ", _variableCache.Keys.Take(20));
                        Console.WriteLine($"First 20 variables in cache: {firstVars}");
                    }
                    
                    return 0f;
                }
            }
            catch (Exception ex)
            {
                _logger.LogWarning(ex, "Failed to read float variable: {VariableName}", variableName);
                return 0f;
            }
        }

        public double GetDouble(string variableName)
        {
            if (!IsConnected)
                return 0.0;
                
            if (_usingDirectAccess && _pSharedMem == IntPtr.Zero)
                return 0.0;
                
            if (!_usingDirectAccess && _dataViewAccessor == null)
                return 0.0;

            try
            {
                // Parse variable headers if not done yet
                if (!_variablesCached)
                    ParseVariableHeaders();

                // Look up the variable in our cache
                if (_variableCache.TryGetValue(variableName, out var varHeader))
                {
                    if (varHeader.Type == IRSDK_DOUBLE) // Double type
                    {
                        int dataBufferOffset = GetCurrentDataBufferOffset();
                        int actualOffset = dataBufferOffset + varHeader.Offset;
                        
                        var value = ReadDoubleFromOffset(actualOffset);
                        _logger.LogDebug("Read '{VariableName}' (double) from offset 0x{Offset:X}: {Value} {Unit}", 
                            variableName, actualOffset, value, varHeader.Unit);
                        return value;
                    }
                    else
                    {
                        _logger.LogWarning("Variable '{VariableName}' is not a double (type: {Type})", variableName, varHeader.Type);
                        return 0.0;
                    }
                }
                else
                {
                    _logger.LogWarning("Variable '{VariableName}' not found in variable cache", variableName);
                    return 0.0;
                }
            }
            catch (Exception ex)
            {
                _logger.LogWarning(ex, "Failed to read double variable: {VariableName}", variableName);
                return 0.0;
            }
        }

        public int GetInt(string variableName)
        {
            if (!IsConnected)
                return 0;
                
            if (_usingDirectAccess && _pSharedMem == IntPtr.Zero)
                return 0;
                
            if (!_usingDirectAccess && _dataViewAccessor == null)
                return 0;

            try
            {
                // Parse variable headers if not done yet
                if (!_variablesCached)
                    ParseVariableHeaders();

                // Look up the variable in our cache
                if (_variableCache.TryGetValue(variableName, out var varHeader))
                {
                    if (varHeader.Type == IRSDK_INT || varHeader.Type == IRSDK_BOOL || varHeader.Type == IRSDK_BITFIELD) // Int, bool, or bitfield types
                    {
                        int dataBufferOffset = GetCurrentDataBufferOffset();
                        int actualOffset = dataBufferOffset + varHeader.Offset;
                        
                        var value = ReadIntFromOffset(actualOffset);
                        _logger.LogDebug("Read '{VariableName}' (int) from offset 0x{Offset:X}: {Value} {Unit}", 
                            variableName, actualOffset, value, varHeader.Unit);
                        return value;
                    }
                    else
                    {
                        _logger.LogWarning("Variable '{VariableName}' is not an int (type: {Type})", variableName, varHeader.Type);
                        return 0;
                    }
                }
                else
                {
                    _logger.LogWarning("Variable '{VariableName}' not found in variable cache", variableName);
                    
                    // List all available variables for debugging
                    if (_variableCache.Count > 0)
                    {
                        var availableVars = string.Join(", ", _variableCache.Keys.Take(10));
                        _logger.LogInformation("Available variables (first 10): {Variables}", availableVars);
                    }
                    
                    return 0;
                }
            }
            catch (Exception ex)
            {
                _logger.LogWarning(ex, "Failed to read int variable: {VariableName}", variableName);
                return 0;
            }
        }

        /// <summary>
        /// Enhanced session state validation with comprehensive checking (as suggested in fixmaybe.md)
        /// </summary>
        public bool IsSessionStateValid()
        {
            try
            {
                var header = ReadHeader();
                
                // Check if iRacing is connected
                bool isConnected = (header.Status & IRSDK_STCONNECTED) != 0;
                if (!isConnected)
                {
                    _logger.LogInformation("Session state invalid: iRacing not connected");
                    return false;
                }

                var sessionState = CurrentSessionState;
                
                // Enhanced session state validation
                if (sessionState == SessionState.Racing || 
                    sessionState == SessionState.WarmUp || 
                    sessionState == SessionState.ParadeLaps ||
                    sessionState == SessionState.GetInCar)
                {
                    _logger.LogDebug("Session state valid for telemetry: {SessionState}", sessionState);
                    return true;
                }
                
                _logger.LogInformation("Session state not optimal for telemetry: {SessionState} - consider entering Practice/Race mode", sessionState);
                return false;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error validating session state");
                return false;
            }
        }

        /// <summary>
        /// Buffer freshness check to detect stale data (as suggested in fixmaybe.md)
        /// </summary>
        public bool IsBufferFresh(int maxStaleFrames = 300) // 5 seconds at 60Hz
        {
            try
            {
                var header = ReadSDKHeader();
                if (header.NumBuf <= 0 || header.VarBuf == null)
                    return false;

                int latestTick = 0;
                for (int i = 0; i < header.NumBuf && (i * 2 + 1) < header.VarBuf.Length; i++)
                {
                    int tickCount = header.VarBuf[i * 2 + 1];
                    if (tickCount > latestTick)
                        latestTick = tickCount;
                }

                // Check if we have a recent tick stored
                if (_lastValidTick == 0)
                {
                    _lastValidTick = latestTick;
                    return true;
                }

                int tickDifference = Math.Abs(latestTick - _lastValidTick);
                
                // Update last valid tick if this one is newer
                if (latestTick > _lastValidTick)
                    _lastValidTick = latestTick;

                if (tickDifference > maxStaleFrames)
                {
                    _logger.LogWarning("Buffer appears stale - tick difference: {TickDiff} (max: {MaxStale})", tickDifference, maxStaleFrames);
                    return false;
                }

                return true;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error checking buffer freshness");
                return false;
            }
        }

        /// <summary>
        /// Enhanced data validation testing multiple variables (as suggested in fixmaybe.md)
        /// </summary>
        public bool HasValidTelemetryData()
        {
            try
            {
                var testVariables = new[] { "Speed", "RPM", "Throttle", "Brake", "LapCurrentLapTime", "SessionTime" };
                int nonZeroCount = 0;
                int totalTested = 0;

                foreach (var varName in testVariables)
                {
                    try
                    {
                        if (_variableCache.ContainsKey(varName))
                        {
                            totalTested++;
                            var type = _variableCache[varName].Type;
                            
                            if (type == IRSDK_FLOAT)
                            {
                                var value = GetFloat(varName);
                                if (Math.Abs(value) > 0.001f) nonZeroCount++;
                            }
                            else if (type == IRSDK_DOUBLE)
                            {
                                var value = GetDouble(varName);
                                if (Math.Abs(value) > 0.001) nonZeroCount++;
                            }
                            else if (type == IRSDK_INT)
                            {
                                var value = GetInt(varName);
                                if (value != 0) nonZeroCount++;
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        _logger.LogDebug("Error testing variable {VarName}: {Error}", varName, ex.Message);
                    }
                }

                double nonZeroPercentage = totalTested > 0 ? (double)nonZeroCount / totalTested : 0;
                bool hasValidData = nonZeroPercentage > 0.1; // At least 10% of variables have non-zero values

                _logger.LogDebug("Telemetry validation: {NonZero}/{Total} variables non-zero ({Percentage:P})", 
                    nonZeroCount, totalTested, nonZeroPercentage);

                return hasValidData;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error validating telemetry data");
                return false;
            }
        }

        /// <summary>
        /// Comprehensive connection diagnostics (as suggested in fixmaybe.md)
        /// </summary>
        public void DiagnoseConnection()
        {
            try
            {
                Console.WriteLine("=== CONNECTION DIAGNOSTICS ===");
                _logger.LogInformation("=== CONNECTION DIAGNOSTICS ===");
                
                Console.WriteLine($"Connected: {IsConnected}");
                Console.WriteLine($"Session State: {CurrentSessionState}");
                
                if (IsConnected)
                {
                    var header = ReadHeader();
                    bool isConnectedFlag = (header.Status & IRSDK_STCONNECTED) != 0;
                    Console.WriteLine($"iRacing Connected Flag: {isConnectedFlag}");
                    Console.WriteLine($"Header Status: 0x{header.Status:X}");
                    
                    // Test session variables
                    if (_variableCache.ContainsKey("IsOnTrack"))
                    {
                        var isOnTrack = GetInt("IsOnTrack");
                        Console.WriteLine($"On Track: {isOnTrack != 0}");
                    }
                    
                    if (_variableCache.ContainsKey("IsInGarage"))
                    {
                        var isInGarage = GetInt("IsInGarage");
                        Console.WriteLine($"In Garage: {isInGarage != 0}");
                    }
                    
                    // Check data freshness
                    bool isFresh = IsBufferFresh();
                    Console.WriteLine($"Buffer Fresh: {isFresh}");
                    
                    // Check session state validity
                    bool sessionValid = IsSessionStateValid();
                    Console.WriteLine($"Session Valid: {sessionValid}");
                    
                    // Check for valid telemetry data
                    bool hasValidData = HasValidTelemetryData();
                    Console.WriteLine($"Has Valid Data: {hasValidData}");
                    
                    if (!hasValidData)
                    {
                        Console.WriteLine("\nRECOMMENDATIONS:");
                        Console.WriteLine("- Ensure you're in an active session (Practice/Qualify/Race)");
                        Console.WriteLine("- Make sure you're on track and not in the garage");
                        Console.WriteLine("- Try starting the engine and driving");
                        Console.WriteLine("- Exit replay mode if active");
                    }
                }
                
                Console.WriteLine("=== END DIAGNOSTICS ===");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Diagnostics error: {ex.Message}");
                _logger.LogError(ex, "Error running connection diagnostics");
            }
        }

