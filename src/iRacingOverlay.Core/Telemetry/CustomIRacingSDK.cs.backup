                else
                {
                    Console.WriteLine($"VARIABLE '{variableName}' NOT FOUND in cache");
                    _logger.LogWarning("Variable '{VariableName}' not found in variable cache", variableName);
                    
                    // List similar variables for debugging
                    var similarVars = _variableCache.Keys.Where(k => k.ToLower().Contains(variableName.ToLower())).ToList();
                    if (similarVars.Any())
                    {
                        Console.WriteLine($"Similar variables found: {string.Join(", ", similarVars)}");
                        _logger.LogInformation("Similar variables found: {Variables}", string.Join(", ", similarVars));
                    }
                    else
                    {
                        Console.WriteLine("No similar variables found");
                        // List first 20 variables in cache for debugging
                        var firstVars = string.Join(", ", _variableCache.Keys.Take(20));
                        Console.WriteLine($"First 20 variables in cache: {firstVars}");
                    }
                    
                    return 0f;
                }
            }
            catch (Exception ex)
            {
                _logger.LogWarning(ex, "Failed to read float variable: {VariableName}", variableName);
                return 0f;
            }
        }

        public double GetDouble(string variableName)
        {
            if (!IsConnected)
                return 0.0;
                
            if (_usingDirectAccess && _pSharedMem == IntPtr.Zero)
                return 0.0;
                
            if (!_usingDirectAccess && _dataViewAccessor == null)
                return 0.0;

            try
            {
                // Parse variable headers if not done yet
                if (!_variablesCached)
                    ParseVariableHeaders();

                // Look up the variable in our cache
                if (_variableCache.TryGetValue(variableName, out var varHeader))
                {
                    if (varHeader.Type == IRSDK_DOUBLE) // Double type
                    {
                        int dataBufferOffset = GetCurrentDataBufferOffset();
                        int actualOffset = dataBufferOffset + varHeader.Offset;
                        
                        var value = ReadDoubleFromOffset(actualOffset);
                        _logger.LogDebug("Read '{VariableName}' (double) from offset 0x{Offset:X}: {Value} {Unit}", 
                            variableName, actualOffset, value, varHeader.Unit);
                        return value;
                    }
                    else
                    {
                        _logger.LogWarning("Variable '{VariableName}' is not a double (type: {Type})", variableName, varHeader.Type);
                        return 0.0;
                    }
                }
                else
                {
                    _logger.LogWarning("Variable '{VariableName}' not found in variable cache", variableName);
                    return 0.0;
                }
            }
            catch (Exception ex)
            {
                _logger.LogWarning(ex, "Failed to read double variable: {VariableName}", variableName);
                return 0.0;
            }
        }

        public int GetInt(string variableName)
        {
            if (!IsConnected)
                return 0;
                
            if (_usingDirectAccess && _pSharedMem == IntPtr.Zero)
                return 0;
                
            if (!_usingDirectAccess && _dataViewAccessor == null)
                return 0;

            try
            {
                // Parse variable headers if not done yet
                if (!_variablesCached)
                    ParseVariableHeaders();

                // Look up the variable in our cache
                if (_variableCache.TryGetValue(variableName, out var varHeader))
                {
                    if (varHeader.Type == IRSDK_INT || varHeader.Type == IRSDK_BOOL || varHeader.Type == IRSDK_BITFIELD) // Int, bool, or bitfield types
                    {
                        int dataBufferOffset = GetCurrentDataBufferOffset();
                        int actualOffset = dataBufferOffset + varHeader.Offset;
                        
                        var value = ReadIntFromOffset(actualOffset);
                        _logger.LogDebug("Read '{VariableName}' (int) from offset 0x{Offset:X}: {Value} {Unit}", 
                            variableName, actualOffset, value, varHeader.Unit);
                        return value;
                    }
                    else
                    {
                        _logger.LogWarning("Variable '{VariableName}' is not an int (type: {Type})", variableName, varHeader.Type);
                        return 0;
                    }
                }
                else
                {
                    _logger.LogWarning("Variable '{VariableName}' not found in variable cache", variableName);
                    
                    // List all available variables for debugging
                    if (_variableCache.Count > 0)
                    {
                        var availableVars = string.Join(", ", _variableCache.Keys.Take(10));
                        _logger.LogInformation("Available variables (first 10): {Variables}", availableVars);
                    }
                    
                    return 0;
                }
            }
            catch (Exception ex)
            {
                _logger.LogWarning(ex, "Failed to read int variable: {VariableName}", variableName);
                return 0;
            }
        }

        /// <summary>
        /// Debug method to log all available telemetry variables and their current values
        /// </summary>
        public void LogAllAvailableVariables()
        {
            if (!IsConnected || !_variablesCached)
            {
                _logger.LogWarning("Cannot log variables - not connected or variables not cached");
                return;
            }

            _logger.LogInformation("=== Available iRacing Telemetry Variables ({Count} total) ===", _variableCache.Count);
            
            var dataBufferOffset = GetCurrentDataBufferOffset();
            _logger.LogInformation("Current data buffer offset: 0x{Offset:X}", dataBufferOffset);
            
            int loggedCount = 0;
            foreach (var kvp in _variableCache.OrderBy(x => x.Key))
            {
                var variable = kvp.Value;
                string typeName = GetVariableTypeName(variable.Type);
                
                try
                {
                    object? value = null;
                    switch (variable.Type)
                    {
                        case IRSDK_CHAR:
                        case IRSDK_BOOL:
                        case IRSDK_INT:
                        case IRSDK_BITFIELD:
                            value = GetInt(kvp.Key);
                            break;
                        case IRSDK_FLOAT:
                            value = GetFloat(kvp.Key);
                            break;
                        case IRSDK_DOUBLE:
                            value = GetDouble(kvp.Key);
                            break;
                        default:
                            value = "Unknown type";
                            break;
                    }
                    
                    _logger.LogInformation("  {Name}: {TypeName} @ offset 0x{Offset:X} = {Value} {Unit}", 
                        kvp.Key, typeName, variable.Offset, value, variable.Unit);
                    
                    loggedCount++;
                    if (loggedCount >= 50) // Limit output to prevent log spam
                    {
                        _logger.LogInformation("  ... (showing first 50 variables, {Total} total)", _variableCache.Count);
                        break;
                    }
                }
                catch (Exception ex)
                {
                    _logger.LogWarning("  {Name}: {TypeName} @ offset 0x{Offset:X} = ERROR: {Error}", 
                        kvp.Key, typeName, variable.Offset, ex.Message);
                }
            }
            
            _logger.LogInformation("=== End Variable List ===");
        }

        private string GetVariableTypeName(int type)
        {
            return type switch
            {
                IRSDK_CHAR => "char",
                IRSDK_BOOL => "bool", 
                IRSDK_INT => "int",
                IRSDK_BITFIELD => "bitfield",
                IRSDK_FLOAT => "float",
                IRSDK_DOUBLE => "double",
                _ => $"unknown({type})"
            };
        }

        private void TelemetryUpdateCallback(object? state)
        {
            if (!_isConnected || _disposed || _cancellationTokenSource?.Token.IsCancellationRequested == true)
                return;

            try
            {
                // Check if data is still available (for both access methods)
                bool hasValidAccess = _usingDirectAccess ? (_pSharedMem != IntPtr.Zero) : (_dataViewAccessor != null);
                
                if (hasValidAccess)
                {
                    var header = ReadHeader();
                    if (header.IsValid)
                    {
                        // Fire telemetry update event
                        TelemetryDataUpdated?.Invoke(this, EventArgs.Empty);
                    }
                    else
                    {
                        _logger.LogWarning("iRacing data is no longer valid - may need to reconnect");
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error in telemetry update callback");
                // Continue running - individual frame errors shouldn't stop the stream
            }
        }

        private void EventMonitorThreadProc(CancellationToken cancellationToken)
        {
            _logger.LogInformation("Event monitor thread started - monitoring iRacing data valid event");
            
            try
            {
                while (!cancellationToken.IsCancellationRequested && _isConnected && _dataValidEvent != IntPtr.Zero)
                {
                    // Wait for the data valid event to be signaled (with timeout)
                    uint waitResult = Win32Api.WaitForSingleObject(_dataValidEvent, 100); // 100ms timeout
                    
                    if (waitResult == Win32Api.WAIT_OBJECT_0)
                    {
                        // Event was signaled - new data is available
                        try
                        {
                            var header = ReadHeader();
                            if (header.IsValid)
                            {
                                // Fire telemetry update event
                                TelemetryDataUpdated?.Invoke(this, EventArgs.Empty);
                            }
                            else
                            {
                                _logger.LogWarning("iRacing data event signaled but data is invalid");
                            }
                        }
                        catch (Exception ex)
                        {
                            _logger.LogError(ex, "Error processing data valid event");
                        }
                    }
                    else if (waitResult == Win32Api.WAIT_TIMEOUT)
                    {
                        // Timeout - check if we're still connected
                        if (!_isConnected)
                            break;
                    }
                    else
                    {
                        _logger.LogWarning("Unexpected wait result: {Result}", waitResult);
                        break;
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Event monitor thread error");
            }
            finally
            {
                _logger.LogInformation("Event monitor thread ended");
            }
        }

        private float ReadFloatFromOffset(int offset)
        {
            try
            {
                float value;
                if (_usingDirectAccess && _pSharedMem != IntPtr.Zero)
                {
                    value = Marshal.PtrToStructure<float>(IntPtr.Add(_pSharedMem, offset));
                }
                else
                {
                    value = _dataViewAccessor?.ReadSingle(offset) ?? 0f;
                }
                
                // Debug: Dump raw bytes at this offset, especially when value is zero
                DumpRawBytesAtOffset(offset, value);
                
                // Python irsdk.py validation: check for reasonable values
                if (float.IsNaN(value) || float.IsInfinity(value))
                {
                    _logger.LogWarning("Invalid float value at offset 0x{Offset:X}: {Value} (NaN or Infinity)", offset, value);
                    return 0f;
                }
                
                return value;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Failed to read float from offset 0x{Offset:X}", offset);
                return 0f;
            }
        }

        private void DumpRawBytesAtOffset(int offset, float value)
        {
            try
            {
                byte[] bytes = new byte[4];
                
                if (_usingDirectAccess && _pSharedMem != IntPtr.Zero)
                {
                    Marshal.Copy(IntPtr.Add(_pSharedMem, offset), bytes, 0, 4);
                }
                else if (_dataViewAccessor != null)
                {
                    for (int i = 0; i < 4; i++)
                    {
                        bytes[i] = _dataViewAccessor.ReadByte(offset + i);
                    }
                }
                else
                {
                    Console.WriteLine($"[DumpRawBytes] No accessor available for offset 0x{offset:X}");
                    return;
                }
                
                var bytesHex = BitConverter.ToString(bytes);
                Console.WriteLine($"[DumpRawBytes] Offset 0x{offset:X}: {bytesHex} = {value}f");
                
                // If value is zero, dump surrounding area to look for data
                if (value == 0.0f)
                {
                    DumpSurroundingMemory(offset);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[DumpRawBytes] Error dumping bytes at offset 0x{offset:X}: {ex.Message}");
            }
        }

        private void DumpSurroundingMemory(int centerOffset)
        {
            try
            {
                int startOffset = Math.Max(0, centerOffset - 32); // 32 bytes before
                int endOffset = centerOffset + 32; // 32 bytes after
                int totalBytes = endOffset - startOffset;
                
                Console.WriteLine($"[SurroundingMemory] Dumping {totalBytes} bytes around offset 0x{centerOffset:X} (0x{startOffset:X} to 0x{endOffset-1:X}):");
                
                for (int offset = startOffset; offset < endOffset; offset += 16)
                {
                    byte[] chunk = new byte[Math.Min(16, endOffset - offset)];
                    
                    if (_usingDirectAccess && _pSharedMem != IntPtr.Zero)
                    {
                        Marshal.Copy(IntPtr.Add(_pSharedMem, offset), chunk, 0, chunk.Length);
                    }
                    else if (_dataViewAccessor != null)
                    {
                        for (int i = 0; i < chunk.Length; i++)
                        {
                            chunk[i] = _dataViewAccessor.ReadByte(offset + i);
                        }
                    }
                    else
                    {
                        Console.WriteLine($"[SurroundingMemory] No accessor available");
                        return;
                    }
                    
                    var bytesHex = BitConverter.ToString(chunk);
                    var isTargetLine = (offset <= centerOffset && centerOffset < offset + 16);
                    var marker = isTargetLine ? " <-- TARGET" : "";
                    Console.WriteLine($"  0x{offset:X8}: {bytesHex}{marker}");
                    
                    // Check if there are any non-zero bytes in this chunk
                    if (chunk.Any(b => b != 0))
                    {
                        Console.WriteLine($"    ^^ Non-zero data detected in this chunk!");
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[SurroundingMemory] Error dumping surrounding memory: {ex.Message}");
            }
        }

        private double ReadDoubleFromOffset(int offset)
        {
            if (_usingDirectAccess && _pSharedMem != IntPtr.Zero)
            {
                return Marshal.PtrToStructure<double>(IntPtr.Add(_pSharedMem, offset));
            }
            else
            {
                return _dataViewAccessor?.ReadDouble(offset) ?? 0.0;
            }
        }

        private int ReadIntFromOffset(int offset)
        {
            try
            {
                int value;
                if (_usingDirectAccess && _pSharedMem != IntPtr.Zero)
                {
                    value = Marshal.PtrToStructure<int>(IntPtr.Add(_pSharedMem, offset));
                }
                else
                {
                    value = _dataViewAccessor?.ReadInt32(offset) ?? 0;
                }
                
                return value;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Failed to read int from offset 0x{Offset:X}", offset);
                return 0;
            }
        }

        private IRacingHeader ReadHeader()
        {
            if (!_usingDirectAccess && _dataViewAccessor == null)
                return new IRacingHeader { IsValid = false };
                
            if (_usingDirectAccess && _pSharedMem == IntPtr.Zero)
                return new IRacingHeader { IsValid = false };

            try
            {
                // Read basic header information using appropriate method
                int version, status, tickRate;
                
                if (_usingDirectAccess)
                {
                    version = Marshal.ReadInt32(_pSharedMem, 0);
                    status = Marshal.ReadInt32(_pSharedMem, 4);
                    tickRate = Marshal.ReadInt32(_pSharedMem, 8);
                }
                else
                {
                    version = _dataViewAccessor!.ReadInt32(0);
                    status = _dataViewAccessor.ReadInt32(4);
                    tickRate = _dataViewAccessor.ReadInt32(8);
                }

                // Update session state and fire event if changed
                var newSessionState = (SessionState)status;
                if (newSessionState != CurrentSessionState)
                {
                    var oldState = CurrentSessionState;
                    CurrentSessionState = newSessionState;
                    _logger.LogInformation("Session state changed from {OldState} to {NewState}", oldState, newSessionState);
                    SessionStateChanged?.Invoke(this, newSessionState);
                }

                return new IRacingHeader
                {
                    Version = version,
                    Status = status,
                    TickRate = tickRate,
                    IsValid = version > 0 && tickRate > 0 && (status & IRSDK_STCONNECTED) != 0
                };
            }
            catch (Exception ex)
            {
                _logger.LogWarning(ex, "Failed to read iRacing header");
                return new IRacingHeader { IsValid = false };
            }
        }

        private bool TryDirectMemoryAccess()
        {
            try
            {
                _logger.LogInformation("Attempting direct Win32 API memory access...");
                
                // Try primary memory mapped file name first
                _hMemMapFile = Win32Api.OpenFileMapping(Win32Api.FILE_MAP_READ_ACCESS, false, IRSDK_MEMMAPFILENAME);
                
                if (_hMemMapFile == IntPtr.Zero)
                {
                    _logger.LogInformation("Primary MMF name failed with direct access, trying alternative: {FileName}", IRSDK_MEMMAPFILENAME_ALT);
                    _hMemMapFile = Win32Api.OpenFileMapping(Win32Api.FILE_MAP_READ_ACCESS, false, IRSDK_MEMMAPFILENAME_ALT);
                    
                    if (_hMemMapFile == IntPtr.Zero)
                    {
                        var lastError = Win32Api.GetLastError();
                        _logger.LogWarning("Direct memory access failed for both file names. Last error: {Error}", lastError);
                        return false;
                    }
                }
                
                // Map the entire file into memory
                _pSharedMem = Win32Api.MapViewOfFile(_hMemMapFile, Win32Api.FILE_MAP_READ_ACCESS, 0, 0, 0);
                
                if (_pSharedMem == IntPtr.Zero)
                {
                    var lastError = Win32Api.GetLastError();
                    _logger.LogError("Failed to map view of file. Last error: {Error}", lastError);
                    Win32Api.CloseHandle(_hMemMapFile);
                    _hMemMapFile = IntPtr.Zero;
                    return false;
                }
                
                _logger.LogInformation("Successfully established direct memory access");
                return true;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Exception during direct memory access attempt");
                CleanupDirectAccess();
                return false;
            }
        }

        private void CleanupDirectAccess()
        {
            if (_pSharedMem != IntPtr.Zero)
            {
                Win32Api.UnmapViewOfFile(_pSharedMem);
                _pSharedMem = IntPtr.Zero;
            }
            
            if (_hMemMapFile != IntPtr.Zero)
            {
                Win32Api.CloseHandle(_hMemMapFile);
                _hMemMapFile = IntPtr.Zero;
            }
        }

        public void Dispose()
        {
            if (_disposed)
                return;

            _disposed = true;
            DisconnectAsync().Wait();
            
            _cancellationTokenSource?.Dispose();
        }

        /// <summary>
        /// Debug method to scan memory for gear-like values
        /// Gear should be -1 (reverse), 0 (neutral), 1-8 (forward gears)
        /// </summary>
        public void DebugScanForGear()
        {
            if (!IsConnected)
            {
                _logger.LogWarning("Not connected - cannot scan for gear");
                return;
            }
            
            _logger.LogInformation("=== Scanning memory for gear-like values ===");
            
            // Scan the first 200 bytes of memory for int values that look like gear
            for (int offset = 0; offset < 200; offset += 4) // Step by 4 bytes (int size)
            {
                try
                {
                    int value = ReadIntFromOffset(offset);
                    
                    // Gear values are typically -1 to 8
                    if (value >= -1 && value <= 8)
                    {
                        _logger.LogInformation("Potential gear at offset 0x{Offset:X2}: {Value}", offset, value);
                    }
                    
                    // Also log some specific offsets for comparison
                    if (offset == 0x40)
                    {
                        _logger.LogInformation("Current 'Gear' offset 0x{Offset:X2}: {Value} (this is what overlay shows)", offset, value);
                    }
                }
                catch (Exception ex)
                {
                    _logger.LogDebug("Failed to read offset 0x{Offset:X2}: {Error}", offset, ex.Message);
                }
            }
            
            _logger.LogInformation("=== End gear scan ===");
        }

        /// <summary>
        /// Debug method to dump memory contents for analysis
        /// </summary>
        public void DebugDumpMemory(int startOffset = 0, int length = 64)
        {
            if (!IsConnected)
            {
                _logger.LogWarning("Not connected - cannot dump memory");
                return;
            }
            
            _logger.LogInformation("=== Memory dump from offset 0x{Start:X2}, length {Length} bytes ===", startOffset, length);
            
            var sb = new StringBuilder();
            
            for (int i = 0; i < length; i += 16) // 16 bytes per line
            {
                sb.Clear();
                sb.Append($"0x{(startOffset + i):X4}: ");
                
                // Hex values
                for (int j = 0; j < 16 && (i + j) < length; j++)
                {
                    try
                    {
                        byte value = ReadByteFromOffset(startOffset + i + j);
                        sb.Append($"{value:X2} ");
                    }
                    catch
                    {
                        sb.Append("-- ");
                    }
                }
                
                // Add padding
                if (i + 16 > length)
                {
                    int remaining = length - i;
                    for (int k = remaining; k < 16; k++)
                        sb.Append("   ");
                }
                
                sb.Append(" | ");
                
                // ASCII representation
                for (int j = 0; j < 16 && (i + j) < length; j++)
                {
                    try
                    {
                        byte value = ReadByteFromOffset(startOffset + i + j);
                        char c = (value >= 32 && value <= 126) ? (char)value : '.';
                        sb.Append(c);
                    }
                    catch
                    {
                        sb.Append('?');
                    }
                }
                
                _logger.LogInformation(sb.ToString());
            }
            
            _logger.LogInformation("=== End memory dump ===");
        }
        
        private byte ReadByteFromOffset(int offset)
        {
            if (_usingDirectAccess && _pSharedMem != IntPtr.Zero)
            {
                return Marshal.ReadByte(_pSharedMem, offset);
            }
            else
            {
                return _dataViewAccessor?.ReadByte(offset) ?? 0;
            }
        }

        /// <summary>
        /// Parse iRacing variable headers to build offset cache
        /// </summary>
        private void ParseVariableHeaders()
        {
            if (_variablesCached)
            {
                Console.WriteLine("ParseVariableHeaders: Already cached, skipping");
                return;
            }

            try
            {
                Console.WriteLine("=== ParseVariableHeaders() called ===");
                _logger.LogInformation("Parsing iRacing variable headers...");
                
                // Read the main header
                var header = ReadSDKHeader();
                Console.WriteLine($"SDK Header - Ver: {header.Ver}, NumVars: {header.NumVars}, VarHeaderOffset: {header.VarHeaderOffset}");
                Console.WriteLine($"SDK Header - NumBuf: {header.NumBuf}, BufLen: {header.BufLen}");
                
                if (header.NumVars <= 0 || header.VarHeaderOffset <= 0)
                {
                    Console.WriteLine($"INVALID header data - NumVars: {header.NumVars}, VarHeaderOffset: {header.VarHeaderOffset}");
                    _logger.LogWarning("Invalid header data - NumVars: {NumVars}, VarHeaderOffset: {VarHeaderOffset}", 
                        header.NumVars, header.VarHeaderOffset);
                    return;
                }

                Console.WriteLine($"Valid header found - parsing {header.NumVars} variables");
                _logger.LogInformation("Found {NumVars} variables at offset 0x{VarHeaderOffset:X}", 
                    header.NumVars, header.VarHeaderOffset);

                // Clear cache
                _variableCache.Clear();

                // Read each variable header
                int varHeaderSize = Marshal.SizeOf<iRSDKVarHeader>();
                Console.WriteLine($"Variable header size: {varHeaderSize} bytes");
                
                for (int i = 0; i < header.NumVars; i++)
                {
                    int varOffset = header.VarHeaderOffset + (i * varHeaderSize);
                    
                    try
                    {
                        Console.WriteLine($"\n--- Parsing variable {i+1}/{header.NumVars} at offset 0x{varOffset:X} ---");
                        var varHeader = ReadVariableHeader(varOffset);
                        
                        if (!string.IsNullOrEmpty(varHeader.Name) && !varHeader.Name.Contains('\0'))
                        {
                            // Only cache variables with valid names
                            if (varHeader.Name.Length <= 32 && varHeader.Name.All(c => c >= 32 && c <= 126))
                            {
                                _variableCache[varHeader.Name] = varHeader;
                                
                                // Log important variables
                                if (varHeader.Name == "Gear" || varHeader.Name == "Speed" || varHeader.Name == "RPM" || 
                                    varHeader.Name == "Throttle" || varHeader.Name == "Brake")
                                {
                                    Console.WriteLine($"FOUND IMPORTANT VARIABLE '{varHeader.Name}': Type={varHeader.Type}, Offset=0x{varHeader.Offset:X}, Count={varHeader.Count}");
                                    _logger.LogInformation("Found variable '{Name}': Type={Type}, Offset=0x{Offset:X}, Count={Count}, Desc='{Desc}', Unit='{Unit}'",
                                        varHeader.Name, varHeader.Type, varHeader.Offset, varHeader.Count, varHeader.Desc, varHeader.Unit);
                                }
                                
                                // Log first 10 variables for debugging
                                if (i < 10)
                                {
                                    Console.WriteLine($"Variable {i}: '{varHeader.Name}' Type={varHeader.Type}, Offset=0x{varHeader.Offset:X}");
                                }
                            }
                            else
                            {
                                Console.WriteLine($"SKIPPING variable {i}: Invalid name '{varHeader.Name}' (length: {varHeader.Name.Length})");
                            }
                        }
                        else
                        {
                            Console.WriteLine($"SKIPPING variable {i}: EMPTY NAME at offset 0x{varOffset:X}");
                        }
                        
                        // Stop if we're getting too many invalid variables in a row
                        if (i > 50 && _variableCache.Count < 10)
                        {
                            Console.WriteLine($"WARNING: Only found {_variableCache.Count} valid variables after {i} attempts - may be parsing issue");
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"FAILED to read variable header {i} at offset 0x{varOffset:X}: {ex.Message}");
                        _logger.LogWarning(ex, "Failed to read variable header {Index} at offset 0x{Offset:X}", i, varOffset);
                        
                        // If we're failing too often, stop trying
                        if (i < 100 && (i % 10) == 0)
                        {
                            Console.WriteLine($"Have failed {i} times - continuing but this might indicate a parsing issue");
                        }
                        
                        // Break if we've failed too many times early on
                        if (i < 50 && _variableCache.Count == 0)
                        {
                            Console.WriteLine("Breaking early due to consistent failures and no successful variables cached");
                            break;
                        }
                    }
                }

                _variablesCached = true;
                Console.WriteLine($"=== ParseVariableHeaders COMPLETE: Cached {_variableCache.Count} variables ===");
                _logger.LogInformation("Cached {Count} variable headers", _variableCache.Count);
                
                // List first few variable names for debugging
                if (_variableCache.Count > 0)
                {
                    var firstVars = string.Join(", ", _variableCache.Keys.Take(10));
                    Console.WriteLine($"First 10 variables: {firstVars}");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"ParseVariableHeaders EXCEPTION: {ex.Message}");
                Console.WriteLine($"Stack trace: {ex.StackTrace}");
                _logger.LogError(ex, "Failed to parse variable headers");
            }
        }

        /// <summary>
        /// Read the main iRacing SDK header
        /// </summary>
        private iRSDKHeader ReadSDKHeader()
        {
            Console.WriteLine("=== ReadSDKHeader() called ===");
            Console.WriteLine($"Using direct access: {_usingDirectAccess}");
            
            if (_usingDirectAccess && _pSharedMem != IntPtr.Zero)
            {
                Console.WriteLine("Reading header using direct access (Marshal.PtrToStructure)");
                var header = Marshal.PtrToStructure<iRSDKHeader>(_pSharedMem);
                Console.WriteLine($"Direct access header: Ver={header.Ver}, NumVars={header.NumVars}, VarHeaderOffset=0x{header.VarHeaderOffset:X}");
                return header;
            }
            else if (_dataViewAccessor != null)
            {
                Console.WriteLine("Reading header using managed access (manual field reading)");
                // Read header fields manually for managed access
                var header = new iRSDKHeader
                {
                    Ver = _dataViewAccessor.ReadInt32(0),
                    Status = _dataViewAccessor.ReadInt32(4),
                    TickRate = _dataViewAccessor.ReadInt32(8),
                    SessionInfoUpdate = _dataViewAccessor.ReadInt32(12),
                    SessionInfoLen = _dataViewAccessor.ReadInt32(16),
                    SessionInfoOffset = _dataViewAccessor.ReadInt32(20),
                    NumVars = _dataViewAccessor.ReadInt32(24),
                    VarHeaderOffset = _dataViewAccessor.ReadInt32(28),
                    NumBuf = _dataViewAccessor.ReadInt32(32),
                    BufLen = _dataViewAccessor.ReadInt32(36)
                };
                
                Console.WriteLine($"Managed access header: Ver={header.Ver}, NumVars={header.NumVars}, VarHeaderOffset=0x{header.VarHeaderOffset:X}");
                Console.WriteLine($"Header details: NumBuf={header.NumBuf}, BufLen={header.BufLen}");
                
                // CRITICAL FIX: Read VarBuf array manually for managed access
                // VarBuf starts at offset 40 (after BufLen field) and contains pairs of [offset, tick_count]
                var varBuf = new int[16]; // Same size as in struct definition
                Console.WriteLine("Reading VarBuf array manually...");
                for (int i = 0; i < 16; i++)
                {
                    varBuf[i] = _dataViewAccessor.ReadInt32(40 + (i * 4)); // 40 = offset to VarBuf, each int is 4 bytes
                    if (i < 8) // Log first 8 elements
                    {
                        Console.WriteLine($"  VarBuf[{i}] = {varBuf[i]} (0x{varBuf[i]:X})");
                    }
                }
                header.VarBuf = varBuf;
                
                return header;
            }
            else
            {
                Console.WriteLine("ERROR: No valid memory access method available");
                throw new InvalidOperationException("No valid memory access method available");
            }
        }

        /// <summary>
        /// Read a single variable header at the specified offset
        /// </summary>
        private iRSDKVarHeader ReadVariableHeader(int offset)
        {
            Console.WriteLine($"=== ReadVariableHeader() at offset 0x{offset:X} ===");
            
            if (_usingDirectAccess && _pSharedMem != IntPtr.Zero)
            {
                Console.WriteLine("Using direct access to read variable header");
                try
                {
                    IntPtr varPtr = IntPtr.Add(_pSharedMem, offset);
                    var header = Marshal.PtrToStructure<iRSDKVarHeader>(varPtr);
                    Console.WriteLine($"Direct access result: Type={header.Type}, Offset=0x{header.Offset:X}, Count={header.Count}, Name='{header.Name}'");
                    return header;
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Direct access failed: {ex.Message}");
                    throw;
                }
            }
            else if (_dataViewAccessor != null)
            {
                Console.WriteLine("Using managed access to read variable header manually");
                try
                {
                    // Read basic fields first
                    int type = _dataViewAccessor.ReadInt32(offset);
                    int varOffset = _dataViewAccessor.ReadInt32(offset + 4);
                    int count = _dataViewAccessor.ReadInt32(offset + 8);
                    
                    Console.WriteLine($"Basic fields: Type={type}, Offset=0x{varOffset:X}, Count={count}");
                    
                    // Read variable header fields manually for managed access
                    var nameBytes = new byte[32];
                    var descBytes = new byte[64];
                    var unitBytes = new byte[32];
                    
                    // CRITICAL: The field layout according to iRSDK documentation:
                    // int type (4 bytes) - offset 0
                    // int offset (4 bytes) - offset 4  
                    // int count (4 bytes) - offset 8
                    // char[4] (4 bytes padding) - offset 12
                    // char name[32] - offset 16
                    // char desc[64] - offset 48
                    // char unit[32] - offset 112
                    
                    _dataViewAccessor.ReadArray(offset + 16, nameBytes, 0, 32);
                    _dataViewAccessor.ReadArray(offset + 48, descBytes, 0, 64);
                    _dataViewAccessor.ReadArray(offset + 112, unitBytes, 0, 32);
                    
                    string name = Encoding.ASCII.GetString(nameBytes).TrimEnd('\0');
                    string desc = Encoding.ASCII.GetString(descBytes).TrimEnd('\0');
                    string unit = Encoding.ASCII.GetString(unitBytes).TrimEnd('\0');
                    
                    Console.WriteLine($"Strings: Name='{name}', Desc='{desc.Substring(0, Math.Min(20, desc.Length))}...', Unit='{unit}'");
                    
                    var result = new iRSDKVarHeader
                    {
                        Type = type,
                        Offset = varOffset,
                        Count = count,
                        Name = name,
                        Desc = desc,
                        Unit = unit
                    };
                    
                    // Validate the result
                    if (string.IsNullOrEmpty(name) || name.Length > 32 || name.Contains('\0'))
                    {
                        Console.WriteLine($"SUSPICIOUS variable name: '{name}' (length: {name?.Length})");
                    }
                    
                    return result;
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Managed access failed: {ex.Message}");
                    throw;
                }
            }
            else
            {
                Console.WriteLine("ERROR: No valid memory access method available");
                throw new InvalidOperationException("No valid memory access method available");
            }
        }

        /// <summary>
        /// Get the current data buffer offset (iRacing uses multiple rotating buffers for thread safety)
        /// Implementation follows reference guide v2 best practices
        /// </summary>
        private int GetCurrentDataBufferOffset()
        {
            try
            {
                Console.WriteLine("=== GetCurrentDataBufferOffset() DEBUG ===");
                
                var header = ReadSDKHeader();
                Console.WriteLine($"Header - NumBuf: {header.NumBuf}, BufLen: {header.BufLen}");
                
                if (header.NumBuf <= 0 || header.BufLen <= 0)
                {
                    Console.WriteLine($"INVALID buffer configuration: NumBuf={header.NumBuf}, BufLen={header.BufLen}");
                    _logger.LogWarning("Invalid buffer configuration: NumBuf={NumBuf}, BufLen={BufLen}", header.NumBuf, header.BufLen);
                    return 0;
                }

                if (header.VarBuf == null || header.VarBuf.Length == 0)
                {
                    Console.WriteLine("CRITICAL: VarBuf array is null or empty");
                    _logger.LogWarning("VarBuf array is null or empty");
                    return 0;
                }

                Console.WriteLine($"VarBuf array length: {header.VarBuf.Length}");
                Console.WriteLine("VarBuf contents (first 8 elements):");
                for (int i = 0; i < Math.Min(8, header.VarBuf.Length); i++)
                {
                    Console.WriteLine($"  VarBuf[{i}] = {header.VarBuf[i]} (0x{header.VarBuf[i]:X})");
                }

                // iRacing uses pairs of values: [buffer_offset, tick_count, buffer_offset, tick_count, ...]
                // CRITICAL FIX: Use Python irsdk.py strategy - pick 2nd most recent buffer to avoid partial writes
                // Python comment: "return 2nd most recent var buffer because it might be a situation 
                // (with most recent var buffer) that half of var buffer written with new data and other half still old"
                
                var buffers = new List<(int offset, int tick, int index)>();
                
                for (int i = 0; i < header.NumBuf && (i * 2 + 1) < header.VarBuf.Length; i++)
                {
                    int bufferOffset = header.VarBuf[i * 2];
                    int tickCount = header.VarBuf[i * 2 + 1];
                    
                    Console.WriteLine($"Buffer {i}: Offset=0x{bufferOffset:X}, Tick={tickCount}");
                    
                    // Validate buffer offset (should be reasonable)
                    if (bufferOffset > 0 && bufferOffset < (1024 * 1024)) // Reasonable size limit
                    {
                        buffers.Add((bufferOffset, tickCount, i));
                        Console.WriteLine($"  -> VALID buffer {i}");
                        _logger.LogDebug("Buffer {Index}: Offset=0x{Offset:X}, Tick={Tick} (valid)", i, bufferOffset, tickCount);
                    }
                    else
                    {
                        Console.WriteLine($"  -> INVALID buffer {i} (offset out of range)");
                        _logger.LogDebug("Buffer {Index}: Offset=0x{Offset:X}, Tick={Tick} (INVALID - skipping)", i, bufferOffset, tickCount);
                    }
                }

                if (buffers.Count == 0)
                {
                    Console.WriteLine("CRITICAL: No valid buffers found - all buffers have invalid offsets");
                    _logger.LogWarning("No valid buffers found - all buffers have invalid offsets");
                    
                    // FALLBACK: Try using the first buffer regardless of validation
                    Console.WriteLine("FALLBACK: Trying first buffer regardless of validation");
                    if (header.VarBuf.Length >= 2)
                    {
                        int fallbackOffset = header.VarBuf[0];
                        int fallbackTick = header.VarBuf[1];
                        Console.WriteLine($"FALLBACK: Using buffer 0 with offset 0x{fallbackOffset:X}, tick {fallbackTick} (unvalidated)");
                        return fallbackOffset;
                    }
                    return 0;
                }

                // Sort by tick count descending (highest tick first)
                buffers.Sort((a, b) => b.tick.CompareTo(a.tick));
                
                Console.WriteLine($"Found {buffers.Count} valid buffers, sorted by tick:");
                foreach (var buf in buffers)
                {
                    Console.WriteLine($"  Buffer {buf.index}: Offset=0x{buf.offset:X}, Tick={buf.tick}");
                }
                
                // Use Python irsdk.py strategy: pick 2nd most recent to avoid partial writes
                int bestBufferOffset;
                int selectedTick;
                int selectedIndex;
                
                if (buffers.Count >= 2)
                {
                    // Use 2nd most recent buffer (Python strategy)
                    bestBufferOffset = buffers[1].offset;
                    selectedTick = buffers[1].tick;
                    selectedIndex = buffers[1].index;
                    Console.WriteLine("PYTHON STRATEGY: Using 2nd most recent buffer (avoiding partial writes)");
                    _logger.LogDebug("PYTHON STRATEGY: Using 2nd most recent buffer (avoiding partial writes)");
                }
                else
                {
                    // Only one buffer available, use it
                    bestBufferOffset = buffers[0].offset;
                    selectedTick = buffers[0].tick;
                    selectedIndex = buffers[0].index;
                    Console.WriteLine("Only one buffer available, using most recent");
                    _logger.LogDebug("Only one buffer available, using most recent");
                }

                Console.WriteLine($"SELECTED: Buffer {selectedIndex}, Offset=0x{bestBufferOffset:X}, Tick={selectedTick}");
                _logger.LogInformation("Selected buffer {Index}: Offset=0x{Offset:X}, Tick={Tick}, Total valid buffers: {Count}", 
                    selectedIndex, bestBufferOffset, selectedTick, buffers.Count);
                return bestBufferOffset;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"GetCurrentDataBufferOffset EXCEPTION: {ex.Message}");
                _logger.LogWarning(ex, "Failed to get current data buffer offset, using 0");
                return 0;
            }
        }

        /// <summary>
        /// Get the latest buffer index based on tick count (as suggested in fixmaybe.md)
        /// </summary>
        public int GetLatestBufferIndex()
        {
            try
            {
                var header = ReadSDKHeader();
                if (header.NumBuf <= 0 || header.VarBuf == null)
                    return 0;

                int latestBuffer = 0;
                int highestTickCount = 0;
                
                for (int i = 0; i < header.NumBuf && (i * 2 + 1) < header.VarBuf.Length; i++)
                {
                    int tickCount = header.VarBuf[i * 2 + 1];
                    if (tickCount > highestTickCount)
                    {
                        highestTickCount = tickCount;
                        latestBuffer = i;
                    }
                }
                
                _logger.LogDebug("Latest buffer index: {Index} with tick count: {TickCount}", latestBuffer, highestTickCount);
                return latestBuffer;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Failed to get latest buffer index");
                return 0;
            }
        }

        /// <summary>
        /// Check if a buffer is valid based on tick count (as suggested in fixmaybe.md)
        /// </summary>
        public bool IsBufferValid(int bufferIndex)
        {
            try
            {
                var header = ReadSDKHeader();
                if (header.NumBuf <= 0 || header.VarBuf == null || bufferIndex >= header.NumBuf)
                    return false;

                if ((bufferIndex * 2 + 1) >= header.VarBuf.Length)
                    return false;

                int bufferTickCount = header.VarBuf[bufferIndex * 2 + 1];
                
                // Find the latest tick count from all buffers to compare against
                int latestTickCount = 0;
                for (int i = 0; i < header.NumBuf; i++)
                {
                    if ((i * 2 + 1) < header.VarBuf.Length)
                    {
                        int tick = header.VarBuf[i * 2 + 1];
                        if (tick > latestTickCount)
                            latestTickCount = tick;
                    }
                }
                
                // Buffer is valid if within 2 tick cycles and non-zero
                bool isValid = Math.Abs(latestTickCount - bufferTickCount) < 2 && bufferTickCount > 0;
                
                _logger.LogDebug("Buffer {Index} validation: BufferTick={BufferTick}, LatestTick={LatestTick}, Valid={IsValid}", 
                    bufferIndex, bufferTickCount, latestTickCount, isValid);
                
                return isValid;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Failed to validate buffer {BufferIndex}", bufferIndex);
                return false;
            }
        }

        /// <summary>
        /// Check if telemetry data is available and valid (enhanced based on fixmaybe.md analysis)
        /// </summary>
        public bool IsDataAvailable()
        {
            try
            {
                Console.WriteLine("=== IsDataAvailable() DEBUG ===");
                
                if (!IsConnected)
                {
                    Console.WriteLine("IsDataAvailable: Not connected");
                    _logger.LogInformation("IsDataAvailable: Not connected");
                    return false;
                }
                
                Console.WriteLine("IsDataAvailable: Connected - performing comprehensive data validation");
                
                // Get current session state for logging
                var sessionState = CurrentSessionState.ToString();
                Console.WriteLine($"Current session state: {sessionState}");
                _logger.LogInformation("IsDataAvailable: Current session state: {SessionState}", sessionState);
                
                // Enhanced validation strategy based on fixmaybe.md
                try
                {
                    Console.WriteLine("Testing basic telemetry variable reads...");
                    
                    // Try to read some basic variables to see if telemetry is working
                    var speed = GetFloat("Speed");
                    var rpm = GetFloat("RPM");
                    var sessionTime = GetDouble("SessionTime");
                    
                    Console.WriteLine($"Basic reads - Speed: {speed}, RPM: {rpm}, SessionTime: {sessionTime}");
                    _logger.LogInformation("Basic telemetry reads - Speed: {Speed}, RPM: {RPM}, SessionTime: {SessionTime}", speed, rpm, sessionTime);
                    
                    // Check buffer freshness
                    bool bufferFresh = IsBufferFresh();
                    Console.WriteLine($"Buffer freshness check: {bufferFresh}");
                    
                    // Check for valid telemetry data (non-zero values)
                    bool hasValidData = HasValidTelemetryData();
                    Console.WriteLine($"Valid telemetry data check: {hasValidData}");
                    
                    // If all basic values are zero, run comprehensive debugging
                    if (speed == 0.0f && rpm == 0.0f && sessionTime == 0.0)
                    {
                        Console.WriteLine("All basic telemetry values are zero - running comprehensive debugging...");
                        DiagnoseConnection();
                        DebugAnalyzeSessionState();
                        DebugCheckImportantVariables();
                        DebugScanForAnyData();
                    }
                    
                    // Data is available if we can successfully read variables AND have fresh buffers
                    // Allow zero values but ensure buffers are being updated
                    bool dataAvailable = bufferFresh;
                    
                    Console.WriteLine($"IsDataAvailable result: {dataAvailable} (based on buffer freshness and read capability)");
                    _logger.LogInformation("IsDataAvailable: SessionState={SessionState}, DataAvailable={Available}, BufferFresh={Fresh}, HasValidData={Valid}", 
                        sessionState, dataAvailable, bufferFresh, hasValidData);
                    
                    return dataAvailable;
                }
                catch (Exception readEx)
                {
                    Console.WriteLine($"Failed to read basic variables: {readEx.Message}");
                    _logger.LogWarning("Failed to read basic telemetry variables: {Error}", readEx.Message);
                    return false;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"IsDataAvailable exception: {ex.Message}");
                _logger.LogWarning(ex, "Failed to check if data is available");
                return false;
            }
        }

        /// <summary>
        /// Get telemetry data safely with event synchronization (as suggested in fixmaybe.md)
        /// </summary>
        public T GetTelemetryDataSafe<T>(string varName, T defaultValue = default) where T : struct
        {
            try
            {
                // Check if data is available first
                if (!IsDataAvailable())
                {
                    _logger.LogDebug("GetTelemetryDataSafe: Data not available for {VarName}", varName);
                    return defaultValue;
                }
                
                // Wait for data valid event if available
                if (_dataValidEvent != IntPtr.Zero)
                {
                    uint waitResult = Win32Api.WaitForSingleObject(_dataValidEvent, 100);
                    if (waitResult != Win32Api.WAIT_OBJECT_0)
                    {
                        _logger.LogDebug("GetTelemetryDataSafe: Data valid event not signaled for {VarName}", varName);
                        // Don't return - try reading anyway as fallback
                    }
                }
                
                // Get latest buffer and validate it
                int bufferIndex = GetLatestBufferIndex();
                if (!IsBufferValid(bufferIndex))
                {
                    _logger.LogDebug("GetTelemetryDataSafe: Buffer {BufferIndex} not valid for {VarName}", bufferIndex, varName);
                    return defaultValue;
                }
                
                // Read data based on type
                object value = typeof(T) switch
                {
                    Type t when t == typeof(float) => GetFloat(varName),
                    Type t when t == typeof(double) => GetDouble(varName),
                    Type t when t == typeof(int) => GetInt(varName),
                    Type t when t == typeof(bool) => GetInt(varName) != 0,
                    _ => defaultValue
                };
                
                _logger.LogDebug("GetTelemetryDataSafe: Read {VarName} = {Value} (buffer {BufferIndex})", varName, value, bufferIndex);
                return (T)value;
            }
            catch (Exception ex)
            {
                _logger.LogWarning(ex, "Failed to safely get telemetry data for {VarName}", varName);
                return defaultValue;
            }
        }

        /// <summary>
        /// Debug method to list all cached variables (first 50 for performance)
        /// </summary>
        public void DebugListCachedVariables()
        {
            Console.WriteLine("=== DEBUG: Cached Variables ===");
            Console.WriteLine($"Total cached variables: {_variableCache.Count}");
            Console.WriteLine($"Variables cached flag: {_variablesCached}");
            
            if (_variableCache.Count == 0)
            {
                Console.WriteLine("NO VARIABLES IN CACHE");
                return;
            }
            
            Console.WriteLine("First 50 variables in cache:");
            int count = 0;
            foreach (var kvp in _variableCache.Take(50))
            {
                var var = kvp.Value;
                Console.WriteLine($"  {count+1:D2}: '{kvp.Key}' - Type={var.Type}, Offset=0x{var.Offset:X4}, Count={var.Count}");
                count++;
            }
            
            // Look specifically for common variables
            var commonVars = new[] { "Speed", "RPM", "Gear", "Throttle", "Brake", "SessionTime" };
            Console.WriteLine("\nLooking for common variables:");
            foreach (var varName in commonVars)
            {
                if (_variableCache.ContainsKey(varName))
                {
                    var var = _variableCache[varName];
                    Console.WriteLine($"  FOUND: '{varName}' - Type={var.Type}, Offset=0x{var.Offset:X4}");
                }
                else
                {
                    Console.WriteLine($"  MISSING: '{varName}'");
                }
            }
            
            Console.WriteLine("=== End Cached Variables ===");
        }

