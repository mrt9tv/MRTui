        }

        /// <summary>
        /// Debug method to scan for ANY non-zero telemetry data in the current buffer
        /// </summary>
        public void DebugScanForAnyData()
        {
            if (!IsConnected)
            {
                Console.WriteLine("[DebugScanForAnyData] Not connected");
                return;
            }
            
            Console.WriteLine("=== DebugScanForAnyData() ===");
            
            try
            {
                var bufferOffset = GetCurrentDataBufferOffset();
                if (bufferOffset == 0)
                {
                    Console.WriteLine("No valid buffer offset available");
                    return;
                }
                
                Console.WriteLine($"Scanning current data buffer at offset 0x{bufferOffset:X}");
                
                // Scan the entire buffer length for any non-zero data
                var header = ReadSDKHeader();
                int bufferLength = header.BufLen;
                Console.WriteLine($"Buffer length: {bufferLength} bytes");
                
                var nonZeroOffsets = new List<(int offset, byte value)>();
                
                // Scan in chunks to avoid overwhelming output
                for (int i = 0; i < Math.Min(bufferLength, 1000); i += 4) // Check every 4th byte for performance
                {
                    int absoluteOffset = bufferOffset + i;
                    byte value = ReadByteFromOffset(absoluteOffset);
                    
                    if (value != 0)
                    {
                        nonZeroOffsets.Add((i, value));
                        if (nonZeroOffsets.Count >= 20) // Limit output
                            break;
                    }
                }
                
                Console.WriteLine($"Found {nonZeroOffsets.Count} non-zero bytes in first 1000 bytes:");
                foreach (var (offset, value) in nonZeroOffsets)
                {
                    Console.WriteLine($"  Offset +0x{offset:X}: 0x{value:X2} ({value})");
                }
                
                if (nonZeroOffsets.Count == 0)
                {
                    Console.WriteLine("WARNING: No non-zero data found in buffer!");
                    Console.WriteLine("This suggests iRacing may not be actively writing telemetry data");
                    Console.WriteLine("");
                    Console.WriteLine("SOLUTION: To activate telemetry data:");
                    Console.WriteLine("1. Start the car engine (ignition key)");
                    Console.WriteLine("2. Drive onto the track or enter a practice session");
                    Console.WriteLine("3. Begin actively driving to generate live telemetry");
                    Console.WriteLine("4. Current session state 'GetInCar' means you're in the car but engine may be off");
                    Console.WriteLine("");
                    Console.WriteLine("The overlay is working correctly - just waiting for active telemetry!");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[DebugScanForAnyData] Error: {ex.Message}");
            }
            
            Console.WriteLine("=== End DebugScanForAnyData ===");
        }

        /// <summary>
        /// Debug method to check multiple variables that should have values
        /// </summary>
