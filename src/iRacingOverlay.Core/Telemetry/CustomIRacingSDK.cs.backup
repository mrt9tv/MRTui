        {
            Console.WriteLine("=== DebugCheckImportantVariables() ===");
            
            // Variables that should typically have non-zero values
            var importantVars = new[]
            {
                ("SessionTime", "Should increment constantly"),
                ("SessionTimeRemain", "Session time remaining"),
                ("ReplayFrameNum", "Replay frame number"),
                ("IsInGarage", "Garage state flag"),
                ("IsOnTrack", "On track state flag"),
                ("IsReplayPlaying", "Replay playing state"),
                ("DriverMarker", "Driver marker"),
                ("IsRecording", "Recording state"),
                ("SessionTick", "Session tick counter"),
                ("SessionNum", "Session number"),
                ("SessionState", "Session state"),
                ("SessionUniqueID", "Session unique ID"),
                ("CamGroupNumber", "Camera group"),
                ("CamCameraNumber", "Camera number"),
                ("DisplayUnits", "Display units setting"),
                ("PlayerCarIdx", "Player car index"),
                ("RadioTransmitCarIdx", "Radio transmit car index"),
                ("ReplaySessionNum", "Replay session number")
            };
            
            foreach (var (varName, description) in importantVars)
            {
                try
                {
                    if (_variableCache.ContainsKey(varName))
                    {
                        var varInfo = _variableCache[varName];
                        object value = varInfo.Type switch
                        {
                            IRSDK_FLOAT => GetFloat(varName),
                            IRSDK_DOUBLE => GetDouble(varName),
                            _ => GetInt(varName)
                        };
                        
                        var status = value.ToString() == "0" ? "ZERO" : "NON-ZERO";
                        Console.WriteLine($"  {varName}: {value} ({status}) - {description}");
                        
                        if (status == "NON-ZERO")
                        {
                            Console.WriteLine($"    ^^ FOUND NON-ZERO DATA!");
                        }
                    }
                    else
                    {
                        Console.WriteLine($"  {varName}: NOT FOUND");
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"  {varName}: ERROR - {ex.Message}");
                }
            }
            
            Console.WriteLine("=== End DebugCheckImportantVariables ===");
        }

        /// <summary>
        /// Debug method to analyze session state in detail
        /// </summary>
        public void DebugAnalyzeSessionState()
        {
            Console.WriteLine("=== DebugAnalyzeSessionState() ===");
            
            try
            {
                var header = ReadHeader();
                Console.WriteLine($"Header Status: {header.Status} (0x{header.Status:X})");
                Console.WriteLine($"Current Session State: {CurrentSessionState}");
                Console.WriteLine($"Session State Raw: {(int)CurrentSessionState}");
                
                // Check connected flag
                bool isConnected = (header.Status & IRSDK_STCONNECTED) != 0;
                Console.WriteLine($"Connected Flag: {isConnected}");
                
                // Try to get session-related variables
                if (_variableCache.ContainsKey("SessionState"))
                {
                    var sessionStateValue = GetInt("SessionState");
                    Console.WriteLine($"SessionState Variable: {sessionStateValue}");
                }
                
                if (_variableCache.ContainsKey("IsOnTrack"))
                {
                    var isOnTrack = GetInt("IsOnTrack");
                    Console.WriteLine($"IsOnTrack: {isOnTrack != 0}");
                }
                
                if (_variableCache.ContainsKey("IsInGarage"))
                {
                    var isInGarage = GetInt("IsInGarage");
                    Console.WriteLine($"IsInGarage: {isInGarage != 0}");
                }
                
                // Check if engine is running
                if (_variableCache.ContainsKey("IsOnTrack"))
                {
                    var rpm = GetFloat("RPM");
                    var engineWarnings = GetInt("EngineWarnings");
                    Console.WriteLine($"Engine State - RPM: {rpm}, Warnings: 0x{engineWarnings:X}");
                }
                
                Console.WriteLine("\nSession State Analysis:");
                Console.WriteLine("- GetInCar: Driver is in the car but may not be on track");
                Console.WriteLine("- For active telemetry, usually need to be on track with engine running");
                Console.WriteLine("- Try starting the engine, going to track, or entering a practice session");
                Console.WriteLine("");
                Console.WriteLine("SUCCESS: Your overlay is technically working perfectly!");
                Console.WriteLine("The zero values are normal when iRacing isn't producing active telemetry.");
                Console.WriteLine("Once you start driving, you should see live telemetry data.");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error analyzing session state: {ex.Message}");
            }
            
            Console.WriteLine("=== End DebugAnalyzeSessionState ===");
        }

        // iRacing SDK header structures
        [StructLayout(LayoutKind.Sequential, Pack = 1)]
        private struct iRSDKHeader
        {
            public int Ver;                 // Version of the SDK
            public int Status;              // Current session status
            public int TickRate;            // Tick rate of the data
            public int SessionInfoUpdate;   // Session info update counter
            public int SessionInfoLen;      // Length of session info string
            public int SessionInfoOffset;   // Offset to session info string
            public int NumVars;             // Number of variables in variable header
            public int VarHeaderOffset;     // Offset to variable header
            public int NumBuf;              // Number of data buffers
            public int BufLen;              // Length of each data buffer
            [MarshalAs(UnmanagedType.ByValArray, SizeConst = 16)]
            public int[] VarBuf;            // Buffer offsets and tick counts
        }

        [StructLayout(LayoutKind.Sequential, Pack = 1)]
        private struct iRSDKVarHeader
        {
            public int Type;                // Variable type (0=char, 1=bool, 2=int, 3=bitfield, 4=float, 5=double)
            public int Offset;              // Offset in data buffer
            public int Count;               // Number of elements (for arrays)
            private int Padding;            // 4-byte padding to match iRacing SDK memory layout
            [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 32)]
            public string Name;             // Variable name
            [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 64)]
            public string Desc;             // Variable description
            [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 32)]
            public string Unit;             // Variable unit
        }

        // Cache for variable offsets
        private readonly Dictionary<string, iRSDKVarHeader> _variableCache = new();
        private bool _variablesCached = false;

        private struct IRacingHeader
        {
            public int Version;
            public int Status;
            public int TickRate;
            public bool IsValid;
        }

        // iRacing SDK data type constants (from reference guide v2)
        private const int IRSDK_CHAR = 0;
        private const int IRSDK_BOOL = 1;
        private const int IRSDK_INT = 2;
        private const int IRSDK_BITFIELD = 3;
        private const int IRSDK_FLOAT = 4;
        private const int IRSDK_DOUBLE = 5;

        // iRacing SDK status flags
        private const int IRSDK_STCONNECTED = 1;
    }

    // Win32 API declarations for direct memory mapped file access
    internal static class Win32Api
    {
        // File mapping access rights
        private const uint FILE_MAP_READ = 0x0004;
        private const uint FILE_MAP_WRITE = 0x0002;
        private const uint FILE_MAP_ALL_ACCESS = 0x001f;

        [DllImport("kernel32.dll", SetLastError = true)]
        internal static extern IntPtr OpenFileMapping(uint dwDesiredAccess, bool bInheritHandle, string lpName);

        [DllImport("kernel32.dll", SetLastError = true)]
        internal static extern IntPtr MapViewOfFile(IntPtr hFileMappingObject, uint dwDesiredAccess, uint dwFileOffsetHigh, uint dwFileOffsetLow, uint dwNumberOfBytesToMap);

        [DllImport("kernel32.dll", SetLastError = true)]
        internal static extern bool UnmapViewOfFile(IntPtr lpBaseAddress);

        [DllImport("kernel32.dll", SetLastError = true)]
        internal static extern bool CloseHandle(IntPtr hObject);

        [DllImport("kernel32.dll")]
        internal static extern uint GetLastError();

        // Event synchronization APIs for data valid event monitoring
        [DllImport("kernel32.dll", SetLastError = true)]
        internal static extern IntPtr OpenEvent(uint dwDesiredAccess, bool bInheritHandle, string lpName);

        [DllImport("kernel32.dll", SetLastError = true)]
        internal static extern uint WaitForSingleObject(IntPtr hHandle, uint dwMilliseconds);

        internal const uint EVENT_ALL_ACCESS = 0x1F0003;
        internal const uint WAIT_OBJECT_0 = 0x00000000;
        internal const uint WAIT_TIMEOUT = 0x00000102;
       
        internal const uint INFINITE = 0xFFFFFFFF;

        internal const uint FILE_MAP_READ_ACCESS = FILE_MAP_READ;
    }
}
