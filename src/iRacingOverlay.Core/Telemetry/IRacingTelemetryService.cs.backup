// Replace the iRSDKSharp import line with:
using iRacingOverlay.Core.Telemetry; // For MockiRacingSDK

// Replace the constructor with:
public IRacingTelemetryService(ILogger<IRacingTelemetryService> logger)
{
    _logger = logger;
    _sdk = new MockiRacingSDK(); // Use mock instead of iRacingSDK
    _state = ConnectionState.Disconnected;
}

// Update CheckConnection method:
private void CheckConnection(object? state)
{
    if (!_isRunning)
        return;

    try
    {
        // Simulate connection after 5 seconds
        if (_state == ConnectionState.Disconnected)
        {
            SetConnectionState(ConnectionState.Connecting);
            ((MockiRacingSDK)_sdk).Connect(); // Cast to mock
            SetConnectionState(ConnectionState.Connected);
            StartTelemetryUpdates();
        }
    }
    catch (Exception ex)
    {
        _logger.LogError(ex, "Error checking connection");
        SetConnectionState(ConnectionState.Error, ex.Message);
    }
}