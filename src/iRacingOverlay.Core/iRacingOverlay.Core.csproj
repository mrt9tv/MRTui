<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <!--
      2.0.0, not 2.3.0: the 2.1+ source generators are built against Roslyn 5.6/5.9,
      which ship with SDK 10.0.3xx/4xx. This machine has 10.0.204 (Roslyn 5.3), and
      2.0.0's generator targets 5.0. 2.0.0 already carries every telemetry channel
      added through 1.2.0 (DRS, ERS, dc*/dp* extensions) and the 2.x handler API.
      Bump to 2.3.0 once SDK 10.0.400 is installed — no code change needed.
    -->
    <PackageReference Include="SVappsLAB.iRacingTelemetrySDK" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Data\TrackTurnDatabase.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
