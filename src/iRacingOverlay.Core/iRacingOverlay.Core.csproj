<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <!--
      2.3.0's source generator is built against Roslyn 5.9, which ships with the
      .NET SDK 10.0.400+. On an older SDK the generator is silently skipped and the
      build fails with CS9057; global.json pins 10.0.200 with latestFeature roll-forward
      so a machine with 10.0.4xx picks it up automatically.
    -->
    <PackageReference Include="SVappsLAB.iRacingTelemetrySDK" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Data\TrackTurnDatabase.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
