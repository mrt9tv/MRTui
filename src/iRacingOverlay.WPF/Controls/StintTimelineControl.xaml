<UserControl x:Class="iRacingOverlay.WPF.Controls.StintTimelineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="600"
             Background="#1E1E1E">
    
    <UserControl.Resources>
        <SolidColorBrush x:Key="BrushTeal" Color="#008080"/>
        <SolidColorBrush x:Key="BrushOrange" Color="#FF8000"/>
        <SolidColorBrush x:Key="BrushRed" Color="#FF3333"/>
        <SolidColorBrush x:Key="BrushGreen" Color="#4CAF50"/>
        <SolidColorBrush x:Key="BrushGray" Color="#666666"/>
        <SolidColorBrush x:Key="BrushBackground" Color="#252525"/>
        <SolidColorBrush x:Key="BrushBorder" Color="#333333"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- Timeline Canvas -->
            <RowDefinition Height="Auto"/> <!-- Lap Scale -->
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <Border Grid.Row="0" 
                Background="{StaticResource BrushBackground}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="10,5">
            <Grid>
                <TextBlock Text="STINT TIMELINE" 
                          FontSize="12" 
                          FontWeight="Bold"
                          Foreground="{StaticResource BrushTeal}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right">
                    <TextBlock x:Name="ZoomLevelText" 
                              Text="Zoom: 100%" 
                              FontSize="10"
                              Foreground="#888888"
                              Margin="0,0,15,0"
                              VerticalAlignment="Center"/>
                    <Button x:Name="ZoomInButton" 
                           Content="+" 
                           Width="24" Height="24"
                           FontSize="14"
                           FontWeight="Bold"
                           Click="ZoomIn_Click"
                           Style="{StaticResource {x:Type Button}}"
                           Margin="0,0,5,0"/>
                    <Button x:Name="ZoomOutButton" 
                           Content="−" 
                           Width="24" Height="24"
                           FontSize="14"
                           FontWeight="Bold"
                           Click="ZoomOut_Click"
                           Style="{StaticResource {x:Type Button}}"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Timeline Canvas with ScrollViewer -->
        <ScrollViewer Grid.Row="1" 
                     HorizontalScrollBarVisibility="Disabled"
                     VerticalScrollBarVisibility="Disabled"
                     Margin="0">
            <Grid MinWidth="600">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/> <!-- Lap markers -->
                    <RowDefinition Height="50"/> <!-- Fuel bar -->
                    <RowDefinition Height="50"/> <!-- Tire wear bar -->
                    <RowDefinition Height="40"/> <!-- Pit stops -->
                </Grid.RowDefinitions>
                
                <!-- Lap Markers (Top) -->
                <Canvas x:Name="LapMarkersCanvas" 
                       Grid.Row="0" 
                       Background="#1A1A1A"
                       ClipToBounds="True">
                    <!-- Lap numbers will be drawn here dynamically -->
                </Canvas>
                
                <!-- Fuel Timeline -->
                <Border Grid.Row="1" 
                       Background="{StaticResource BrushBackground}"
                       BorderBrush="{StaticResource BrushBorder}"
                       BorderThickness="0,1">
                    <Grid>
                        <TextBlock Text="FUEL" 
                                  FontSize="10" 
                                  Foreground="#888888"
                                  VerticalAlignment="Center"
                                  Margin="10,0,0,0"/>
                        <Canvas x:Name="FuelTimelineCanvas" 
                               Margin="60,5,5,5"
                               ClipToBounds="True">
                            <!-- Fuel projection will be drawn here -->
                        </Canvas>
                    </Grid>
                </Border>
                
                <!-- Tire Wear Timeline -->
                <Border Grid.Row="2" 
                       Background="{StaticResource BrushBackground}"
                       BorderBrush="{StaticResource BrushBorder}"
                       BorderThickness="0,1">
                    <Grid>
                        <TextBlock Text="TIRES" 
                                  FontSize="10" 
                                  Foreground="#888888"
                                  VerticalAlignment="Center"
                                  Margin="10,0,0,0"/>
                        <Canvas x:Name="TireTimelineCanvas" 
                               Margin="60,5,5,5"
                               ClipToBounds="True">
                            <!-- Tire wear projection will be drawn here -->
                        </Canvas>
                    </Grid>
                </Border>
                
                <!-- Pit Stop Markers -->
                <Border Grid.Row="3" 
                       Background="#1A1A1A"
                       BorderBrush="{StaticResource BrushBorder}"
                       BorderThickness="0,1">
                    <Canvas x:Name="PitStopCanvas" 
                           Margin="60,5,5,5"
                           ClipToBounds="True">
                        <!-- Pit stop markers will be drawn here -->
                    </Canvas>
                </Border>
            </Grid>
        </ScrollViewer>
        
        <!-- Lap Scale (Bottom) -->
        <Border Grid.Row="2" 
                Background="{StaticResource BrushBackground}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="60,5,5,5">
            <Canvas x:Name="LapScaleCanvas" Height="20">
                <!-- Lap scale will be drawn here -->
            </Canvas>
        </Border>
    </Grid>
</UserControl>
