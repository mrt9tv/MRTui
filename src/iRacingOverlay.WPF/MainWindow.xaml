<Window x:Class="iRacingOverlay.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MRT UI | iRacing Telemetry Manager" 
        Height="720" Width="1280"
        MinHeight="720" MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkBackground}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource DarkSurface}" 
                BorderBrush="{StaticResource TealPrimary}" BorderThickness="0,0,0,2">
            <Grid Margin="30,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MRT UI" 
                               FontSize="32" 
                               FontWeight="Bold"
                               Foreground="{StaticResource TealPrimary}"
                               Margin="0,0,15,0"/>
                    <TextBlock Text="| iRacing Telemetry Manager" 
                               FontSize="24" 
                               Foreground="{StaticResource LightText}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Navigation Bar -->
        <Border Grid.Row="1" Background="{StaticResource DarkSurface}">
            <StackPanel Orientation="Horizontal" Margin="30,15" Height="50">
                <Button x:Name="BtnHome" 
                        Content="🏠 Home" 
                        Style="{StaticResource NavigationButton}"
                        Click="BtnHome_Click"
                        Width="150" Margin="0,0,15,0"/>
                <Button x:Name="BtnDashboard" 
                        Content="📊 Dashboard" 
                        Style="{StaticResource NavigationButton}"
                        Click="BtnDashboard_Click"
                        Width="180" Margin="0,0,15,0"/>
                <Button x:Name="BtnOverlay" 
                        Content="🎮 Overlay Manager" 
                        Style="{StaticResource NavigationButton}"
                        Click="BtnOverlay_Click"
                        Width="220" Margin="0,0,15,0"/>
                <Button x:Name="BtnSettings" 
                        Content="⚙️ Settings" 
                        Style="{StaticResource NavigationButton}"
                        Click="BtnSettings_Click"
                        Width="180"/>
            </StackPanel>
        </Border>
        
        <!-- Content Frame -->
        <Frame x:Name="ContentFrame" 
               Grid.Row="2" 
               NavigationUIVisibility="Hidden"
               Background="{StaticResource DarkBackground}"/>
        
        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource DarkSurface}"
                BorderBrush="{StaticResource DarkBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="30,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionStatusText" 
                               Text="🤌 Disconnected" 
                               FontSize="14"
                               Foreground="{StaticResource LightText}"
                               Margin="0,0,30,0"/>
                    <TextBlock Text="Uptime: " 
                               FontSize="12"
                               Foreground="{StaticResource MutedText}"
                               Margin="0,0,5,0"/>
                    <TextBlock x:Name="UptimeText" 
                               Text="00:00:00" 
                               FontSize="12"
                               Foreground="{StaticResource TealPrimary}"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" 
                               Text="Version 0.5" 
                               FontSize="12"
                               Foreground="{StaticResource MutedText}"
                               Margin="0,0,30,0"/>
                    <TextBlock Text="Press F12 for debug overlay" 
                               FontSize="12"
                               Foreground="{StaticResource MutedText}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
