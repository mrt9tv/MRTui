<Window x:Class="iRacingOverlay.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MRT UI | iRacing Overlay" 
        Height="720" Width="740"
        MinHeight="600" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkBackground}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- TITLE BAR                                               -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource DarkSurface}" 
                BorderBrush="{StaticResource TealPrimary}" BorderThickness="0,0,0,2">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MRT UI" 
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TealPrimary}"
                               Margin="0,0,6,0"/>
                    <TextBlock x:Name="TitleVersionText"
                               Text="v1.0.0" FontSize="11" 
                               Foreground="{StaticResource MutedText}"
                               VerticalAlignment="Bottom" Margin="0,0,8,2"/>
                    <TextBlock Text="| iRacing Overlay" 
                               FontSize="13" 
                               Foreground="{StaticResource LightText}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- CONTENT: Nav sidebar + Page host                        -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- NAVIGATION SIDEBAR -->
            <Border Grid.Column="0" Background="{StaticResource DarkSurface}"
                    BorderBrush="{StaticResource DarkBorder}" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Top" Margin="0,6,0,0">
                    <Button x:Name="NavDashboard" Content="&#x2302;" ToolTip="Dashboard"
                            Click="NavButton_Click" Tag="Dashboard"
                            Width="36" Height="36" Margin="4,2" FontSize="18"
                            Foreground="{StaticResource TealPrimary}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="NavWidgets" Content="&#x25A6;" ToolTip="Widgets"
                            Click="NavButton_Click" Tag="Widgets"
                            Width="36" Height="36" Margin="4,2" FontSize="16"
                            Foreground="{StaticResource LightText}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="NavSessions" Content="&#x23F1;" ToolTip="Sessions"
                            Click="NavButton_Click" Tag="Sessions"
                            Width="36" Height="36" Margin="4,2" FontSize="16"
                            Foreground="{StaticResource LightText}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="NavSettings" Content="&#x2699;" ToolTip="Settings"
                            Click="NavButton_Click" Tag="Settings"
                            Width="36" Height="36" Margin="4,2" FontSize="16"
                            Foreground="{StaticResource LightText}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="NavAbout" Content="&#x2139;" ToolTip="About"
                            Click="NavButton_Click" Tag="About"
                            Width="36" Height="36" Margin="4,2" FontSize="16"
                            Foreground="{StaticResource LightText}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>
            
            <!-- PAGE HOST -->
            <ContentControl x:Name="PageHost" Grid.Column="1"/>
        </Grid>
        
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- STATUS BAR                                              -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource DarkSurface}"
                BorderBrush="{StaticResource DarkBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionStatusText" 
                               Text="Disconnected" FontSize="10"
                               Foreground="#888888" Margin="0,0,12,0"/>
                    <TextBlock Text="Rate: " FontSize="9"
                               Foreground="{StaticResource MutedText}" Margin="0,0,2,0"/>
                    <TextBlock x:Name="UpdateRateText" Text="0 Hz" FontSize="9"
                               Foreground="{StaticResource TealPrimary}"/>
                </StackPanel>
                <TextBlock x:Name="HotkeysText" 
                           Text="Ctrl+L Lock | Ctrl+H Show/Hide"
                           FontSize="9"
                           Foreground="{StaticResource MutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
