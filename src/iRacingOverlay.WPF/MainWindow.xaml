<Window x:Class="iRacingOverlay.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MRT UI | iRacing Overlay" 
        Height="360" Width="520"
        MinHeight="360" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkBackground}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource DarkSurface}" 
                BorderBrush="{StaticResource TealPrimary}" BorderThickness="0,0,0,2">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MRT UI" 
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TealPrimary}"
                               Margin="0,0,8,0"/>
                    <TextBlock x:Name="TitleVersionText"
                               Text="v1.0.0" FontSize="14" 
                               Foreground="{StaticResource MutedText}"
                               VerticalAlignment="Bottom" Margin="0,0,12,3"/>
                    <TextBlock Text="| iRacing Overlay" 
                               FontSize="18" 
                               Foreground="{StaticResource LightText}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Content Area -->
        <Border Grid.Row="1" Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="WidgetStatusText"
                           Text="MRT One widget is ready."
                           FontSize="16"
                           Foreground="{StaticResource LightText}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnToggleMRTOne"
                            Content="Show MRT One"
                            Style="{StaticResource NavigationButton}"
                            Click="BtnToggleMRTOne_Click"
                            Width="160" Height="40" Margin="0,0,10,0"/>
                    <Button x:Name="BtnLockWidgets"
                            Content="Lock Widgets"
                            Style="{StaticResource NavigationButton}"
                            Click="BtnLockWidgets_Click"
                            Width="140" Height="40"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource DarkSurface}"
                BorderBrush="{StaticResource DarkBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionStatusText" 
                               Text="Disconnected" FontSize="12"
                               Foreground="#888888" Margin="0,0,20,0"/>
                    <TextBlock Text="Rate: " FontSize="11"
                               Foreground="{StaticResource MutedText}" Margin="0,0,4,0"/>
                    <TextBlock x:Name="UpdateRateText" Text="0 Hz" FontSize="11"
                               Foreground="{StaticResource TealPrimary}"/>
                </StackPanel>
                <TextBlock x:Name="HotkeysText" 
                           Text="Ctrl+L Lock | Ctrl+H Show/Hide"
                           FontSize="11"
                           Foreground="{StaticResource MutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
