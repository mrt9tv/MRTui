<Window x:Class="iRacingOverlay.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iRacing Overlay Manager" 
        Height="600" Width="650"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="iRacing Overlay Manager" 
                   FontSize="24" 
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>
        
        <!-- Main Content Tabs -->
        <TabControl Grid.Row="1" Margin="0,0,0,15">
            <!-- Global Settings Tab -->
            <TabItem Header="Global Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- Units Setting -->
                        <TextBlock Text="Units" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <RadioButton x:Name="MetricRadio" 
                                         Content="Metric (km/h, L, °C)" 
                                         IsChecked="True"
                                         Checked="MetricRadio_Checked"
                                         Margin="10,0,15,0"/>
                            <RadioButton x:Name="ImperialRadio" 
                                         Content="Imperial (mph, gal, °F)"
                                         Checked="ImperialRadio_Checked"/>
                        </StackPanel>
                        
                        <!-- Opacity Setting -->
                        <TextBlock Text="Widget Opacity" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Margin="0,20,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Slider x:Name="OpacitySlider"
                                    Minimum="0.1"
                                    Maximum="1.0"
                                    Value="0.85"
                                    Width="400"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="OpacitySlider_ValueChanged"/>
                            <TextBlock x:Name="OpacityValueText"
                                       Text="85%"
                                       VerticalAlignment="Center"
                                       Margin="15,0,0,0"
                                       Width="50"
                                       FontWeight="Bold"
                                       FontSize="14"/>
                        </StackPanel>
                        
                        <!-- Lock Windows Setting -->
                        <TextBlock Text="Window Management" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Margin="0,20,0,10"/>
                        
                        <CheckBox x:Name="LockWindowsCheckbox"
                                  Content="Lock all widgets in place (prevents dragging, enables click-through)"
                                  Margin="10,5"
                                  Checked="LockWindows_Checked"
                                  Unchecked="LockWindows_Unchecked"/>
                        
                        <!-- Widget Management -->
                        <TextBlock Text="Widget Management" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Margin="0,30,0,10"/>
                        
                        <Button x:Name="ToggleAllButton" 
                                Content="Toggle All Widgets (F12)" 
                                Padding="10"
                                Margin="10,5"
                                Click="ToggleAllButton_Click"/>
                        
                        <Button x:Name="RemoveAllButton" 
                                Content="Remove All Widgets" 
                                Padding="10"
                                Margin="10,5"
                                Click="RemoveAllButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Driving Widget Configuration Tab -->
            <TabItem Header="Driving Widget Config" x:Name="DrivingWidgetConfigTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- Widget Activation -->
                        <CheckBox x:Name="ActivateDrivingWidget" 
                                  Content="Activate Driving Widget" 
                                  FontSize="16"
                                  FontWeight="Bold"
                                  Margin="0,0,0,20"
                                  Checked="ActivateDrivingWidget_Checked"
                                  Unchecked="ActivateDrivingWidget_Unchecked"/>
                        
                        <Separator Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Configure Driving Widget Sections" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>
                        
                        <!-- Top Section -->
                        <GroupBox Header="Top Section (Speed)" Margin="0,0,0,15" Padding="10">
                            <StackPanel>
                                <CheckBox x:Name="ShowTopSection" Content="Show Top Section" IsChecked="True" Margin="0,5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                                    <TextBlock Text="Display Field:" VerticalAlignment="Center" Width="100"/>
                                    <ComboBox x:Name="TopSectionField" Width="200" SelectedIndex="1">
                                        <ComboBoxItem Content="Gear"/>
                                        <ComboBoxItem Content="Speed"/>
                                        <ComboBoxItem Content="RPM"/>
                                        <ComboBoxItem Content="Throttle %"/>
                                        <ComboBoxItem Content="Brake %"/>
                                        <ComboBoxItem Content="Clutch %"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Center Section -->
                        <GroupBox Header="Center Section (Gear)" Margin="0,0,0,15" Padding="10">
                            <StackPanel>
                                <CheckBox x:Name="ShowCenterSection" Content="Show Center Section" IsChecked="True" Margin="0,5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                                    <TextBlock Text="Display Field:" VerticalAlignment="Center" Width="100"/>
                                    <ComboBox x:Name="CenterSectionField" Width="200" SelectedIndex="0">
                                        <ComboBoxItem Content="Gear"/>
                                        <ComboBoxItem Content="Speed"/>
                                        <ComboBoxItem Content="RPM"/>
                                        <ComboBoxItem Content="Throttle %"/>
                                        <ComboBoxItem Content="Brake %"/>
                                        <ComboBoxItem Content="Clutch %"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Bottom Section -->
                        <GroupBox Header="Bottom Section (RPM)" Margin="0,0,0,15" Padding="10">
                            <StackPanel>
                                <CheckBox x:Name="ShowBottomSection" Content="Show Bottom Section" IsChecked="True" Margin="0,5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                                    <TextBlock Text="Display Field:" VerticalAlignment="Center" Width="100"/>
                                    <ComboBox x:Name="BottomSectionField" Width="200" SelectedIndex="2">
                                        <ComboBoxItem Content="Gear"/>
                                        <ComboBoxItem Content="Speed"/>
                                        <ComboBoxItem Content="RPM"/>
                                        <ComboBoxItem Content="Throttle %"/>
                                        <ComboBoxItem Content="Brake %"/>
                                        <ComboBoxItem Content="Clutch %"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Widget Size -->
                        <GroupBox Header="Widget Size" Margin="0,0,0,15" Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Size:" VerticalAlignment="Center" Width="100"/>
                                    <Slider x:Name="WidgetSizeSlider" 
                                            Minimum="100" 
                                            Maximum="400" 
                                            Value="200" 
                                            Width="200"
                                            TickFrequency="20"
                                            IsSnapToTickEnabled="True"
                                            TickPlacement="BottomRight"
                                            ValueChanged="DrivingWidgetSize_Changed"/>
                                    <TextBlock x:Name="WidgetSizeValue" 
                                               Text="200px" 
                                               VerticalAlignment="Center" 
                                               Margin="10,0,0,0"
                                               Width="60"/>
                                </StackPanel>
                                <TextBlock Text="Adjust the size of the circular gauge (100-400 pixels)" 
                                           TextWrapping="Wrap"
                                           Foreground="Gray" 
                                           FontSize="11" 
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Left Side Box -->
                        <GroupBox Header="Left Side Box (Optional)" Margin="0,0,0,15" Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Field:" VerticalAlignment="Center" Width="100"/>
                                    <ComboBox x:Name="LeftSideField" Width="200" SelectedIndex="4">
                                        <ComboBoxItem Content="None"/>
                                        <ComboBoxItem Content="Throttle %"/>
                                        <ComboBoxItem Content="Brake %"/>
                                        <ComboBoxItem Content="Clutch %"/>
                                        <ComboBoxItem Content="Fuel Level"/>
                                        <ComboBoxItem Content="Water Temp"/>
                                        <ComboBoxItem Content="Oil Temp"/>
                                        <ComboBoxItem Content="Speed"/>
                                        <ComboBoxItem Content="RPM"/>
                                        <ComboBoxItem Content="Gear"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Text="Choose an optional data field to display on the left side of the gauge" 
                                           TextWrapping="Wrap"
                                           Foreground="Gray" 
                                           FontSize="11" 
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Right Side Box -->
                        <GroupBox Header="Right Side Box (Optional)" Margin="0,0,0,15" Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Field:" VerticalAlignment="Center" Width="100"/>
                                    <ComboBox x:Name="RightSideField" Width="200" SelectedIndex="2">
                                        <ComboBoxItem Content="None"/>
                                        <ComboBoxItem Content="Throttle %"/>
                                        <ComboBoxItem Content="Brake %"/>
                                        <ComboBoxItem Content="Clutch %"/>
                                        <ComboBoxItem Content="Fuel Level"/>
                                        <ComboBoxItem Content="Water Temp"/>
                                        <ComboBoxItem Content="Oil Temp"/>
                                        <ComboBoxItem Content="Speed"/>
                                        <ComboBoxItem Content="RPM"/>
                                        <ComboBoxItem Content="Gear"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Text="Choose an optional data field to display on the right side of the gauge" 
                                           TextWrapping="Wrap"
                                           Foreground="Gray" 
                                           FontSize="11" 
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <TextBlock Text="Note: All configuration changes apply immediately to active widget."
                                   TextWrapping="Wrap"
                                   Foreground="Gray"
                                   FontSize="11"
                                   Margin="0,20,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Data Widget Configuration Tab -->
            <TabItem Header="Data Widget Config" x:Name="DataWidgetConfigTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- Widget Activation -->
                        <CheckBox x:Name="ActivateDataWidget" 
                                  Content="Activate Data Widget" 
                                  FontSize="16"
                                  FontWeight="Bold"
                                  Margin="0,0,0,20"
                                  Checked="ActivateDataWidget_Checked"
                                  Unchecked="ActivateDataWidget_Unchecked"/>
                        
                        <Separator Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Configure Data Widget Cells (2x3 Grid)" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Select telemetry fields for each cell. Empty cells will be hidden automatically."
                                   TextWrapping="Wrap"
                                   Foreground="Gray"
                                   FontSize="12"
                                   Margin="0,0,0,20"/>
                        
                        <!-- Row 1 -->
                        <TextBlock Text="Row 1" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <StackPanel Width="180" Margin="0,0,10,0">
                                <TextBlock Text="Cell 1 (Top Left):" Margin="0,0,0,5"/>
                                <ComboBox x:Name="DataCell1Field" Width="170"/>
                            </StackPanel>
                            <StackPanel Width="180">
                                <TextBlock Text="Cell 2 (Top Right):" Margin="0,0,0,5"/>
                                <ComboBox x:Name="DataCell2Field" Width="170"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Row 2 -->
                        <TextBlock Text="Row 2" FontSize="14" FontWeight="Bold" Margin="0,10,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <StackPanel Width="180" Margin="0,0,10,0">
                                <TextBlock Text="Cell 3 (Middle Left):" Margin="0,0,0,5"/>
                                <ComboBox x:Name="DataCell3Field" Width="170"/>
                            </StackPanel>
                            <StackPanel Width="180">
                                <TextBlock Text="Cell 4 (Middle Right):" Margin="0,0,0,5"/>
                                <ComboBox x:Name="DataCell4Field" Width="170"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Row 3 -->
                        <TextBlock Text="Row 3" FontSize="14" FontWeight="Bold" Margin="0,10,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <StackPanel Width="180" Margin="0,0,10,0">
                                <TextBlock Text="Cell 5 (Bottom Left):" Margin="0,0,0,5"/>
                                <ComboBox x:Name="DataCell5Field" Width="170"/>
                            </StackPanel>
                            <StackPanel Width="180">
                                <TextBlock Text="Cell 6 (Bottom Right):" Margin="0,0,0,5"/>
                                <ComboBox x:Name="DataCell6Field" Width="170"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <Separator Margin="0,20"/>
                        
                        <!-- Widget Size Configuration -->
                        <TextBlock Text="Widget Size" FontSize="14" FontWeight="Bold" Margin="0,20,0,10"/>
                        <TextBlock Text="Adjust the size of the Data Widget (all elements scale proportionally)"
                                   TextWrapping="Wrap"
                                   Foreground="Gray"
                                   FontSize="11"
                                   Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="Size:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider x:Name="DataWidgetSizeSlider" 
                                    Width="200" 
                                    Minimum="200" 
                                    Maximum="800" 
                                    Value="400"
                                    TickFrequency="100"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="DataWidgetSizeSlider_ValueChanged"/>
                            <TextBlock x:Name="DataWidgetSizeText" 
                                       Text="400 x 300" 
                                       VerticalAlignment="Center" 
                                       Margin="10,0,0,0"
                                       Width="80"/>
                        </StackPanel>
                        
                        <TextBlock Text="Note: All configuration changes apply immediately to active widget."
                                   TextWrapping="Wrap"
                                   Foreground="Gray"
                                   FontSize="11"
                                   Margin="0,20,0,5"/>
                        
                        <TextBlock Text="Tip: Select 'None' for cells you don't want to display. Empty cells will be automatically hidden."
                                   TextWrapping="Wrap"
                                   Foreground="Gray"
                                   FontSize="11"
                                   Margin="0,5,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Fuel Widget Configuration Tab -->
            <TabItem Header="Fuel Widget Config" x:Name="FuelWidgetConfigTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- Widget Activation -->
                        <CheckBox x:Name="ActivateFuelWidget" 
                                  Content="Activate Fuel Calculator Widget" 
                                  FontSize="16"
                                  FontWeight="Bold"
                                  Margin="0,0,0,20"
                                  Checked="ActivateFuelWidget_Checked"
                                  Unchecked="ActivateFuelWidget_Unchecked"/>
                        
                        <Separator Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Fuel Calculator Widget" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Automatically calculates fuel consumption per lap and estimates remaining laps based on current fuel level."
                                   TextWrapping="Wrap"
                                   Foreground="Gray"
                                   FontSize="12"
                                   Margin="0,0,0,20"/>
                        
                        <!-- Widget Size Configuration -->
                        <TextBlock Text="Widget Size" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Adjust the size of the Fuel Widget (all elements scale proportionally)"
                                   TextWrapping="Wrap"
                                   Foreground="Gray"
                                   FontSize="11"
                                   Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="Size:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider x:Name="FuelWidgetSizeSlider" 
                                    Width="200" 
                                    Minimum="50" 
                                    Maximum="150" 
                                    Value="100"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="FuelWidgetSizeSlider_ValueChanged"/>
                            <TextBlock x:Name="FuelWidgetSizeText" 
                                       Text="100%" 
                                       VerticalAlignment="Center" 
                                       Margin="10,0,0,0"
                                       Width="50"/>
                        </StackPanel>
                        
                        <Separator Margin="0,10,0,20"/>
                        
                        <!-- Reset Button -->
                        <TextBlock Text="Reset Calculations" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Clear all fuel consumption data and start fresh calculations."
                                   TextWrapping="Wrap"
                                   Foreground="Gray"
                                   FontSize="11"
                                   Margin="0,0,0,10"/>
                        
                        <Button x:Name="ResetFuelCalculations" 
                                Content="Reset Fuel Data" 
                                Width="150"
                                Height="30"
                                HorizontalAlignment="Left"
                                Click="ResetFuelCalculations_Click"
                                Background="#FFCC5500"
                                Foreground="White"
                                FontWeight="Bold"
                                Margin="0,0,0,20"/>
                        
                        <Separator Margin="0,10,0,20"/>
                        
                        <!-- Usage Information -->
                        <TextBlock Text="How It Works" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,5">
                            <Run Text="• "/>
                            <Run Text="Current Fuel Level: " FontWeight="Bold"/>
                            <Run Text="Shows your current fuel in the tank"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,5">
                            <Run Text="• "/>
                            <Run Text="Used Last Lap: " FontWeight="Bold"/>
                            <Run Text="Fuel consumed on the previous lap"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,5">
                            <Run Text="• "/>
                            <Run Text="Avg Per Lap: " FontWeight="Bold"/>
                            <Run Text="Running average of fuel consumption per lap"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,20">
                            <Run Text="• "/>
                            <Run Text="Laps Remaining: " FontWeight="Bold"/>
                            <Run Text="Estimated laps based on current fuel and average consumption"/>
                            <LineBreak/>
                            <Run Text="  - "/>
                            <Run Text="Red: &lt; 2 laps" Foreground="#FFFF3333"/>
                            <LineBreak/>
                            <Run Text="  - "/>
                            <Run Text="Orange: &lt; 5 laps" Foreground="#FFFF9900"/>
                            <LineBreak/>
                            <Run Text="  - "/>
                            <Run Text="Yellow: OK" Foreground="#FFFFFF00"/>
                        </TextBlock>
                        
                        <TextBlock Text="Note: All configuration changes apply immediately to active widget."
                                   TextWrapping="Wrap"
                                   Foreground="Gray"
                                   FontSize="11"
                                   Margin="0,20,0,5"/>
                        
                        <TextBlock Text="Tip: Reset fuel calculations when starting a new stint or after refueling."
                                   TextWrapping="Wrap"
                                   Foreground="Gray"
                                   FontSize="11"
                                   Margin="0,5,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="#F0F0F0" 
                Padding="10">
            <StackPanel>
                <TextBlock x:Name="StatusText" 
                           Text="Status: Ready" 
                           FontSize="12"/>
                <TextBlock x:Name="WidgetCountText" 
                           Text="Active Widgets: 0" 
                           FontSize="12"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
