<Window x:Class="iRacingOverlay.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MRT UI"
        Height="800" Width="1120"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <!--
            Top-level navigation. A pill that fills with the brand teal when
            active, rather than a bare glyph distinguished only by tint.
        -->
        <Style x:Key="NavTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="{StaticResource CR.Control}"
                                Padding="16,8">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TealDim}"/>
                                <Setter Property="Foreground" Value="{StaticResource TealBright}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- HEADER — brand, navigation, live connection state           -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Wordmark. Teal and orange, the team colours, doing the
                     identity job so the accent is free elsewhere. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,28,0">
                    <TextBlock Text="MRT" Style="{StaticResource T.Display}"
                               Foreground="{StaticResource TealBright}"/>
                    <TextBlock Text="UI" Style="{StaticResource T.Display}"
                               Foreground="{StaticResource Orange}" Margin="3,0,0,0"/>
                    <TextBlock x:Name="TitleVersionText" Text="v0.0.0"
                               Style="{StaticResource T.Caption}" FontSize="11"
                               VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="NavOverlay" Style="{StaticResource NavTab}"
                                 Content="Overlay" IsChecked="True"
                                 Tag="Overlay" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavTab}"
                                 Content="Settings" Tag="Settings" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavTab}"
                                 Content="About" Tag="About" Checked="Nav_Checked"/>
                </StackPanel>

                <!-- Connection state, always visible. Previously buried in a
                     28px status strip at 10px type. -->
                <Border Grid.Column="3" VerticalAlignment="Center"
                        Background="{StaticResource SurfaceRaised}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="{StaticResource CR.Pill}"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionDot" Width="8" Height="8"
                                 VerticalAlignment="Center" Margin="0,0,8,0"
                                 Fill="{StaticResource StatusDisconnected}"/>
                        <TextBlock x:Name="ConnectionStatusText" Text="Disconnected"
                                   Style="{StaticResource T.Body}" FontSize="12"/>
                        <Rectangle Width="1" Margin="12,2" Fill="{StaticResource Border}"
                                   x:Name="StatusDivider"/>
                        <TextBlock x:Name="SessionTypeText" Text=""
                                   Style="{StaticResource T.Body}" FontSize="12"
                                   Foreground="{StaticResource Orange}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- CONTENT                                                     -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <ContentControl x:Name="PageHost" Grid.Row="1"/>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- STATUS BAR — telemetry health                               -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RATE" Style="{StaticResource T.Label}" FontSize="10"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdateRateText" Text="0 Hz" Style="{StaticResource T.Data}"
                               Margin="6,0,18,0" VerticalAlignment="Center"/>

                    <TextBlock Text="FRAME" Style="{StaticResource T.Label}" FontSize="10"
                               VerticalAlignment="Center"
                               ToolTip="UI thread frame time. Above ~16 ms the overlay cannot keep up with the 60 Hz feed."/>
                    <TextBlock x:Name="FrameTimeText" Text="—" Style="{StaticResource T.Data}"
                               Margin="6,0,18,0" VerticalAlignment="Center"/>

                    <TextBlock Text="DROPPED" Style="{StaticResource T.Label}" FontSize="10"
                               VerticalAlignment="Center"
                               ToolTip="Telemetry frames skipped because a widget render was still pending."/>
                    <TextBlock x:Name="DroppedText" Text="0" Style="{StaticResource T.Data}"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="HotkeysText" Style="{StaticResource T.Caption}" FontSize="11"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
