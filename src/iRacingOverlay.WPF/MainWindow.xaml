<Window x:Class="iRacingOverlay.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MRT UI" 
        Height="720" Width="740"
        MinHeight="600" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkBackground}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- TITLE BAR                                               -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource DarkSurface}" 
                BorderBrush="{StaticResource TealPrimary}" BorderThickness="0,0,0,2">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MRT UI" 
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TealPrimary}"
                               Margin="0,0,6,0"/>
                    <TextBlock x:Name="TitleVersionText"
                               Text="v1.0.0" FontSize="11" 
                               Foreground="{StaticResource MutedText}"
                               VerticalAlignment="Bottom" Margin="0,0,6,2"/>
                    <TextBlock x:Name="TitleUpdateStatus"
                               Text="" FontSize="10" 
                               Foreground="{StaticResource MutedText}"
                               VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- CONTENT: Nav sidebar + Page host                        -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- NAVIGATION SIDEBAR                                      -->
            <!--                                                         -->
            <!-- Icon plus label. The rail was 44px of bare Unicode      -->
            <!-- glyphs with tooltips as the only way to tell them apart.-->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Column="0" Background="{StaticResource DarkSurface}"
                    BorderBrush="{StaticResource DarkBorder}" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Top" Margin="0,6,0,0">
                    <StackPanel.Resources>
                        <Style x:Key="NavItem" TargetType="Button">
                            <Setter Property="Width" Value="80"/>
                            <Setter Property="Height" Value="46"/>
                            <Setter Property="Margin" Value="4,2"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="{StaticResource LightText}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="0,4">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <Button x:Name="NavDashboard" Style="{StaticResource NavItem}"
                            Click="NavButton_Click" Tag="Dashboard"
                            Foreground="{StaticResource TealPrimary}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#x2302;" FontSize="17" HorizontalAlignment="Center"/>
                            <TextBlock Text="Dashboard" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavWidgets" Style="{StaticResource NavItem}"
                            Click="NavButton_Click" Tag="Widgets">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#x25A6;" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock Text="Widgets" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSessions" Style="{StaticResource NavItem}"
                            Click="NavButton_Click" Tag="Sessions">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#x23F1;" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock Text="Sessions" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettings" Style="{StaticResource NavItem}"
                            Click="NavButton_Click" Tag="Settings">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#x2699;" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock Text="Settings" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavAbout" Style="{StaticResource NavItem}"
                            Click="NavButton_Click" Tag="About">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#x2139;" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock Text="About" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            
            <!-- PAGE HOST -->
            <ContentControl x:Name="PageHost" Grid.Column="1"/>
        </Grid>
        
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- STATUS BAR                                              -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource DarkSurface}"
                BorderBrush="{StaticResource DarkBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionStatusText" 
                               Text="Disconnected" FontSize="10"
                               Foreground="#888888" Margin="0,0,12,0"/>
                    <TextBlock x:Name="SessionTypeText" Text=""
                               FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource TealPrimary}" Margin="0,0,12,0"/>
                    <TextBlock Text="Rate: " FontSize="9"
                               Foreground="{StaticResource MutedText}" Margin="0,0,2,0"/>
                    <TextBlock x:Name="UpdateRateText" Text="0 Hz" FontSize="9"
                               Foreground="{StaticResource TealPrimary}"/>
                </StackPanel>
                <TextBlock x:Name="HotkeysText" 
                           Text="Ctrl+L Lock | Ctrl+H Show/Hide"
                           FontSize="9"
                           Foreground="{StaticResource MutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
