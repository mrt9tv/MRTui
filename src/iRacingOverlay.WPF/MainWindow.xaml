<Window x:Class="iRacingOverlay.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MRT UI | iRacing Overlay" 
        Height="720" Width="560"
        MinHeight="600" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkBackground}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource DarkSurface}" 
                BorderBrush="{StaticResource TealPrimary}" BorderThickness="0,0,0,2">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MRT UI" 
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TealPrimary}"
                               Margin="0,0,6,0"/>
                    <TextBlock x:Name="TitleVersionText"
                               Text="v1.0.0" FontSize="12" 
                               Foreground="{StaticResource MutedText}"
                               VerticalAlignment="Bottom" Margin="0,0,8,3"/>
                    <TextBlock Text="| iRacing Overlay" 
                               FontSize="15" 
                               Foreground="{StaticResource LightText}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- LEFT COLUMN: Widget Selection + Core Controls          -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="0">
                    
                    <!-- WIDGET SELECTOR -->
                    <Border Style="{StaticResource MRT.Card}" Margin="0,6,0,6" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="ACTIVE WIDGET" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CboActiveWidget"
                                      Height="28" FontSize="13"
                                      SelectionChanged="CboActiveWidget_SelectionChanged"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                                <Button x:Name="BtnToggleWidget"
                                        Content="Show"
                                        Style="{StaticResource MRT.Button.Secondary}"
                                        Click="BtnToggleWidget_Click"
                                        Width="70" Height="28" Margin="0,0,6,0"
                                        FontSize="12" Padding="4,2"/>
                                <Button x:Name="BtnLockWidgets"
                                        Content="Lock"
                                        Style="{StaticResource MRT.Button.Secondary}"
                                        Click="BtnLockWidgets_Click"
                                        Width="60" Height="28"
                                        FontSize="12" Padding="4,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="WidgetStatusText"
                               Text="Ready."
                               FontSize="11"
                               Foreground="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    
                    <!-- ═══════ MRT ONE: SIZE + POSITION ═══════ -->
                    <StackPanel x:Name="MRTOnePanel" Visibility="Collapsed">
                        <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Size -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SIZE" Style="{StaticResource MRT.Text.Label}" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderWidgetSize" Grid.Column="1"
                                            Style="{StaticResource MRT.Slider}"
                                            Minimum="120" Maximum="600" Value="240"
                                            TickFrequency="10" IsSnapToTickEnabled="True"
                                            ValueChanged="SliderWidgetSize_ValueChanged"/>
                                    <TextBlock x:Name="TxtSizeValue" Grid.Column="2"
                                               Text="240px" FontSize="11"
                                               Foreground="{StaticResource TealPrimary}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                                
                                <!-- Position buttons -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Center H" 
                                            Style="{StaticResource MRT.Button.Secondary}"
                                            Click="BtnCenterH_Click"
                                            Width="72" Height="26" Margin="0,0,4,0"
                                            FontSize="10" Padding="3,2"/>
                                    <Button Content="Center V" 
                                            Style="{StaticResource MRT.Button.Secondary}"
                                            Click="BtnCenterV_Click"
                                            Width="72" Height="26" Margin="0,0,4,0"
                                            FontSize="10" Padding="3,2"/>
                                    <Button Content="Both" 
                                            Style="{StaticResource MRT.Button.Secondary}"
                                            Click="BtnCenterBoth_Click"
                                            Width="52" Height="26"
                                            FontSize="10" Padding="3,2"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    
                        <!-- ═══════ MRT ONE: DATA FIELDS ═══════ -->
                        <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="DATA FIELDS" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,6"/>
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,4">
                                        <TextBlock Text="Top" Foreground="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,2"/>
                                        <ComboBox x:Name="CboTopField" Height="26" FontSize="12"
                                                  SelectionChanged="FieldCombo_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,4">
                                        <TextBlock Text="Center" Foreground="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,2"/>
                                        <ComboBox x:Name="CboCenterField" Height="26" FontSize="12"
                                                  SelectionChanged="FieldCombo_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,4">
                                        <TextBlock Text="Bottom" Foreground="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,2"/>
                                        <ComboBox x:Name="CboBottomField" Height="26" FontSize="12"
                                                  SelectionChanged="FieldCombo_SelectionChanged"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,0,2">
                                            <TextBlock Text="Left" Foreground="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,2"/>
                                            <ComboBox x:Name="CboLeftField" Height="26" FontSize="12"
                                                      SelectionChanged="FieldCombo_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,0,2">
                                            <TextBlock Text="Right" Foreground="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,2"/>
                                            <ComboBox x:Name="CboRightField" Height="26" FontSize="12"
                                                      SelectionChanged="FieldCombo_SelectionChanged"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- END MRT ONE LEFT COLUMN -->

                    <!-- ═══════ TURN DISPLAY CONTROLS ═══════ -->
                    <StackPanel x:Name="TurnDisplayPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="TURN DISPLAY" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,4"/>
                                <TextBlock Text="Shows next and last turn on track"
                                           FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,0,0,10"
                                           TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <CheckBox x:Name="ChkShowTurnNames" Content="Show Turn Names"
                                              Style="{StaticResource MRT.ToggleButton}"
                                              IsChecked="True" Margin="0,0,10,4"
                                              Checked="TurnDisplayToggle_Changed" Unchecked="TurnDisplayToggle_Changed"/>
                                    <CheckBox x:Name="ChkAnimateBorder" Content="Animate Border"
                                              Style="{StaticResource MRT.ToggleButton}"
                                              IsChecked="False" Margin="0,0,10,4"
                                              Checked="TurnDisplayToggle_Changed" Unchecked="TurnDisplayToggle_Changed"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- END TURN DISPLAY CONTROLS -->

                    <!-- ═══════ FUEL CALCULATOR CONTROLS ═══════ -->
                    <StackPanel x:Name="FuelCalculatorPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="FUEL CALCULATOR" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,4"/>
                                <TextBlock Text="Shows fuel saving, lift &amp; coast, and pit vs save strategy."
                                           FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,0,0,6"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Laps remaining accounts for 0.3L splutter buffer."
                                           FontSize="10" Foreground="{StaticResource OrangePrimary}" Margin="0,0,0,8"
                                           TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <CheckBox x:Name="ChkFuelL3" Content="L3 Avg"
                                              Style="{StaticResource MRT.ToggleButton}"
                                              IsChecked="True" Margin="0,0,8,4"
                                              Checked="FuelCalculatorToggle_Changed" Unchecked="FuelCalculatorToggle_Changed"/>
                                    <CheckBox x:Name="ChkFuelL5" Content="L5 Avg"
                                              Style="{StaticResource MRT.ToggleButton}"
                                              IsChecked="True" Margin="0,0,8,4"
                                              Checked="FuelCalculatorToggle_Changed" Unchecked="FuelCalculatorToggle_Changed"/>
                                    <CheckBox x:Name="ChkFuelBuffer" Content="Buffer"
                                              Style="{StaticResource MRT.ToggleButton}"
                                              IsChecked="True" Margin="0,0,8,4"
                                              Checked="FuelCalculatorToggle_Changed" Unchecked="FuelCalculatorToggle_Changed"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- END FUEL CALCULATOR CONTROLS -->
                    
                </StackPanel>
                <!-- END LEFT COLUMN -->
                
                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- RIGHT COLUMN: Extended Settings + Alerts               -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="2">
                    
                    <!-- ═══════ MRT ONE: FUEL ALERTS ═══════ -->
                    <StackPanel x:Name="MRTOneRightPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource MRT.Card}" Margin="0,6,0,6" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="FUEL ALERTS" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,4"/>
                                <TextBlock Text="Thresholds (doable laps)"
                                           FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,0,0,6"
                                           TextWrapping="Wrap"/>
                                
                                <!-- Yellow threshold -->
                                <StackPanel Margin="0,0,0,6">
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkFuelYellow" IsChecked="True"
                                                  Foreground="#FFFF00" FontSize="10" VerticalAlignment="Center"
                                                  Margin="0,0,4,0"
                                                  Checked="FuelAlertToggle_Changed" Unchecked="FuelAlertToggle_Changed"/>
                                        <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center">
                                            <Run Text="Yellow" Foreground="#FFFF00"/>
                                            <Run Text=" (caution)" Foreground="{StaticResource MutedText}"/>
                                        </TextBlock>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SliderFuelYellow"
                                                Style="{StaticResource MRT.Slider}"
                                                Minimum="1" Maximum="15" Value="5"
                                                TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                ValueChanged="FuelAlert_ValueChanged"/>
                                        <TextBlock x:Name="TxtFuelYellow" Grid.Column="1"
                                                   Text="5.0" FontSize="11"
                                                   Foreground="#FFFF00"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Red threshold -->
                                <StackPanel Margin="0,0,0,6">
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkFuelRed" IsChecked="True"
                                                  Foreground="#FF3333" FontSize="10" VerticalAlignment="Center"
                                                  Margin="0,0,4,0"
                                                  Checked="FuelAlertToggle_Changed" Unchecked="FuelAlertToggle_Changed"/>
                                        <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center">
                                            <Run Text="Red" Foreground="#FF3333"/>
                                            <Run Text=" (urgent)" Foreground="{StaticResource MutedText}"/>
                                        </TextBlock>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SliderFuelRed"
                                                Style="{StaticResource MRT.Slider}"
                                                Minimum="0.5" Maximum="10" Value="2"
                                                TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                ValueChanged="FuelAlert_ValueChanged"/>
                                        <TextBlock x:Name="TxtFuelRed" Grid.Column="1"
                                                   Text="2.0" FontSize="11"
                                                   Foreground="#FF3333"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Critical threshold -->
                                <StackPanel Margin="0,0,0,6">
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkFuelCritical" IsChecked="True"
                                                  Foreground="#FF0000" FontSize="10" VerticalAlignment="Center"
                                                  Margin="0,0,4,0"
                                                  Checked="FuelAlertToggle_Changed" Unchecked="FuelAlertToggle_Changed"/>
                                        <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center">
                                            <Run Text="Critical" Foreground="#FF0000"/>
                                            <Run Text=" (blink)" Foreground="{StaticResource MutedText}"/>
                                        </TextBlock>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SliderFuelCritical"
                                                Style="{StaticResource MRT.Slider}"
                                                Minimum="0" Maximum="5" Value="1"
                                                TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                ValueChanged="FuelAlert_ValueChanged"/>
                                        <TextBlock x:Name="TxtFuelCritical" Grid.Column="1"
                                                   Text="1.0" FontSize="11"
                                                   Foreground="#FF0000"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Sputtering threshold -->
                                <StackPanel Margin="0,0,0,2">
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkFuelSputter" IsChecked="True"
                                                  Foreground="{StaticResource OrangePrimary}" FontSize="10" VerticalAlignment="Center"
                                                  Margin="0,0,4,0"
                                                  ToolTip="When enabled, fuel below this level is considered unusable.&#x0a;The engine sputters and dies before the tank is truly empty.&#x0a;&#x0a;Varies by car:&#x0a;  GT3 ≈ 0.3 L&#x0a;  Formula ≈ 0.2 L&#x0a;  Heavy / prototypes ≈ 0.5 L&#x0a;&#x0a;This is subtracted from your current fuel before calculating&#x0a;doable laps, giving you a realistic picture instead of a&#x0a;theoretical 'fuel ÷ consumption' number."
                                                  Checked="FuelAlertToggle_Changed" Unchecked="FuelAlertToggle_Changed"/>
                                        <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center"
                                                   ToolTip="Fuel level (litres) below which the engine sputters and dies.&#x0a;Subtracted from current fuel for realistic 'doable laps' calculation.&#x0a;&#x0a;GT3 ≈ 0.3 L  |  Formula ≈ 0.2 L  |  Heavy ≈ 0.5 L">
                                            <Run Text="Sputter" Foreground="{StaticResource OrangePrimary}"/>
                                            <Run Text=" (L) ℹ" Foreground="{StaticResource MutedText}"/>
                                        </TextBlock>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SliderFuelSputter"
                                                Style="{StaticResource MRT.Slider}"
                                                Minimum="0" Maximum="2" Value="0.3"
                                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                ValueChanged="FuelAlert_ValueChanged"/>
                                        <TextBlock x:Name="TxtFuelSputter" Grid.Column="1"
                                                   Text="0.3L" FontSize="11"
                                                   Foreground="{StaticResource OrangePrimary}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ═══════ MRT ONE: VISUALS ═══════ -->
                        <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="VISUALS" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,4"/>
                                <WrapPanel>
                                    <CheckBox x:Name="ChkGradientBg" Content="Gradient BG"
                                              Style="{StaticResource MRT.ToggleButton}"
                                              IsChecked="True" Margin="0,0,8,4"
                                              Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed"/>
                                    <CheckBox x:Name="ChkShiftRing" Content="Shift Ring"
                                              Style="{StaticResource MRT.ToggleButton}"
                                              Margin="0,0,8,4"
                                              Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed"/>
                                    <CheckBox x:Name="ChkGlow" Content="Glow"
                                              Style="{StaticResource MRT.ToggleButton}"
                                              Margin="0,0,8,4"
                                              Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed"/>
                                    <CheckBox x:Name="ChkPitLimiter" Content="Pit Limiter"
                                              Style="{StaticResource MRT.ToggleButton}"
                                              IsChecked="True" Margin="0,0,8,4"
                                              Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed"/>
                                    <CheckBox x:Name="ChkEnhancedRadar" Content="Radar+"
                                              Style="{StaticResource MRT.ToggleButton}"
                                              Margin="0,0,8,4"
                                              Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- END MRT ONE RIGHT COLUMN -->
                    
                </StackPanel>
                <!-- END RIGHT COLUMN -->
                
            </Grid>
        </ScrollViewer>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource DarkSurface}"
                BorderBrush="{StaticResource DarkBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionStatusText" 
                               Text="Disconnected" FontSize="11"
                               Foreground="#888888" Margin="0,0,16,0"/>
                    <TextBlock Text="Rate: " FontSize="10"
                               Foreground="{StaticResource MutedText}" Margin="0,0,2,0"/>
                    <TextBlock x:Name="UpdateRateText" Text="0 Hz" FontSize="10"
                               Foreground="{StaticResource TealPrimary}"/>
                </StackPanel>
                <TextBlock x:Name="HotkeysText" 
                           Text="Ctrl+L Lock | Ctrl+H Show/Hide"
                           FontSize="10"
                           Foreground="{StaticResource MutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
