<UserControl x:Class="iRacingOverlay.WPF.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
        <StackPanel MaxWidth="620" HorizontalAlignment="Left">

            <!-- Identity. The wordmark carries the team colours at a size the
                 header cannot, so this reads as the product's front door. -->
            <StackPanel Margin="0,8,0,24">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="MRT" FontFamily="{StaticResource Font.Ui}"
                               FontSize="40" FontWeight="Bold"
                               Foreground="{StaticResource TealBright}"/>
                    <TextBlock Text="UI" FontFamily="{StaticResource Font.Ui}"
                               FontSize="40" FontWeight="Bold"
                               Foreground="{StaticResource Orange}" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TxtVersion" Text="v0.0.0"
                           Style="{StaticResource T.Body}"
                           Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                <TextBlock Text="Real-time telemetry overlays for iRacing."
                           Style="{StaticResource T.Body}" Margin="0,12,0,0"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="UPDATES" Style="{StaticResource T.Label}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnCheckUpdate" Content="Check for updates"
                                Style="{StaticResource Btn.Secondary}"
                                Click="BtnCheckUpdate_Click" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TxtUpdateStatus" Style="{StaticResource T.Body}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtUpdateInfo" Style="{StaticResource T.Caption}"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="LINKS" Style="{StaticResource T.Label}" Margin="0,0,0,12"/>
                    <TextBlock Style="{StaticResource T.Body}" Margin="0,0,0,6">
                        <Hyperlink NavigateUri="https://github.com/mrt9tv/MRTui/releases"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   TextDecorations="None">
                            <Run Text="Release notes" Foreground="{StaticResource TealBright}"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Style="{StaticResource T.Body}">
                        <Hyperlink NavigateUri="https://github.com/mrt9tv/MRTui"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   TextDecorations="None">
                            <Run Text="Project on GitHub" Foreground="{StaticResource TealBright}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
