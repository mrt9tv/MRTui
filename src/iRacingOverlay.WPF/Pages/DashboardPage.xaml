<UserControl x:Class="iRacingOverlay.WPF.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
        <StackPanel>
            
            <!-- CONNECTION STATUS -->
            <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,8" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Status dot -->
                    <Ellipse x:Name="ConnectionDot" Width="14" Height="14"
                             Fill="#888888" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtConnectionStatus" Text="Disconnected"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource LightText}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Update rate: " FontSize="11"
                                       Foreground="{StaticResource MutedText}"/>
                            <TextBlock x:Name="TxtUpdateRate" Text="0 Hz"
                                       FontSize="11" Foreground="{StaticResource TealPrimary}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Session badge -->
                    <Border Grid.Column="2" Background="#1A1A1A" CornerRadius="4"
                            Padding="10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SESSION: " FontSize="10"
                                       Foreground="{StaticResource MutedText}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSessionType" Text="—"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="#888888"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            
            <!-- ACTIVE WIDGETS -->
            <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="ACTIVE WIDGETS" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="WidgetList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A1A1A" CornerRadius="4" Margin="0,0,0,4" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" FontSize="16"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{StaticResource TealPrimary}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       Foreground="{StaticResource LightText}"/>
                                            <TextBlock Text="{Binding Status}" FontSize="10"
                                                       Foreground="{StaticResource MutedText}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2"
                                                  Style="{StaticResource MRT.ToggleButton}"
                                                  IsChecked="{Binding IsActive}"
                                                  VerticalAlignment="Center"
                                                  Checked="WidgetToggle_Changed"
                                                  Unchecked="WidgetToggle_Changed"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            
            <!-- QUICK ACTIONS -->
            <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="QUICK ACTIONS" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button x:Name="BtnLockAll" Content="🔒 Lock All"
                                Style="{StaticResource MRT.Button.Secondary}"
                                Click="BtnLockAll_Click"
                                Height="30" FontSize="11" Padding="10,4" Margin="0,0,6,4"/>
                        <Button x:Name="BtnShowHideAll" Content="👁 Show/Hide All"
                                Style="{StaticResource MRT.Button.Secondary}"
                                Click="BtnShowHideAll_Click"
                                Height="30" FontSize="11" Padding="10,4" Margin="0,0,6,4"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            
            <!-- SESSION AUTO-PRESETS -->
            <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,8" Padding="14,10">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SESSION AUTO-PRESETS" Style="{StaticResource MRT.Text.Label}"/>
                            <TextBlock Text="Auto-switch widget visibility when session type changes."
                                       FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkSessionPresetsEnabled" Grid.Column="1"
                                  Style="{StaticResource MRT.ToggleButton}"
                                  VerticalAlignment="Top" Margin="8,0,0,0"
                                  Checked="SessionPresetsEnabled_Changed"
                                  Unchecked="SessionPresetsEnabled_Changed"/>
                    </Grid>
                    
                    <StackPanel x:Name="PanelSessionPresets" Margin="0,4,0,0">
                        <Button x:Name="BtnExpandPresets" Content="▶ Show preset details"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TealPrimary}"
                                FontSize="11" HorizontalAlignment="Left" Cursor="Hand"
                                Padding="0,2" Click="BtnExpandPresets_Click"/>
                        
                        <StackPanel x:Name="PanelPresetDetails" Visibility="Collapsed" Margin="0,6,0,0">
                            <!-- Each session type gets a mini-section -->
                            
                            <!-- PRACTICE -->
                            <Border Background="#1A1A1A" CornerRadius="4" Margin="0,0,0,4" Padding="10,6">
                                <StackPanel>
                                    <TextBlock Text="PRACTICE" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#00BCD4" Margin="0,0,0,4"/>
                                    <WrapPanel x:Name="WrapPractice"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- QUALIFYING -->
                            <Border Background="#1A1A1A" CornerRadius="4" Margin="0,0,0,4" Padding="10,6">
                                <StackPanel>
                                    <TextBlock Text="QUALIFYING" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#AB47BC" Margin="0,0,0,4"/>
                                    <WrapPanel x:Name="WrapQualifying"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- RACE -->
                            <Border Background="#1A1A1A" CornerRadius="4" Margin="0,0,0,4" Padding="10,6">
                                <StackPanel>
                                    <TextBlock Text="RACE" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#4CAF50" Margin="0,0,0,4"/>
                                    <WrapPanel x:Name="WrapRace"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- WARMUP -->
                            <Border Background="#1A1A1A" CornerRadius="4" Margin="0,0,0,4" Padding="10,6">
                                <StackPanel>
                                    <TextBlock Text="WARMUP" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#FF9800" Margin="0,0,0,4"/>
                                    <WrapPanel x:Name="WrapWarmup"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- HOTKEYS REMINDER -->
            <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="HOTKEYS" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtHotkeys" 
                               Text="Ctrl+L Lock | Ctrl+H Show/Hide"
                               FontSize="11" Foreground="{StaticResource MutedText}"/>
                </StackPanel>
            </Border>
            
            <!-- PERFORMANCE FOOTER -->
            <Border Background="#0D0D0D" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="CPU: " FontSize="10" Foreground="{StaticResource MutedText}"/>
                    <TextBlock x:Name="TxtCpuUsage" Text="—" FontSize="10" Foreground="{StaticResource TealPrimary}" Margin="0,0,14,0"/>
                    <TextBlock Text="MEM: " FontSize="10" Foreground="{StaticResource MutedText}"/>
                    <TextBlock x:Name="TxtMemUsage" Text="—" FontSize="10" Foreground="{StaticResource TealPrimary}"/>
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
