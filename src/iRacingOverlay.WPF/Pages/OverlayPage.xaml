<UserControl x:Class="iRacingOverlay.WPF.Pages.OverlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <!--
        OVERLAY

        One screen replacing the old Dashboard + Widgets pair, which both listed
        the widgets and both offered a toggle, leaving it ambiguous which owned
        the setting.

        Left  — every widget, with a switch. Select one to configure it.
        Right — that widget's settings, rendered from its own declarations.
    -->

    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ WIDGET LIST ═══════════════ -->
        <DockPanel Grid.Column="0">

            <TextBlock DockPanel.Dock="Top" Text="WIDGETS"
                       Style="{StaticResource T.Label}" Margin="2,0,0,10"/>

            <!-- Global actions sit at the bottom, away from the per-widget rows,
                 so "lock everything" is never mistaken for a widget toggle. -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}"
                    Margin="0,12,0,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="ALL WIDGETS" Style="{StaticResource T.Label}" Margin="0,0,0,10"/>
                    <UniformGrid Columns="2" Margin="0,0,0,4">
                        <Button x:Name="BtnLockAll" Content="Lock"
                                Style="{StaticResource Btn.Secondary}"
                                Click="BtnLockAll_Click" Margin="0,0,4,0"
                                ToolTip="Lock positions and let clicks pass through to iRacing"/>
                        <Button x:Name="BtnShowHideAll" Content="Hide all"
                                Style="{StaticResource Btn.Secondary}"
                                Click="BtnShowHideAll_Click" Margin="4,0,0,0"/>
                    </UniformGrid>
                    <TextBlock x:Name="TxtHotkeyHint" Style="{StaticResource T.Caption}"
                               FontSize="11" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="WidgetList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,0,6" Padding="12,10"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="WidgetRow_Click"
                                    Tag="{Binding Type}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Selection bar: which widget the right pane is showing -->
                                    <Border Grid.Column="0" Width="3" CornerRadius="2"
                                            Margin="0,0,10,0"
                                            Background="{Binding AccentBrush}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Body}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource T.Caption}"
                                                   FontSize="11" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <CheckBox Grid.Column="2"
                                              Style="{StaticResource Switch}"
                                              IsChecked="{Binding IsVisible, Mode=OneWay}"
                                              Tag="{Binding Type}"
                                              VerticalAlignment="Center"
                                              ToolTip="Show or hide this widget. Settings are kept."
                                              Checked="WidgetToggle_Changed"
                                              Unchecked="WidgetToggle_Changed"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- ═══════════════ SETTINGS FOR SELECTED WIDGET ═══════════════ -->
        <DockPanel Grid.Column="2">

            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSelectedWidget" Text="MRT One"
                               Style="{StaticResource T.Display}"/>
                    <TextBlock x:Name="TxtSelectedState" Style="{StaticResource T.Caption}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search across every setting of this widget. Only possible
                         because the settings are declared rather than hand-built. -->
                    <TextBox x:Name="TxtSearch" Width="180" Height="32"
                             TextChanged="Search_TextChanged"
                             ToolTip="Filter this widget's settings"/>
                    <Button x:Name="BtnRemoveWidget" Content="Remove"
                            Style="{StaticResource Btn.Danger}"
                            Click="BtnRemoveWidget_Click"
                            Margin="8,0,0,0" Height="32"
                            ToolTip="Delete this widget and discard its saved settings"/>
                </StackPanel>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <StackPanel x:Name="SettingsHost"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
