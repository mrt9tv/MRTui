<UserControl x:Class="iRacingOverlay.WPF.Pages.SessionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
        <StackPanel>
            
            <!-- AUTO-DETECT TOGGLE -->
            <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="SESSION AUTO-DETECT" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,6"/>
                    <TextBlock Text="Automatically configure widget visibility when iRacing session type changes."
                               FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <CheckBox x:Name="ChkAutoDetectSession" Content="Enable Auto-Detect"
                              Style="{StaticResource MRT.ToggleButton}"
                              IsChecked="False" Margin="0,0,0,4"
                              Checked="ChkAutoDetect_Changed" Unchecked="ChkAutoDetect_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Current session: " FontSize="11" Foreground="{StaticResource MutedText}"/>
                        <TextBlock x:Name="TxtSessionIndicator" Text="—" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#888888"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- SESSION PRESETS GRID -->
            <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="WIDGET VISIBILITY PER SESSION" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,8"/>
                    <TextBlock Text="Check which widgets should be visible in each session type."
                               FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    
                    <!-- Practice -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Practice" FontSize="11" Foreground="#00BCD4" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <WrapPanel Margin="4,0,0,0">
                            <CheckBox x:Name="ChkSession_Practice_MRTOne" Content="MRT One" FontSize="10" IsChecked="True"
                                      Tag="Practice:MRTOne" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Practice_TurnDisplay" Content="Turn" FontSize="10" IsChecked="True"
                                      Tag="Practice:TurnDisplay" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Practice_FuelCalculator" Content="Fuel" FontSize="10" IsChecked="True"
                                      Tag="Practice:FuelCalculator" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Practice_Relative" Content="Relative" FontSize="10" IsChecked="True"
                                      Tag="Practice:Relative" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Practice_ProximityFeed" Content="Prox Feed" FontSize="10" IsChecked="False"
                                      Tag="Practice:ProximityFeed" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Practice_Standings" Content="Standings" FontSize="10" IsChecked="False"
                                      Tag="Practice:Standings" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                        </WrapPanel>
                    </StackPanel>
                    
                    <!-- Qualifying -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Qualifying" FontSize="11" Foreground="#AB47BC" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <WrapPanel Margin="4,0,0,0">
                            <CheckBox x:Name="ChkSession_Qualifying_MRTOne" Content="MRT One" FontSize="10" IsChecked="True"
                                      Tag="Qualifying:MRTOne" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Qualifying_TurnDisplay" Content="Turn" FontSize="10" IsChecked="True"
                                      Tag="Qualifying:TurnDisplay" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Qualifying_FuelCalculator" Content="Fuel" FontSize="10" IsChecked="False"
                                      Tag="Qualifying:FuelCalculator" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Qualifying_Relative" Content="Relative" FontSize="10" IsChecked="False"
                                      Tag="Qualifying:Relative" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Qualifying_ProximityFeed" Content="Prox Feed" FontSize="10" IsChecked="False"
                                      Tag="Qualifying:ProximityFeed" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Qualifying_Standings" Content="Standings" FontSize="10" IsChecked="False"
                                      Tag="Qualifying:Standings" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                        </WrapPanel>
                    </StackPanel>
                    
                    <!-- Race -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Race" FontSize="11" Foreground="#4CAF50" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <WrapPanel Margin="4,0,0,0">
                            <CheckBox x:Name="ChkSession_Race_MRTOne" Content="MRT One" FontSize="10" IsChecked="True"
                                      Tag="Race:MRTOne" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Race_TurnDisplay" Content="Turn" FontSize="10" IsChecked="True"
                                      Tag="Race:TurnDisplay" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Race_FuelCalculator" Content="Fuel" FontSize="10" IsChecked="True"
                                      Tag="Race:FuelCalculator" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Race_Relative" Content="Relative" FontSize="10" IsChecked="True"
                                      Tag="Race:Relative" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Race_ProximityFeed" Content="Prox Feed" FontSize="10" IsChecked="True"
                                      Tag="Race:ProximityFeed" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Race_Standings" Content="Standings" FontSize="10" IsChecked="True"
                                      Tag="Race:Standings" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                        </WrapPanel>
                    </StackPanel>
                    
                    <!-- Warmup -->
                    <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="Warmup" FontSize="11" Foreground="#FF9800" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <WrapPanel Margin="4,0,0,0">
                            <CheckBox x:Name="ChkSession_Warmup_MRTOne" Content="MRT One" FontSize="10" IsChecked="True"
                                      Tag="Warmup:MRTOne" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Warmup_TurnDisplay" Content="Turn" FontSize="10" IsChecked="False"
                                      Tag="Warmup:TurnDisplay" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Warmup_FuelCalculator" Content="Fuel" FontSize="10" IsChecked="False"
                                      Tag="Warmup:FuelCalculator" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Warmup_Relative" Content="Relative" FontSize="10" IsChecked="True"
                                      Tag="Warmup:Relative" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Warmup_ProximityFeed" Content="Prox Feed" FontSize="10" IsChecked="False"
                                      Tag="Warmup:ProximityFeed" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                            <CheckBox x:Name="ChkSession_Warmup_Standings" Content="Standings" FontSize="10" IsChecked="False"
                                      Tag="Warmup:Standings" Foreground="{StaticResource LightText}" Margin="0,0,12,4"
                                      Checked="SessionPresetToggle_Changed" Unchecked="SessionPresetToggle_Changed"/>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- ═══════════════════════════════════ -->
            <!-- PROFILES SECTION                    -->
            <!-- ═══════════════════════════════════ -->
            <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="CONFIGURATION PROFILES" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,6"/>
                    <TextBlock Text="Named profiles capture visibility AND per-widget data settings. Bind to session type and/or car class for automatic switching."
                               FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    
                    <!-- Auto-switch -->
                    <CheckBox x:Name="ChkProfileAutoSwitch" Content="Auto-switch profiles"
                              Style="{StaticResource MRT.ToggleButton}"
                              IsChecked="False" Margin="0,0,0,6"
                              Checked="ChkProfileAutoSwitch_Changed" Unchecked="ChkProfileAutoSwitch_Changed"/>
                    
                    <!-- Active profile indicator -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Active: " FontSize="11" Foreground="{StaticResource MutedText}"/>
                        <TextBlock x:Name="TxtActiveProfile" Text="(none)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TealPrimary}"/>
                    </StackPanel>
                    
                    <!-- Profile list -->
                    <StackPanel x:Name="ProfileListPanel" Margin="0,0,0,8"/>
                    
                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="BtnCreateProfile" Content="+ New"
                                Style="{StaticResource MRT.Button.Secondary}"
                                Width="60" Height="24" FontSize="10" Margin="0,0,4,0"
                                Click="BtnCreateProfile_Click"/>
                        <Button x:Name="BtnCaptureProfile" Content="⬇ Capture"
                                Style="{StaticResource MRT.Button.Secondary}"
                                Width="70" Height="24" FontSize="10" Margin="0,0,4,0"
                                ToolTip="Save current widget state into active profile"
                                Click="BtnCaptureProfile_Click"/>
                        <Button x:Name="BtnDeleteProfile" Content="✕ Delete"
                                Style="{StaticResource MRT.Button.Secondary}"
                                Width="60" Height="24" FontSize="10"
                                Click="BtnDeleteProfile_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
