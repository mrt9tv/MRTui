<UserControl x:Class="iRacingOverlay.WPF.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
        <StackPanel MaxWidth="500">
            
            <!-- GLOBAL FONT SCALE -->
            <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="GLOBAL FONT SCALE" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,6"/>
                    <TextBlock Text="Multiplier applied to all overlay widget font sizes."
                               FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderGlobalFontScale"
                                Style="{StaticResource MRT.Slider}"
                                Minimum="70" Maximum="150" Value="100"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="GlobalFontScale_ValueChanged"/>
                        <TextBlock x:Name="TxtGlobalFontScale" Grid.Column="1"
                                   Text="100%" FontSize="11"
                                   Foreground="{StaticResource TealPrimary}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- WINDOW BEHAVIOR -->
            <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="WINDOW BEHAVIOR" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <CheckBox x:Name="ChkAlwaysOnTop" Content="Always On Top"
                                  Style="{StaticResource MRT.ToggleButton}"
                                  Margin="0,0,10,6"
                                  Checked="WindowBehavior_Changed" Unchecked="WindowBehavior_Changed"/>
                        <CheckBox x:Name="ChkStartMinimized" Content="Start Minimized"
                                  Style="{StaticResource MRT.ToggleButton}"
                                  Margin="0,0,10,6"
                                  Checked="WindowBehavior_Changed" Unchecked="WindowBehavior_Changed"/>
                        <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to Tray"
                                  Style="{StaticResource MRT.ToggleButton}"
                                  Margin="0,0,10,6"
                                  Checked="WindowBehavior_Changed" Unchecked="WindowBehavior_Changed"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            
            <!-- HOTKEYS -->
            <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="HOTKEYS" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,6"/>
                    <TextBlock Text="Global hotkeys work even when iRacing has focus."
                               FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Lock Widgets:" FontSize="11"
                                   Foreground="{StaticResource LightText}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHotkeyLock" Grid.Column="1" Text="Ctrl+L"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TealPrimary}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Show/Hide:" FontSize="11"
                                   Foreground="{StaticResource LightText}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHotkeyVisibility" Grid.Column="1" Text="Ctrl+H"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TealPrimary}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- UNITS -->
            <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="UNITS" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkMetricUnits" Content="Use Metric (km/h, °C)"
                              Style="{StaticResource MRT.ToggleButton}"
                              IsChecked="True" Margin="0,0,10,4"
                              Checked="Units_Changed" Unchecked="Units_Changed"/>
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
