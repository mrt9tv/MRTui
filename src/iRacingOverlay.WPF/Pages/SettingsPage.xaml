<UserControl x:Class="iRacingOverlay.WPF.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <!--
        SETTINGS

        Section list on the left, content on the right — the same shape as the
        Overlay page, so the app has one navigation idiom rather than two.

        Everything here is generated from declarations except the hotkey capture,
        which needs bespoke interaction. That means the Settings page no longer
        drifts from the settings model: it previously surfaced 8 of 33 persisted
        settings, with the rest reachable only from a widget's right-click menu.
    -->

    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ SECTIONS ═══════════════ -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="SETTINGS"
                       Style="{StaticResource T.Label}" Margin="2,0,0,10"/>

            <StackPanel x:Name="SectionList" VerticalAlignment="Top"/>
        </DockPanel>

        <!-- ═══════════════ CONTENT ═══════════════ -->
        <DockPanel Grid.Column="2">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSectionTitle" Text="General"
                               Style="{StaticResource T.Display}"/>
                    <TextBlock x:Name="TxtSectionDesc" Style="{StaticResource T.Caption}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <TextBox x:Name="TxtSearch" Grid.Column="1" Width="200" Height="32"
                         VerticalAlignment="Center"
                         TextChanged="Search_TextChanged"
                         ToolTip="Search across every setting"/>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <StackPanel>
                    <!-- Generated settings for the selected section -->
                    <StackPanel x:Name="SettingsHost"/>

                    <!-- Hotkeys need press-to-capture, so they stay hand-built -->
                    <Border x:Name="HotkeyCard" Style="{StaticResource Card}"
                            Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="HOTKEYS" Style="{StaticResource T.Label}" Margin="0,0,0,4"/>
                            <TextBlock Text="Work even while iRacing has focus."
                                       Style="{StaticResource T.Caption}" Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Lock widgets" Style="{StaticResource T.Body}"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="{StaticResource SurfaceRaised}"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        CornerRadius="{StaticResource CR.Control}"
                                        Padding="10,5" Margin="0,0,8,0" MinWidth="86">
                                    <TextBlock x:Name="TxtHotkeyLock" Text="Ctrl+L"
                                               Style="{StaticResource T.Data}" TextAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="2" Content="Change"
                                        Style="{StaticResource Btn.Secondary}"
                                        Click="BtnRebindLock_Click" MinWidth="80"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Show / hide widgets" Style="{StaticResource T.Body}"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="{StaticResource SurfaceRaised}"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        CornerRadius="{StaticResource CR.Control}"
                                        Padding="10,5" Margin="0,0,8,0" MinWidth="86">
                                    <TextBlock x:Name="TxtHotkeyVisibility" Text="Ctrl+H"
                                               Style="{StaticResource T.Data}" TextAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="2" Content="Change"
                                        Style="{StaticResource Btn.Secondary}"
                                        Click="BtnRebindVisibility_Click" MinWidth="80"/>
                            </Grid>

                            <TextBlock x:Name="TxtHotkeyStatus" Style="{StaticResource T.Caption}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
