<UserControl x:Class="iRacingOverlay.WPF.Pages.WidgetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Widget selector strip -->
            <ColumnDefinition Width="140"/>
            <!-- Left settings column -->
            <ColumnDefinition Width="*"/>
            <!-- Spacer -->
            <ColumnDefinition Width="10"/>
            <!-- Right settings column -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- ═══════════════════════════════════════ -->
        <!-- WIDGET SELECTOR STRIP                   -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource DarkSurface}"
                BorderBrush="{StaticResource DarkBorder}" BorderThickness="0,0,1,0"
                Padding="6,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="WIDGETS" Style="{StaticResource MRT.Text.Label}" Margin="4,0,0,6"/>
                    
                    <StackPanel x:Name="WidgetMenuButtons" Margin="0,0,0,8">
                        <Button x:Name="BtnWidgetMRTOne" Content="MRT One"
                                Style="{StaticResource MRT.Button.Secondary}"
                                Height="28" FontSize="11" Margin="0,0,0,2"
                                HorizontalContentAlignment="Left" Padding="8,2"
                                Click="WidgetMenuButton_Click"/>
                        <Button x:Name="BtnWidgetTurnDisplay" Content="Turn Display"
                                Style="{StaticResource MRT.Button.Secondary}"
                                Height="28" FontSize="11" Margin="0,0,0,2"
                                HorizontalContentAlignment="Left" Padding="8,2"
                                Click="WidgetMenuButton_Click"/>
                        <Button x:Name="BtnWidgetFuel" Content="Fuel Calculator"
                                Style="{StaticResource MRT.Button.Secondary}"
                                Height="28" FontSize="11" Margin="0,0,0,2"
                                HorizontalContentAlignment="Left" Padding="8,2"
                                Click="WidgetMenuButton_Click"/>
                        <Button x:Name="BtnWidgetRelative" Content="Relative"
                                Style="{StaticResource MRT.Button.Secondary}"
                                Height="28" FontSize="11" Margin="0,0,0,2"
                                HorizontalContentAlignment="Left" Padding="8,2"
                                Click="WidgetMenuButton_Click"/>
                        <Button x:Name="BtnWidgetProximityFeed" Content="Prox Feed"
                                Style="{StaticResource MRT.Button.Secondary}"
                                Height="28" FontSize="11" Margin="0,0,0,2"
                                HorizontalContentAlignment="Left" Padding="8,2"
                                Click="WidgetMenuButton_Click"/>
                        <Button x:Name="BtnWidgetStandings" Content="Standings"
                                Style="{StaticResource MRT.Button.Secondary}"
                                Height="28" FontSize="11" Margin="0,0,0,2"
                                HorizontalContentAlignment="Left" Padding="8,2"
                                Click="WidgetMenuButton_Click"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                        <Button x:Name="BtnToggleWidget"
                                Content="Show"
                                Style="{StaticResource MRT.Button.Secondary}"
                                Click="BtnToggleWidget_Click"
                                Width="56" Height="26" Margin="0,0,4,0"
                                FontSize="11" Padding="3,2"/>
                        <Button x:Name="BtnLockWidgets"
                                Content="Lock"
                                Style="{StaticResource MRT.Button.Secondary}"
                                Click="BtnLockWidgets_Click"
                                Width="56" Height="26"
                                FontSize="11" Padding="3,2"/>
                    </StackPanel>
                    
                    <TextBlock x:Name="WidgetStatusText"
                               Text="Select a widget."
                               FontSize="10"
                               Foreground="{StaticResource MutedText}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        
        <!-- ═══════════════════════════════════════ -->
        <!-- LEFT COLUMN: Core widget settings       -->
        <!-- ═══════════════════════════════════════ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="8,8">
            <StackPanel>
                
                <!-- ═══════ MRT ONE: SIZE + FIELDS ═══════ -->
                <StackPanel x:Name="MRTOnePanel" Visibility="Collapsed">
                    <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SIZE" Style="{StaticResource MRT.Text.Label}" VerticalAlignment="Center"/>
                                <Slider x:Name="SliderWidgetSize" Grid.Column="1"
                                        Style="{StaticResource MRT.Slider}"
                                        Minimum="120" Maximum="600" Value="240"
                                        TickFrequency="10" IsSnapToTickEnabled="True"
                                        ValueChanged="SliderWidgetSize_ValueChanged"/>
                                <TextBlock x:Name="TxtSizeValue" Grid.Column="2"
                                           Text="240px" FontSize="11"
                                           Foreground="{StaticResource TealPrimary}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Center H" Style="{StaticResource MRT.Button.Secondary}"
                                        Click="BtnCenterH_Click" Width="72" Height="26" Margin="0,0,4,0" FontSize="10" Padding="3,2"/>
                                <Button Content="Center V" Style="{StaticResource MRT.Button.Secondary}"
                                        Click="BtnCenterV_Click" Width="72" Height="26" Margin="0,0,4,0" FontSize="10" Padding="3,2"/>
                                <Button Content="Both" Style="{StaticResource MRT.Button.Secondary}"
                                        Click="BtnCenterBoth_Click" Width="52" Height="26" FontSize="10" Padding="3,2"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="DATA FIELDS" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,6"/>
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="Top" Foreground="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,2"/>
                                <ComboBox x:Name="CboTopField" Height="26" FontSize="12"
                                          SelectionChanged="FieldCombo_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="Center" Foreground="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,2"/>
                                <ComboBox x:Name="CboCenterField" Height="26" FontSize="12"
                                          SelectionChanged="FieldCombo_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="Bottom" Foreground="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,2"/>
                                <ComboBox x:Name="CboBottomField" Height="26" FontSize="12"
                                          SelectionChanged="FieldCombo_SelectionChanged"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,0,2">
                                    <TextBlock Text="Left" Foreground="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="CboLeftField" Height="26" FontSize="12"
                                              SelectionChanged="FieldCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,2">
                                    <TextBlock Text="Right" Foreground="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="CboRightField" Height="26" FontSize="12"
                                              SelectionChanged="FieldCombo_SelectionChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════ TURN DISPLAY CONTROLS ═══════ -->
                <StackPanel x:Name="TurnDisplayPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="TURN DISPLAY" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,4"/>
                            <TextBlock Text="Shows next and last turn on track"
                                       FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <CheckBox x:Name="ChkShowTurnNames" Content="Show Turn Names"
                                          Style="{StaticResource MRT.ToggleButton}" IsChecked="True" Margin="0,0,10,4"
                                          Checked="TurnDisplayToggle_Changed" Unchecked="TurnDisplayToggle_Changed"/>
                                <CheckBox x:Name="ChkAnimateBorder" Content="Animate Border"
                                          Style="{StaticResource MRT.ToggleButton}" IsChecked="False" Margin="0,0,10,4"
                                          Checked="TurnDisplayToggle_Changed" Unchecked="TurnDisplayToggle_Changed"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="OPACITY" Style="{StaticResource MRT.Text.Label}"/>
                                <TextBlock x:Name="TxtTurnOpacity" Grid.Column="1" Text="100%" FontSize="11"
                                           Foreground="{StaticResource TealPrimary}"/>
                            </Grid>
                            <Slider x:Name="SliderTurnOpacity" Style="{StaticResource MRT.Slider}"
                                    Minimum="30" Maximum="100" Value="100"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="TurnOpacity_ValueChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════ FUEL CALCULATOR CONTROLS ═══════ -->
                <StackPanel x:Name="FuelCalculatorPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="FUEL CALCULATOR" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,4"/>
                            <TextBlock Text="Shows fuel saving, lift &amp; coast, and pit vs save strategy."
                                       FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <TextBlock Text="Laps remaining accounts for 0.3L splutter buffer."
                                       FontSize="10" Foreground="{StaticResource OrangePrimary}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <CheckBox x:Name="ChkFuelL3" Content="L3 Avg" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="True" Margin="0,0,8,4"
                                          Checked="FuelCalculatorToggle_Changed" Unchecked="FuelCalculatorToggle_Changed"/>
                                <CheckBox x:Name="ChkFuelL5" Content="L5 Avg" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="True" Margin="0,0,8,4"
                                          Checked="FuelCalculatorToggle_Changed" Unchecked="FuelCalculatorToggle_Changed"/>
                                <CheckBox x:Name="ChkFuelSaving" Content="Saving Section" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="True" Margin="0,0,8,4"
                                          ToolTip="Show projected delta, save target, and pit strategy rows"
                                          Checked="FuelCalculatorToggle_Changed" Unchecked="FuelCalculatorToggle_Changed"/>
                                <CheckBox x:Name="ChkFuelPitLap" Content="Pit Lap" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4" ToolTip="Show predicted pit lap number"
                                          Checked="FuelCalculatorToggle_Changed" Unchecked="FuelCalculatorToggle_Changed"/>
                                <CheckBox x:Name="ChkFuelFillAmount" Content="Fill Amount" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4" ToolTip="Show fuel needed to add at pit stop"
                                          Checked="FuelCalculatorToggle_Changed" Unchecked="FuelCalculatorToggle_Changed"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════ RELATIVE CONTROLS ═══════ -->
                <StackPanel x:Name="RelativePanel" Visibility="Collapsed">
                    <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="RELATIVE" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,4"/>
                            <TextBlock Text="Proximity-based relative table showing cars ahead and behind."
                                       FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="AHEAD" Style="{StaticResource MRT.Text.Label}" VerticalAlignment="Center"/>
                                <Slider x:Name="SliderMaxAhead" Grid.Column="1" Style="{StaticResource MRT.Slider}"
                                        Minimum="1" Maximum="10" Value="3" TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="RelativeSlider_ValueChanged"/>
                                <TextBlock x:Name="TxtMaxAhead" Grid.Column="2" Text="3" FontSize="11"
                                           Foreground="{StaticResource TealPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="BEHIND" Style="{StaticResource MRT.Text.Label}" VerticalAlignment="Center"/>
                                <Slider x:Name="SliderMaxBehind" Grid.Column="1" Style="{StaticResource MRT.Slider}"
                                        Minimum="1" Maximum="10" Value="3" TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="RelativeSlider_ValueChanged"/>
                                <TextBlock x:Name="TxtMaxBehind" Grid.Column="2" Text="3" FontSize="11"
                                           Foreground="{StaticResource TealPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                            <WrapPanel>
                                <CheckBox x:Name="ChkSmartRowCount" Content="Smart Rows" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="True" Margin="0,0,8,4" ToolTip="Auto-adjust visible rows for P1 (all behind)"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                                <CheckBox x:Name="ChkShowClassPosition" Content="Class Pos" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════ PROXIMITY FEED CONTROLS ═══════ -->
                <StackPanel x:Name="ProximityFeedPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="PROXIMITY FEED" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,4"/>
                            <TextBlock Text="Animated event feed for nearby race incidents within ±15 seconds."
                                       FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBlock Text="Events: off-track, collision, slow/stopped, pitting, flags, local yellow"
                                       FontSize="10" Foreground="{StaticResource OrangePrimary}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <!-- Feed display toggles -->
                            <TextBlock Text="DISPLAY" FontSize="9" Foreground="{StaticResource TealPrimary}" Margin="0,4,0,4"/>
                            <WrapPanel>
                                <CheckBox x:Name="ChkProxDirection" Content="Direction ▲▼" FontSize="10" IsChecked="True"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="ProximityFeedToggle_Changed" Unchecked="ProximityFeedToggle_Changed"/>
                                <CheckBox x:Name="ChkProxInterval" Content="Interval" FontSize="10" IsChecked="True"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="ProximityFeedToggle_Changed" Unchecked="ProximityFeedToggle_Changed"/>
                                <CheckBox x:Name="ChkProxGrowUp" Content="Grow Upward" FontSize="10" IsChecked="False"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="ProximityFeedToggle_Changed" Unchecked="ProximityFeedToggle_Changed"/>
                                <CheckBox x:Name="ChkProxOvertaking" Content="Overtaking Alert" FontSize="10" IsChecked="True"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="ProximityFeedToggle_Changed" Unchecked="ProximityFeedToggle_Changed"/>
                            </WrapPanel>

                            <!-- Session event toggles -->
                            <TextBlock Text="SESSION EVENTS" FontSize="9" Foreground="{StaticResource TealPrimary}" Margin="0,6,0,4"/>
                            <WrapPanel>
                                <CheckBox x:Name="ChkProxStartSequence" Content="Start (Go!)" FontSize="10" IsChecked="True"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="ProximityFeedToggle_Changed" Unchecked="ProximityFeedToggle_Changed"/>
                                <CheckBox x:Name="ChkProxCheckered" Content="Checkered" FontSize="10" IsChecked="True"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="ProximityFeedToggle_Changed" Unchecked="ProximityFeedToggle_Changed"/>
                                <CheckBox x:Name="ChkProxPaceFlags" Content="Pace / SC Flags" FontSize="10" IsChecked="True"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="ProximityFeedToggle_Changed" Unchecked="ProximityFeedToggle_Changed"/>
                            </WrapPanel>

                            <!-- Position / drag toggle -->
                            <TextBlock Text="POSITION" FontSize="9" Foreground="{StaticResource TealPrimary}" Margin="0,8,0,4"/>
                            <CheckBox x:Name="ChkProxDragMode" Content="Enable drag to reposition" FontSize="10" IsChecked="False"
                                      Foreground="{StaticResource LightText}" Margin="0,0,0,4"
                                      Checked="ProximityFeedDragToggle_Changed" Unchecked="ProximityFeedDragToggle_Changed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- ═══════ STANDINGS ═══════ -->
                <StackPanel x:Name="StandingsPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="STANDINGS" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,4"/>
                            <TextBlock Text="Full-field leaderboard sorted by race position."
                                       FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            
                            <!-- Visible Rows -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Max Rows: " FontSize="10" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                <Slider x:Name="SliderStandingsRows" Minimum="5" Maximum="40" Value="20"
                                        Width="100" VerticalAlignment="Center" Margin="4,0,4,0"
                                        ValueChanged="StandingsControl_Changed"/>
                                <TextBlock x:Name="TxtStandingsRows" Text="20" FontSize="10"
                                           Foreground="{StaticResource LightText}" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Column Toggles -->
                            <TextBlock Text="COLUMNS" FontSize="9" Foreground="{StaticResource TealPrimary}" Margin="0,4,0,4"/>
                            <WrapPanel>
                                <CheckBox x:Name="ChkStdCarNumber" Content="Car #" FontSize="10" IsChecked="True"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="StandingsToggle_Changed" Unchecked="StandingsToggle_Changed"/>
                                <CheckBox x:Name="ChkStdInterval" Content="Interval" FontSize="10" IsChecked="True"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="StandingsToggle_Changed" Unchecked="StandingsToggle_Changed"/>
                                <CheckBox x:Name="ChkStdGapLeader" Content="Gap" FontSize="10" IsChecked="True"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="StandingsToggle_Changed" Unchecked="StandingsToggle_Changed"/>
                                <CheckBox x:Name="ChkStdLastLap" Content="Last Lap" FontSize="10" IsChecked="False"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="StandingsToggle_Changed" Unchecked="StandingsToggle_Changed"/>
                                <CheckBox x:Name="ChkStdBestLap" Content="Best Lap" FontSize="10" IsChecked="False"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="StandingsToggle_Changed" Unchecked="StandingsToggle_Changed"/>
                                <CheckBox x:Name="ChkStdCurrentLap" Content="Lap #" FontSize="10" IsChecked="False"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="StandingsToggle_Changed" Unchecked="StandingsToggle_Changed"/>
                                <CheckBox x:Name="ChkStdPitCount" Content="Pits" FontSize="10" IsChecked="False"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="StandingsToggle_Changed" Unchecked="StandingsToggle_Changed"/>
                                <CheckBox x:Name="ChkStdIRating" Content="iRating" FontSize="10" IsChecked="False"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="StandingsToggle_Changed" Unchecked="StandingsToggle_Changed"/>
                                <CheckBox x:Name="ChkStdLicense" Content="License" FontSize="10" IsChecked="False"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="StandingsToggle_Changed" Unchecked="StandingsToggle_Changed"/>
                                <CheckBox x:Name="ChkStdCarModel" Content="Car" FontSize="10" IsChecked="False"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="StandingsToggle_Changed" Unchecked="StandingsToggle_Changed"/>
                                <CheckBox x:Name="ChkStdPosDelta" Content="Pos Δ" FontSize="10" IsChecked="False"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="StandingsToggle_Changed" Unchecked="StandingsToggle_Changed"/>
                                <CheckBox x:Name="ChkStdNationality" Content="Nation" FontSize="10" IsChecked="False"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="StandingsToggle_Changed" Unchecked="StandingsToggle_Changed"/>
                                <CheckBox x:Name="ChkStdClassPos" Content="Class Pos" FontSize="10" IsChecked="False"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="StandingsToggle_Changed" Unchecked="StandingsToggle_Changed"/>
                            </WrapPanel>
                            
                            <!-- Appearance -->
                            <TextBlock Text="APPEARANCE" FontSize="9" Foreground="{StaticResource TealPrimary}" Margin="0,6,0,4"/>
                            <WrapPanel>
                                <CheckBox x:Name="ChkStdAltRows" Content="Alt Rows" FontSize="10" IsChecked="True"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="StandingsToggle_Changed" Unchecked="StandingsToggle_Changed"/>
                                <CheckBox x:Name="ChkStdHighlight" Content="Highlight Me" FontSize="10" IsChecked="True"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="StandingsToggle_Changed" Unchecked="StandingsToggle_Changed"/>
                                <CheckBox x:Name="ChkStdDimLapped" Content="Dim Lapped" FontSize="10" IsChecked="False"
                                          Foreground="{StaticResource LightText}" Margin="0,0,10,4"
                                          Checked="StandingsToggle_Changed" Unchecked="StandingsToggle_Changed"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════ -->
        <!-- RIGHT COLUMN: Extended settings         -->
        <!-- ═══════════════════════════════════════ -->
        <ScrollViewer Grid.Column="3" VerticalScrollBarVisibility="Auto" Padding="8,8">
            <StackPanel>
                
                <!-- ═══════ MRT ONE: VISUALS + OPACITY ═══════ -->
                <StackPanel x:Name="MRTOneRightPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="VISUALS" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,4"/>
                            <WrapPanel>
                                <CheckBox x:Name="ChkGradientBg" Content="Gradient BG" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="True" Margin="0,0,8,4" Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed"/>
                                <CheckBox x:Name="ChkShiftRing" Content="Shift Ring" Style="{StaticResource MRT.ToggleButton}"
                                          Margin="0,0,8,4" Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed"/>
                                <CheckBox x:Name="ChkGlow" Content="Glow" Style="{StaticResource MRT.ToggleButton}"
                                          Margin="0,0,8,4" Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed"/>
                                <CheckBox x:Name="ChkPitLimiter" Content="Pit Limiter" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="True" Margin="0,0,8,4" Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed"/>
                                <CheckBox x:Name="ChkEnhancedRadar" Content="Radar+" Style="{StaticResource MRT.ToggleButton}"
                                          Margin="0,0,8,4" Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed"/>
                                <CheckBox x:Name="ChkAutoSwap" Content="Auto-Swap" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4"
                                          ToolTip="Priority-based center field override (PIT NOW, yellow, car alongside)"
                                          Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="OPACITY" Style="{StaticResource MRT.Text.Label}"/>
                                <TextBlock x:Name="TxtMRTOneOpacity" Grid.Column="1" Text="100%" FontSize="11"
                                           Foreground="{StaticResource TealPrimary}"/>
                            </Grid>
                            <Slider x:Name="SliderMRTOneOpacity" Style="{StaticResource MRT.Slider}"
                                    Minimum="30" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="MRTOneOpacity_ValueChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════ FUEL: ALERTS + OPACITY ═══════ -->
                <StackPanel x:Name="FuelCalcRightPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource MRT.Card}" Margin="0,6,0,6" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="FUEL ALERTS" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,4"/>
                            <TextBlock Text="Thresholds (doable laps)" FontSize="10"
                                       Foreground="{StaticResource MutedText}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            
                            <!-- Yellow -->
                            <StackPanel Margin="0,0,0,6">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkFuelYellow" IsChecked="True" Foreground="#FFFF00" FontSize="10"
                                              VerticalAlignment="Center" Margin="0,0,4,0"
                                              Checked="FuelAlertToggle_Changed" Unchecked="FuelAlertToggle_Changed"/>
                                    <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center">
                                        <Run Text="Yellow" Foreground="#FFFF00"/><Run Text=" (caution)" Foreground="{StaticResource MutedText}"/>
                                    </TextBlock>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SliderFuelYellow" Style="{StaticResource MRT.Slider}"
                                            Minimum="1" Maximum="15" Value="4" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            ValueChanged="FuelAlert_ValueChanged"/>
                                    <TextBlock x:Name="TxtFuelYellow" Grid.Column="1" Text="4.0" FontSize="11"
                                               Foreground="#FFFF00" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- Red -->
                            <StackPanel Margin="0,0,0,6">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkFuelRed" IsChecked="True" Foreground="#FF3333" FontSize="10"
                                              VerticalAlignment="Center" Margin="0,0,4,0"
                                              Checked="FuelAlertToggle_Changed" Unchecked="FuelAlertToggle_Changed"/>
                                    <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center">
                                        <Run Text="Red" Foreground="#FF3333"/><Run Text=" (urgent)" Foreground="{StaticResource MutedText}"/>
                                    </TextBlock>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SliderFuelRed" Style="{StaticResource MRT.Slider}"
                                            Minimum="0.5" Maximum="10" Value="2.5" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            ValueChanged="FuelAlert_ValueChanged"/>
                                    <TextBlock x:Name="TxtFuelRed" Grid.Column="1" Text="2.5" FontSize="11"
                                               Foreground="#FF3333" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- Critical -->
                            <StackPanel Margin="0,0,0,6">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkFuelCritical" IsChecked="True" Foreground="#FF0000" FontSize="10"
                                              VerticalAlignment="Center" Margin="0,0,4,0"
                                              Checked="FuelAlertToggle_Changed" Unchecked="FuelAlertToggle_Changed"/>
                                    <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center">
                                        <Run Text="Critical" Foreground="#FF0000"/><Run Text=" (blink)" Foreground="{StaticResource MutedText}"/>
                                    </TextBlock>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SliderFuelCritical" Style="{StaticResource MRT.Slider}"
                                            Minimum="0" Maximum="5" Value="1.5" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            ValueChanged="FuelAlert_ValueChanged"/>
                                    <TextBlock x:Name="TxtFuelCritical" Grid.Column="1" Text="1.5" FontSize="11"
                                               Foreground="#FF0000" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- Sputter -->
                            <StackPanel Margin="0,0,0,2">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkFuelSputter" IsChecked="True"
                                              Foreground="{StaticResource OrangePrimary}" FontSize="10"
                                              VerticalAlignment="Center" Margin="0,0,4,0"
                                              Checked="FuelAlertToggle_Changed" Unchecked="FuelAlertToggle_Changed"/>
                                    <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center">
                                        <Run Text="Sputter" Foreground="{StaticResource OrangePrimary}"/>
                                        <Run Text=" (L) &#x2139;" Foreground="{StaticResource MutedText}"/>
                                    </TextBlock>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SliderFuelSputter" Style="{StaticResource MRT.Slider}"
                                            Minimum="0" Maximum="2" Value="0.4" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            ValueChanged="FuelAlert_ValueChanged"/>
                                    <TextBlock x:Name="TxtFuelSputter" Grid.Column="1" Text="0.4L" FontSize="11"
                                               Foreground="{StaticResource OrangePrimary}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="OPACITY" Style="{StaticResource MRT.Text.Label}"/>
                                <TextBlock x:Name="TxtFuelOpacity" Grid.Column="1" Text="100%" FontSize="11"
                                           Foreground="{StaticResource TealPrimary}"/>
                            </Grid>
                            <Slider x:Name="SliderFuelOpacity" Style="{StaticResource MRT.Slider}"
                                    Minimum="30" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="FuelOpacity_ValueChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════ RELATIVE: EXTRA COLUMNS ═══════ -->
                <StackPanel x:Name="RelativeRightPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="RELATIVE – EXTRA COLUMNS" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,4"/>
                            <TextBlock Text="Toggle additional data columns on the overlay"
                                       FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <CheckBox x:Name="ChkShowDriverInfo" Content="Driver Info" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4" ToolTip="Show license badge + iRating"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                                <CheckBox x:Name="ChkUseFullIRating" Content="Full iR" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4" ToolTip="Show full iRating (2035) instead of compact (2.0k)"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                                <CheckBox x:Name="ChkShowCarNumber" Content="Car #" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="True" Margin="0,0,8,4"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                                <CheckBox x:Name="ChkShowCarModel" Content="Car Model" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4" ToolTip="Show 3-letter car abbreviation"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                                <CheckBox x:Name="ChkShowInterval" Content="Gap" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4" ToolTip="Show gap to car directly ahead in race position"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                                <CheckBox x:Name="ChkShowLastLap" Content="Last Lap" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                                <CheckBox x:Name="ChkShowAltRowShading" Content="Alt Rows" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4" ToolTip="Alternate row shading for readability"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                                <CheckBox x:Name="ChkShowInfoBar" Content="Info Bar" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4" ToolTip="Show est laps, time remaining, incidents at bottom"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                                <CheckBox x:Name="ChkShowClosingRate" Content="Closing ▲▼" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4" ToolTip="Show closing rate arrow"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                                <CheckBox x:Name="ChkShowPitStopCount" Content="Pit Stops" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4" ToolTip="Show pit stop count per driver"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                                <CheckBox x:Name="ChkShowPositionChange" Content="Pos Δ" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4" ToolTip="Show position change arrows"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                                <CheckBox x:Name="ChkShowSectorDelta" Content="Gap Color" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4" ToolTip="Color REL column green/red"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                                <CheckBox x:Name="ChkShowNationality" Content="Nationality" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4" ToolTip="Show 2-letter country code"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                                <CheckBox x:Name="ChkShowClassLegend" Content="Class Legend" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4" ToolTip="Show class color legend"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                                <CheckBox x:Name="ChkShowLappedDim" Content="Dim Lapped" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4" ToolTip="Dim cars 1+ laps behind/ahead"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                                <CheckBox x:Name="ChkShowDangerGlow" Content="Danger Glow" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4" ToolTip="Red tint on high closing rate"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                                <CheckBox x:Name="ChkEnableRowAnimation" Content="Animate" Style="{StaticResource MRT.ToggleButton}"
                                          IsChecked="False" Margin="0,0,8,4" ToolTip="Smooth row slide animation"
                                          Checked="RelativeToggle_Changed" Unchecked="RelativeToggle_Changed"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    
                    <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="NAME FORMAT" Style="{StaticResource MRT.Text.Label}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CboNameFormat" Width="160" HorizontalAlignment="Left"
                                      SelectionChanged="CboNameFormat_SelectionChanged">
                                <ComboBoxItem Content="J.Smith" Tag="0" IsSelected="True"/>
                                <ComboBoxItem Content="Full Name" Tag="1"/>
                                <ComboBoxItem Content="Initials (J.S.)" Tag="2"/>
                                <ComboBoxItem Content="First Three (JOE)" Tag="3"/>
                                <ComboBoxItem Content="Last Name" Tag="4"/>
                                <ComboBoxItem Content="First Name" Tag="5"/>
                                <ComboBoxItem Content="3-Letter Code (SMI)" Tag="6"/>
                                <ComboBoxItem Content="Smith, J." Tag="7"/>
                                <ComboBoxItem Content="J.Smit (4-char)" Tag="8"/>
                                <ComboBoxItem Content="Joe S." Tag="9"/>
                                <ComboBoxItem Content="SMITH (caps)" Tag="10"/>
                                <ComboBoxItem Content="J.Smi (3-char)" Tag="11"/>
                                <ComboBoxItem Content="Smith J" Tag="12"/>
                                <ComboBoxItem Content="JSmith (compact)" Tag="13"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    
                    <Border Style="{StaticResource MRT.Card}" Margin="0,0,0,6" Padding="12,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="OPACITY" Style="{StaticResource MRT.Text.Label}"/>
                                <TextBlock x:Name="TxtRelativeOpacity" Grid.Column="1" Text="100%" FontSize="11"
                                           Foreground="{StaticResource TealPrimary}"/>
                            </Grid>
                            <Slider x:Name="SliderRelativeOpacity" Style="{StaticResource MRT.Slider}"
                                    Minimum="30" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="RelativeOpacity_ValueChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
            </StackPanel>
        </ScrollViewer>
        
    </Grid>
</UserControl>
