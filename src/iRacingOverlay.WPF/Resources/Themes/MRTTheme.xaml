<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== MRT COLOR PALETTE ==================== -->
    
    <!-- Primary Racing Colors -->
    <SolidColorBrush x:Key="MRT.Teal" Color="#008080"/>
    <SolidColorBrush x:Key="MRT.Orange" Color="#FF8000"/>
    <SolidColorBrush x:Key="MRT.White" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MRT.Black" Color="#000000"/>
    
    <!-- Background Colors -->
    <SolidColorBrush x:Key="MRT.Background.Dark" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="MRT.Background.Gray" Color="#2F2F2F"/>
    <SolidColorBrush x:Key="MRT.Background.Charcoal" Color="#2F2F2F"/>
    
    <!-- Accent Colors -->
    <SolidColorBrush x:Key="MRT.DeepTeal" Color="#006666"/>
    <SolidColorBrush x:Key="MRT.BrightOrange" Color="#FF9933"/>
    <SolidColorBrush x:Key="MRT.SilverGray" Color="#C0C0C0"/>
    
    <!-- Status Colors -->
    <SolidColorBrush x:Key="MRT.Status.Connected" Color="#00FF00"/>
    <SolidColorBrush x:Key="MRT.Status.Connecting" Color="#FFFF00"/>
    <SolidColorBrush x:Key="MRT.Status.Disconnected" Color="#FF3333"/>
    
    <!-- ==================== SIMPLIFIED ALIASES FOR EASE OF USE ==================== -->
    
    <!-- Background Aliases -->
    <SolidColorBrush x:Key="DarkBackground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="DarkSurface" Color="#2F2F2F"/>
    <SolidColorBrush x:Key="DarkBorder" Color="#3F3F3F"/>
    
    <!-- Primary Color Aliases -->
    <SolidColorBrush x:Key="TealPrimary" Color="#008080"/>
    <SolidColorBrush x:Key="OrangePrimary" Color="#FF8000"/>
    
    <!-- Text Color Aliases -->
    <SolidColorBrush x:Key="LightText" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="MutedText" Color="#888888"/>
    
    <!-- ==================== BUTTON STYLES ==================== -->
    
    <!-- Navigation Button Style -->
    <Style x:Key="MRT.Button.Navigation" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource MRT.Background.Gray}"/>
        <Setter Property="Foreground" Value="{StaticResource MRT.White}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MRT.Teal}"/>
        <Setter Property="BorderThickness" Value="0,0,0,3"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource MRT.DeepTeal}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource MRT.Teal}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- Active Navigation Button Style -->
    <Style x:Key="MRT.Button.Navigation.Active" TargetType="Button" BasedOn="{StaticResource MRT.Button.Navigation}">
        <Setter Property="Background" Value="{StaticResource MRT.Teal}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MRT.Orange}"/>
    </Style>
    
    <!-- Navigation Button Alias for simplified usage -->
    <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource MRT.Button.Navigation}">
        <Style.Triggers>
            <Trigger Property="Tag" Value="Active">
                <Setter Property="Background" Value="{StaticResource MRT.Teal}"/>
                <Setter Property="BorderBrush" Value="{StaticResource MRT.Orange}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!-- Primary Action Button (Orange) -->
    <Style x:Key="MRT.Button.Primary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource MRT.Orange}"/>
        <Setter Property="Foreground" Value="{StaticResource MRT.White}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MRT.BrightOrange}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource MRT.BrightOrange}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#CC6600"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- Secondary Button (Teal outline) -->
    <Style x:Key="MRT.Button.Secondary" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MRT.Teal}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MRT.Teal}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource MRT.Teal}"/>
                            <Setter Property="Foreground" Value="{StaticResource MRT.White}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- ==================== TOGGLE SWITCH STYLE ==================== -->
    
    <Style x:Key="MRT.ToggleButton" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource MRT.White}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <!-- Toggle Switch -->
                        <Border Width="50" Height="26" 
                                Background="{StaticResource MRT.Background.Gray}"
                                BorderBrush="{StaticResource MRT.SilverGray}"
                                BorderThickness="2"
                                CornerRadius="13"
                                Margin="0,0,10,0">
                            <Canvas>
                                <Ellipse x:Name="ThumbEllipse" 
                                         Width="18" Height="18" 
                                         Fill="{StaticResource MRT.SilverGray}"
                                         Canvas.Left="4" Canvas.Top="2"/>
                            </Canvas>
                        </Border>
                        <!-- Content (label) -->
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ThumbEllipse" Property="Canvas.Left" Value="26"/>
                            <Setter TargetName="ThumbEllipse" Property="Fill" Value="{StaticResource MRT.Orange}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- ==================== SLIDER STYLES ==================== -->
    
    <Style x:Key="MRT.Slider" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource MRT.Orange}"/>
        <Setter Property="Background" Value="{StaticResource MRT.Teal}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="TickFrequency" Value="10"/>
        <Setter Property="IsSnapToTickEnabled" Value="False"/>
    </Style>
    
    <!-- ==================== CARD/PANEL STYLES ==================== -->
    
    <Style x:Key="MRT.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MRT.Background.Gray}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MRT.Teal}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="15"/>
        <Setter Property="Margin" Value="10"/>
    </Style>
    
    <Style x:Key="MRT.Card.Header" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MRT.Teal}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    
    <!-- ==================== TEXT STYLES ==================== -->
    
    <Style x:Key="MRT.Text.Header" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MRT.White}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    
    <Style x:Key="MRT.Text.SubHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MRT.Teal}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    
    <Style x:Key="MRT.Text.Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MRT.White}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    
    <Style x:Key="MRT.Text.Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MRT.SilverGray}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    
    <Style x:Key="MRT.Text.Status" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    
    <!-- ==================== RADIO BUTTON STYLE ==================== -->
    
    <Style x:Key="MRT.RadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MRT.White}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

</ResourceDictionary>
