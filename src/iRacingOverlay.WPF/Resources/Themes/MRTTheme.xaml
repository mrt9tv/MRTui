<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        ═══════════════════════════════════════════════════════════════════
        MRT UI THEME

        Brand: teal and orange on white, per team colours.

        The brand teal (#008080) is a mid-dark cyan. It reads well as an
        identity colour on a light ground, but as *text* on a near-black
        surface it sits at roughly 3:1 contrast — legible for large type,
        marginal for the 11px labels this UI is full of. So the brand hue is
        kept for identity (borders, accents, the logo) and a lightened
        sibling carries interactive text. Same hue, enough contrast to read.
        ═══════════════════════════════════════════════════════════════════
    -->

    <!-- ══════════════ PALETTE ══════════════ -->

    <!-- Grounds. Slightly cool rather than neutral grey, so the teal sits in
         the same family as the surfaces instead of floating on top of them. -->
    <Color x:Key="C.Bg">#0E1315</Color>
    <Color x:Key="C.Surface">#161C1F</Color>
    <Color x:Key="C.SurfaceRaised">#1E262A</Color>
    <Color x:Key="C.SurfaceHover">#263035</Color>
    <Color x:Key="C.Border">#283338</Color>
    <Color x:Key="C.BorderStrong">#3A484F</Color>

    <!-- Brand -->
    <Color x:Key="C.Teal">#008080</Color>
    <Color x:Key="C.TealBright">#19C9C9</Color>
    <Color x:Key="C.TealDim">#0A5757</Color>
    <Color x:Key="C.Orange">#FF8000</Color>
    <Color x:Key="C.OrangeBright">#FFA340</Color>
    <Color x:Key="C.OrangeDim">#7A3E00</Color>

    <!-- Text -->
    <Color x:Key="C.TextPrimary">#FFFFFF</Color>
    <Color x:Key="C.TextBody">#DCE6E9</Color>
    <Color x:Key="C.TextMuted">#8FA1A8</Color>
    <Color x:Key="C.TextFaint">#5F7178</Color>

    <!-- Status. Separate from the brand accent so "good/bad" never competes
         with "this is MRT". -->
    <Color x:Key="C.Good">#33C481</Color>
    <Color x:Key="C.Warn">#FFB020</Color>
    <Color x:Key="C.Bad">#FF5A4D</Color>

    <!-- ══════════════ BRUSHES ══════════════ -->

    <SolidColorBrush x:Key="Bg" Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource C.SurfaceRaised}"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource C.SurfaceHover}"/>
    <SolidColorBrush x:Key="Border" Color="{StaticResource C.Border}"/>
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource C.BorderStrong}"/>

    <SolidColorBrush x:Key="Teal" Color="{StaticResource C.Teal}"/>
    <SolidColorBrush x:Key="TealBright" Color="{StaticResource C.TealBright}"/>
    <SolidColorBrush x:Key="TealDim" Color="{StaticResource C.TealDim}"/>
    <SolidColorBrush x:Key="Orange" Color="{StaticResource C.Orange}"/>
    <SolidColorBrush x:Key="OrangeBright" Color="{StaticResource C.OrangeBright}"/>

    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource C.TextPrimary}"/>
    <SolidColorBrush x:Key="TextBody" Color="{StaticResource C.TextBody}"/>
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource C.TextMuted}"/>
    <SolidColorBrush x:Key="TextFaint" Color="{StaticResource C.TextFaint}"/>

    <SolidColorBrush x:Key="Good" Color="{StaticResource C.Good}"/>
    <SolidColorBrush x:Key="Warn" Color="{StaticResource C.Warn}"/>
    <SolidColorBrush x:Key="Bad" Color="{StaticResource C.Bad}"/>

    <!-- Connection status. These now live in one place; they used to be
         hardcoded in two code-behinds and disagreed with the theme. -->
    <SolidColorBrush x:Key="StatusConnected" Color="{StaticResource C.TealBright}"/>
    <SolidColorBrush x:Key="StatusConnecting" Color="{StaticResource C.Warn}"/>
    <SolidColorBrush x:Key="StatusDisconnected" Color="{StaticResource C.TextFaint}"/>

    <!-- ══════════════ LEGACY ALIASES ══════════════ -->
    <!-- Older XAML still references these names. Mapped onto the new palette
         so nothing breaks while the remaining pages are migrated. -->

    <SolidColorBrush x:Key="DarkBackground" Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="DarkSurface" Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="DarkBorder" Color="{StaticResource C.Border}"/>
    <SolidColorBrush x:Key="TealPrimary" Color="{StaticResource C.TealBright}"/>
    <SolidColorBrush x:Key="OrangePrimary" Color="{StaticResource C.Orange}"/>
    <SolidColorBrush x:Key="LightText" Color="{StaticResource C.TextBody}"/>
    <SolidColorBrush x:Key="MutedText" Color="{StaticResource C.TextMuted}"/>
    <SolidColorBrush x:Key="MRT.Teal" Color="{StaticResource C.Teal}"/>
    <SolidColorBrush x:Key="MRT.Orange" Color="{StaticResource C.Orange}"/>
    <SolidColorBrush x:Key="MRT.White" Color="{StaticResource C.TextPrimary}"/>
    <SolidColorBrush x:Key="MRT.Black" Color="#000000"/>
    <SolidColorBrush x:Key="MRT.Background.Dark" Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="MRT.Background.Gray" Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="MRT.Background.Charcoal" Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="MRT.DeepTeal" Color="{StaticResource C.TealDim}"/>
    <SolidColorBrush x:Key="MRT.BrightOrange" Color="{StaticResource C.OrangeBright}"/>
    <SolidColorBrush x:Key="MRT.SilverGray" Color="{StaticResource C.TextMuted}"/>
    <SolidColorBrush x:Key="SilverGray" Color="{StaticResource C.TextMuted}"/>
    <SolidColorBrush x:Key="DeepTeal" Color="{StaticResource C.TealDim}"/>
    <SolidColorBrush x:Key="BrightOrange" Color="{StaticResource C.OrangeBright}"/>
    <SolidColorBrush x:Key="MRT.Status.Connected" Color="{StaticResource C.TealBright}"/>
    <SolidColorBrush x:Key="MRT.Status.Connecting" Color="{StaticResource C.Warn}"/>
    <SolidColorBrush x:Key="MRT.Status.Disconnected" Color="{StaticResource C.TextFaint}"/>

    <!-- ══════════════ METRICS ══════════════ -->
    <!-- One spacing and radius scale, so padding stops being ad-hoc per card. -->

    <sys:Double x:Key="Radius.Control">5</sys:Double>
    <sys:Double x:Key="Radius.Card">8</sys:Double>
    <CornerRadius x:Key="CR.Control">5</CornerRadius>
    <CornerRadius x:Key="CR.Card">8</CornerRadius>
    <CornerRadius x:Key="CR.Pill">999</CornerRadius>

    <Thickness x:Key="Pad.Card">16</Thickness>
    <Thickness x:Key="Pad.Control">12,7</Thickness>

    <!-- ══════════════ TYPOGRAPHY ══════════════ -->
    <!--
        The old UI ran on 9-11px type almost throughout, which is what made it
        feel cramped. Body is now 13, labels 11 with tracking, and headings
        have real weight separation.
    -->

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Display, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="Font.Data">Consolas, Cascadia Mono, Courier New</FontFamily>

    <Style x:Key="T.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="T.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
    </Style>

    <Style x:Key="T.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Section label: uppercase, tracked, muted. The one place letter-spacing
         earns its keep. -->
    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="TextBlock.LineHeight" Value="14"/>
    </Style>

    <!-- Numeric readout: monospace and tabular so digits stop shifting. -->
    <Style x:Key="T.Data" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Data}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TealBright}"/>
    </Style>

    <!-- Legacy text style names -->
    <Style x:Key="MRT.Text.Label" TargetType="TextBlock" BasedOn="{StaticResource T.Label}"/>
    <Style x:Key="MRT.Text.Header" TargetType="TextBlock" BasedOn="{StaticResource T.Title}"/>
    <Style x:Key="MRT.Text.Status" TargetType="TextBlock" BasedOn="{StaticResource T.Title}"/>
    <Style x:Key="MRT.Card.Header" TargetType="TextBlock" BasedOn="{StaticResource T.Label}"/>

    <!-- ══════════════ SURFACES ══════════════ -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CR.Card}"/>
        <Setter Property="Padding" Value="{StaticResource Pad.Card}"/>
    </Style>

    <Style x:Key="MRT.Card" TargetType="Border" BasedOn="{StaticResource Card}"/>

    <!-- ══════════════ BUTTONS ══════════════ -->

    <Style x:Key="Btn.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource Pad.Control}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CR.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TealDim}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Teal}"/>
                        </Trigger>
                        <!-- Visible keyboard focus. The old styles had none. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TealBright}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary: the one action on a screen that matters most. -->
    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Foreground" Value="#04211F"/>
        <Setter Property="Background" Value="{StaticResource TealBright}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TealBright}"/>
    </Style>

    <Style x:Key="Btn.Secondary" TargetType="Button" BasedOn="{StaticResource Btn.Base}"/>

    <!-- Destructive actions read differently from ordinary ones. -->
    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Foreground" Value="{StaticResource Bad}"/>
    </Style>

    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    </Style>

    <!-- Legacy button style names -->
    <Style x:Key="MRT.Button.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Primary}"/>
    <Style x:Key="MRT.Button.Secondary" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}"/>
    <Style x:Key="MRT.Button.Navigation" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}"/>
    <Style x:Key="MRT.Button.Navigation.Active" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}"/>
    <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}"/>

    <!-- ══════════════ TOGGLE SWITCH ══════════════ -->
    <!--
        A real switch rather than a checkbox styled as a button. On/off state is
        readable at a glance from the knob position alone, not only from colour,
        which matters on a page with dozens of them.
    -->

    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 42×24 track, 18 knob, 18 px of travel. The knob slides
                             rather than jumps, and the on state gets a soft halo so
                             it reads from across the room, not only from colour. -->
                        <Grid Grid.Column="0" Width="42" Height="24" VerticalAlignment="Center">
                            <Border x:Name="Halo"
                                    CornerRadius="{StaticResource CR.Pill}"
                                    Background="{StaticResource TealBright}"
                                    Margin="-3" Opacity="0"/>
                            <Border x:Name="Track"
                                    CornerRadius="{StaticResource CR.Pill}"
                                    Background="{StaticResource SurfaceRaised}"
                                    BorderBrush="{StaticResource BorderStrong}"
                                    BorderThickness="1"/>
                            <Ellipse x:Name="Knob" Width="18" Height="18"
                                     Fill="{StaticResource TextMuted}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobSlide" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>

                        <ContentPresenter x:Name="Label" Grid.Column="1"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Teal}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TealBright}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource TextPrimary}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobSlide"
                                                         Storyboard.TargetProperty="X"
                                                         To="18" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Halo"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.22" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobSlide"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Halo"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TealBright}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource OrangeBright}"/>
                            <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Legacy name: the old chip-style toggle. Mapped to the switch so every
         existing CheckBox picks up the new control automatically. -->
    <Style x:Key="MRT.ToggleButton" TargetType="CheckBox" BasedOn="{StaticResource Switch}"/>

    <!-- ══════════════ SLIDER ══════════════ -->

    <Style x:Key="Slider.Mrt" TargetType="Slider">
        <Setter Property="Height" Value="20"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="{StaticResource CR.Pill}"
                                Background="{StaticResource SurfaceRaised}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="{StaticResource CR.Pill}"
                                                    Background="{StaticResource Teal}"
                                                    VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False"
                                              Background="Transparent" BorderThickness="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Width="14" Height="14" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="Dot"
                                                     Fill="{StaticResource TextPrimary}"
                                                     Stroke="{StaticResource TealBright}"
                                                     StrokeThickness="2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource OrangeBright}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Orange}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MRT.Slider" TargetType="Slider" BasedOn="{StaticResource Slider.Mrt}"/>

    <!-- ══════════════ COMBO BOX ══════════════ -->

    <Style x:Key="Combo.Mrt" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{StaticResource SurfaceRaised}"
                                            BorderBrush="{StaticResource Border}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource CR.Control}">
                                        <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{StaticResource TextMuted}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,10,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TealBright}"/>
                                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource TealBright}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter Margin="10,0,26,0" VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                        <Popup x:Name="PART_Popup" AllowsTransparency="True"
                               Placement="Bottom" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource SurfaceRaised}"
                                    BorderBrush="{StaticResource BorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CR.Control}"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="320" Margin="0,4,0,0">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboItem.Mrt" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="3" Margin="3,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TealDim}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Apply the combo styles by default so existing ComboBoxes pick them up. -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource Combo.Mrt}"/>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboItem.Mrt}"/>

    <!-- ══════════════ TEXT BOX ══════════════ -->

    <Style x:Key="TextBox.Mrt" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TealBright}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Teal}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CR.Control}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TealBright}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.Mrt}"/>

    <!-- ══════════════ SCROLLBAR ══════════════ -->
    <!-- An overlay-style bar: a hairline thumb that widens when the pointer is
         anywhere in its lane, no arrows, no visible track. It reads as part of
         the content edge rather than as chrome, and turns brand teal while
         dragged so the drag state is unmistakable. -->

    <ControlTemplate x:Key="ScrollThumb.Vertical" TargetType="Thumb">
        <Grid Background="Transparent">
            <Border x:Name="T" Width="4" Margin="0,0,4,0"
                    HorizontalAlignment="Right"
                    Background="{StaticResource TextFaint}"
                    CornerRadius="{StaticResource CR.Pill}"/>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                <Setter TargetName="T" Property="Width" Value="8"/>
                <Setter TargetName="T" Property="Margin" Value="0,0,2,0"/>
                <Setter TargetName="T" Property="Background" Value="{StaticResource TextMuted}"/>
            </DataTrigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="T" Property="Width" Value="8"/>
                <Setter TargetName="T" Property="Margin" Value="0,0,2,0"/>
                <Setter TargetName="T" Property="Background" Value="{StaticResource TealBright}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="ScrollThumb.Horizontal" TargetType="Thumb">
        <Grid Background="Transparent">
            <Border x:Name="T" Height="4" Margin="0,0,0,4"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource TextFaint}"
                    CornerRadius="{StaticResource CR.Pill}"/>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                <Setter TargetName="T" Property="Height" Value="8"/>
                <Setter TargetName="T" Property="Margin" Value="0,0,0,2"/>
                <Setter TargetName="T" Property="Background" Value="{StaticResource TextMuted}"/>
            </DataTrigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="T" Property="Height" Value="8"/>
                <Setter TargetName="T" Property="Margin" Value="0,0,0,2"/>
                <Setter TargetName="T" Property="Background" Value="{StaticResource TealBright}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Margin="0,2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Template="{StaticResource ScrollThumb.Vertical}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent" Margin="2,0">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Template="{StaticResource ScrollThumb.Horizontal}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════ TOOLTIP ══════════════ -->

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource SurfaceRaised}"
                            BorderBrush="{StaticResource BorderStrong}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CR.Control}"
                            Padding="10,7" MaxWidth="300">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ DISCLOSURE ══════════════ -->

    <Style x:Key="MRT.Expander" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="Head"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Cursor="Hand" HorizontalContentAlignment="Stretch">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="Transparent" Padding="0,6" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Chev" Text="&#xE76C;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="{StaticResource TealBright}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chev" Property="Text" Value="&#xE70D;"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chev" Property="Foreground" Value="{StaticResource OrangeBright}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MRT.Expander.Header" TargetType="TextBlock" BasedOn="{StaticResource T.Label}"/>

    <!-- Legacy radio style -->
    <Style x:Key="MRT.RadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

</ResourceDictionary>
