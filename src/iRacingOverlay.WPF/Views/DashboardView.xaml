<Page x:Class="iRacingOverlay.WPF.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource DarkBackground}">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Page Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Dashboard" 
                           FontSize="28" 
                           FontWeight="Bold"
                           Foreground="{StaticResource LightText}"/>
            </StackPanel>
            
            <!-- Cards Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Connection Status Card (Top Left) -->
                <Border Grid.Row="0" Grid.Column="0"
                        Background="{StaticResource DarkSurface}"
                        BorderBrush="{StaticResource TealPrimary}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="25">
                    <StackPanel>
                        <TextBlock Text="⚡ Connection Status" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TealPrimary}"
                                   Margin="0,0,0,20"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="{Binding ConnectionStatusIcon}" 
                                       FontSize="48"
                                       VerticalAlignment="Center"
                                       Margin="0,0,20,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ConnectionStatusText}" 
                                           FontSize="22" 
                                           FontWeight="Bold"
                                           Foreground="{StaticResource LightText}"/>
                                <TextBlock Text="{Binding SessionInfo}" 
                                           FontSize="14"
                                           Foreground="{StaticResource MutedText}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <Separator Background="{StaticResource DarkBorder}" 
                                  Margin="0,10,0,15"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Last Connection" 
                                           FontSize="12"
                                           Foreground="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding LastConnectionTime}" 
                                           FontSize="16" 
                                           FontWeight="Medium"
                                           Foreground="{StaticResource LightText}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Update Rate" 
                                           FontSize="12"
                                           Foreground="{StaticResource MutedText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding UpdateRate, StringFormat={}{0:F0}}" 
                                               FontSize="16" 
                                               FontWeight="Medium"
                                               Foreground="{StaticResource LightText}"/>
                                    <TextBlock Text=" Hz" 
                                               FontSize="16"
                                               Foreground="{StaticResource MutedText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Active Widgets Card (Top Right) -->
                <Border Grid.Row="0" Grid.Column="2"
                        Background="{StaticResource DarkSurface}"
                        BorderBrush="{StaticResource TealPrimary}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="25">
                    <StackPanel>
                        <TextBlock Text="🎮 Active Widgets" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TealPrimary}"
                                   Margin="0,0,0,20"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="{Binding ActiveWidgetCount}" 
                                       FontSize="48" 
                                       FontWeight="Bold"
                                       Foreground="{StaticResource OrangePrimary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,15,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Widgets Running" 
                                           FontSize="16"
                                           Foreground="{StaticResource LightText}"/>
                                <TextBlock Text="Overlay components" 
                                           FontSize="12"
                                           Foreground="{StaticResource MutedText}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <Separator Background="{StaticResource DarkBorder}" 
                                  Margin="0,10,0,15"/>
                        
                        <TextBlock Text="Currently Active:" 
                                   FontSize="12"
                                   Foreground="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding ActiveWidgetsList}" 
                                   FontSize="14"
                                   Foreground="{StaticResource LightText}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- System Stats Card (Bottom Spanning) -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        Background="{StaticResource DarkSurface}"
                        BorderBrush="{StaticResource TealPrimary}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Application Uptime -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="⏱️ Application Uptime" 
                                       FontSize="14"
                                       Foreground="{StaticResource MutedText}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding UptimeText}" 
                                       FontSize="32" 
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TealPrimary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                        
                        <!-- Vertical Separator -->
                        <Separator Grid.Column="0" 
                                  Width="1" 
                                  Background="{StaticResource DarkBorder}"
                                  HorizontalAlignment="Right"
                                  Margin="0,10"/>
                        
                        <!-- Quick Actions -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🚀 Quick Actions" 
                                       FontSize="14"
                                       Foreground="{StaticResource MutedText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>
                            <Button Content="Manage Widgets" 
                                    Width="180"
                                    Height="40"
                                    Background="{StaticResource OrangePrimary}"
                                    Foreground="{StaticResource LightText}"
                                    BorderThickness="0"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Click="ManageWidgets_Click"/>
                        </StackPanel>
                        
                        <!-- Vertical Separator -->
                        <Separator Grid.Column="1" 
                                  Width="1" 
                                  Background="{StaticResource DarkBorder}"
                                  HorizontalAlignment="Right"
                                  Margin="0,10"/>
                        
                        <!-- Version Info -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📦 Version Info" 
                                       FontSize="14"
                                       Foreground="{StaticResource MutedText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="MRT UI v0.5.0" 
                                       FontSize="22" 
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TealPrimary}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
