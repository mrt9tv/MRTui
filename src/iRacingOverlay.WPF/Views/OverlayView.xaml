<UserControl x:Class="iRacingOverlay.WPF.Views.OverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:iRacingOverlay.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200"
             Background="{StaticResource DarkBackground}">
    
    <UserControl.Resources>
        <!-- Converters -->
        <converters:WidgetSelectionConverter x:Key="WidgetSelectionConverter"/>
        
        <!-- Widget Button Style (matches Settings TabButtonStyle) -->
        <Style x:Key="WidgetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MRT.White}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2F2F2F"/>
                    <Setter Property="BorderThickness" Value="0,0,3,0"/>
                    <Setter Property="BorderBrush" Value="{StaticResource TealPrimary}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Active">
                    <Setter Property="Background" Value="#1E3A3A"/>
                    <Setter Property="BorderThickness" Value="0,0,3,0"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OrangePrimary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Main Content Area -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Widget List -->
            <Border Grid.Column="0" 
                    Background="{StaticResource DarkSurface}"
                    BorderBrush="{StaticResource TealPrimary}"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="🎮 Overlay Manager" 
                              FontSize="22" 
                              FontWeight="Bold"
                              Foreground="{StaticResource TealPrimary}"
                              Margin="20,0,20,30"
                              HorizontalAlignment="Left"/>

                    <ItemsControl ItemsSource="{Binding Widgets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource WidgetButtonStyle}"
                                        Command="{Binding DataContext.SelectWidgetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Tag>
                                        <MultiBinding Converter="{StaticResource WidgetSelectionConverter}">
                                            <Binding Path="DataContext.SelectedWidget" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            <Binding Path="."/>
                                        </MultiBinding>
                                    </Button.Tag>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Widget Icon and Name -->
                                        <TextBlock Text="{Binding Icon}" 
                                                  FontSize="16"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" 
                                                  FontSize="16"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>
                                        
                                        <!-- Active Indicator -->
                                        <Border Background="{StaticResource TealPrimary}"
                                               CornerRadius="8"
                                               Padding="5,2"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="ACTIVE" 
                                                      FontSize="9"
                                                      FontWeight="Bold"
                                                      Foreground="{StaticResource DarkBackground}"/>
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Right Panel: Widget Configuration -->
            <ScrollViewer Grid.Column="1" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="40">
                <StackPanel DataContext="{Binding SelectedWidget}" MaxWidth="600" HorizontalAlignment="Left">
                    <!-- Activate/Deactivate Button -->
                    <Button Command="{Binding ToggleActiveCommand}"
                           Height="50"
                           Margin="0,0,0,25">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MRT.Button.Primary}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="#D32F2F"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Background" Value="#388E3C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Content>
                                    <TextBlock Text="{Binding ActivateButtonText}" 
                                              FontSize="16"
                                              FontWeight="SemiBold"
                                              HorizontalAlignment="Center"/>
                                </Button.Content>
                            </Button>

                            <!-- Opacity Slider -->
                            <StackPanel Margin="0,0,0,25">
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Opacity" 
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource LightText}"/>
                                    <TextBlock Text="{Binding OpacityPercentage}" 
                                              FontSize="14"
                                              FontWeight="Bold"
                                              Foreground="{StaticResource OrangePrimary}"
                                              HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider Value="{Binding Opacity, Mode=TwoWay}"
                                       Minimum="0.1"
                                       Maximum="1.0"
                                       TickFrequency="0.1"
                                       IsSnapToTickEnabled="True"
                                       Style="{StaticResource MRT.Slider}"
                                       IsEnabled="{Binding IsActive}"/>
                                <Grid Margin="0,5,0,0">
                                    <TextBlock Text="10%" 
                                              FontSize="11"
                                              Foreground="{StaticResource MutedText}"/>
                                    <TextBlock Text="100%" 
                                              FontSize="11"
                                              Foreground="{StaticResource MutedText}"
                                              HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <!-- Size Slider -->
                            <StackPanel Margin="0,0,0,25">
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Size" 
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource LightText}"/>
                                    <TextBlock Text="{Binding ScalePercentage}" 
                                              FontSize="14"
                                              FontWeight="Bold"
                                              Foreground="{StaticResource OrangePrimary}"
                                              HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider Value="{Binding Scale, Mode=TwoWay}"
                                       Minimum="0.5"
                                       Maximum="2.0"
                                       TickFrequency="0.1"
                                       IsSnapToTickEnabled="True"
                                       Style="{StaticResource MRT.Slider}"
                                       IsEnabled="{Binding IsActive}"/>
                                <Grid Margin="0,5,0,0">
                                    <TextBlock Text="50%" 
                                              FontSize="11"
                                              Foreground="{StaticResource MutedText}"/>
                                    <TextBlock Text="200%" 
                                              FontSize="11"
                                              Foreground="{StaticResource MutedText}"
                                              HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <!-- Widget-Specific Settings Placeholder -->
                            <Border Background="{StaticResource DarkBackground}"
                                   BorderBrush="{StaticResource DarkBorder}"
                                   BorderThickness="1"
                                   CornerRadius="8"
                                   Padding="15"
                                   Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Widget-Specific Settings" 
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource MutedText}"
                                              Margin="0,0,0,10"/>
                                    <TextBlock Text="Coming in Phase 1.5" 
                                              FontSize="12"
                                              Foreground="{StaticResource MutedText}"
                                              TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" 
                                       HorizontalAlignment="Right">
                                <Button Content="Reset Position" 
                                       Style="{StaticResource MRT.Button.Secondary}"
                                       IsEnabled="{Binding IsActive}"
                                       Margin="0,0,10,0"
                                       Padding="15,8"/>
                                <Button Content="Reset All" 
                                       Style="{StaticResource MRT.Button.Secondary}"
                                       IsEnabled="{Binding IsActive}"
                                       Padding="15,8"/>
                            </StackPanel>
                        </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
