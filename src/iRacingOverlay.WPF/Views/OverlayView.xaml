<UserControl x:Class="iRacingOverlay.WPF.Views.OverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:iRacingOverlay.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200"
             Background="{StaticResource DarkBackground}">
    
    <UserControl.Resources>
        <!-- Converters -->
        <converters:WidgetSelectionConverter x:Key="WidgetSelectionConverter"/>
        
        <!-- Widget Button Style (matches Settings TabButtonStyle) -->
        <Style x:Key="WidgetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MRT.White}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2F2F2F"/>
                    <Setter Property="BorderThickness" Value="0,0,3,0"/>
                    <Setter Property="BorderBrush" Value="{StaticResource TealPrimary}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Active">
                    <Setter Property="Background" Value="#1E3A3A"/>
                    <Setter Property="BorderThickness" Value="0,0,3,0"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OrangePrimary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Main Content Area -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Widget List -->
            <Border Grid.Column="0" 
                    Background="{StaticResource DarkSurface}"
                    BorderBrush="{StaticResource TealPrimary}"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="🎮 Overlay Manager" 
                              FontSize="22" 
                              FontWeight="Bold"
                              Foreground="{StaticResource TealPrimary}"
                              Margin="20,0,20,30"
                              HorizontalAlignment="Left"/>

                    <ItemsControl ItemsSource="{Binding Widgets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource WidgetButtonStyle}"
                                        Command="{Binding DataContext.SelectWidgetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Tag>
                                        <MultiBinding Converter="{StaticResource WidgetSelectionConverter}">
                                            <Binding Path="DataContext.SelectedWidget" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            <Binding Path="."/>
                                        </MultiBinding>
                                    </Button.Tag>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Widget Icon and Name -->
                                        <TextBlock Text="{Binding Icon}" 
                                                  FontSize="16"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" 
                                                  FontSize="16"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>
                                        
                                        <!-- Active Indicator -->
                                        <Border Background="{StaticResource TealPrimary}"
                                               CornerRadius="8"
                                               Padding="5,2"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="ACTIVE" 
                                                      FontSize="9"
                                                      FontWeight="Bold"
                                                      Foreground="{StaticResource DarkBackground}"/>
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Right Panel: Widget Configuration -->
            <ScrollViewer Grid.Column="1" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="40">
                <StackPanel DataContext="{Binding SelectedWidget}" MaxWidth="900" HorizontalAlignment="Left">
                    <!-- Activate/Deactivate Button -->
                    <Button Command="{Binding ToggleActiveCommand}"
                           Height="50"
                           Margin="0,0,0,25">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MRT.Button.Primary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Background" Value="#D32F2F"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter Property="Background" Value="#388E3C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Content>
                            <TextBlock Text="{Binding ActivateButtonText}" 
                                      FontSize="16"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center"/>
                        </Button.Content>
                    </Button>

                    <!-- Sliders and Widget Configuration Side-by-Side -->
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Opacity and Size Sliders -->
                        <StackPanel Grid.Column="0">
                            <!-- Opacity Slider -->
                            <StackPanel Margin="0,0,0,25">
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Opacity" 
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource LightText}"/>
                                    <TextBlock Text="{Binding OpacityPercentage}" 
                                              FontSize="14"
                                              FontWeight="Bold"
                                              Foreground="{StaticResource OrangePrimary}"
                                              HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider Value="{Binding Opacity, Mode=TwoWay}"
                                       Minimum="0.1"
                                       Maximum="1.0"
                                       TickFrequency="0.1"
                                       IsSnapToTickEnabled="True"
                                       Style="{StaticResource MRT.Slider}"
                                       IsEnabled="{Binding IsActive}"/>
                                <Grid Margin="0,5,0,0">
                                    <TextBlock Text="10%" 
                                              FontSize="11"
                                              Foreground="{StaticResource MutedText}"/>
                                    <TextBlock Text="100%" 
                                              FontSize="11"
                                              Foreground="{StaticResource MutedText}"
                                              HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <!-- Size Slider -->
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Size" 
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource LightText}"/>
                                    <TextBlock Text="{Binding SizeDisplay}" 
                                              FontSize="14"
                                              FontWeight="Bold"
                                              Foreground="{StaticResource OrangePrimary}"
                                              HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider Value="{Binding WidgetSize, Mode=TwoWay}"
                                       Minimum="{Binding MinSize}"
                                       Maximum="{Binding MaxSize}"
                                       TickFrequency="10"
                                       IsSnapToTickEnabled="True"
                                       Style="{StaticResource MRT.Slider}"
                                       IsEnabled="{Binding IsActive}"/>
                                <Grid Margin="0,5,0,0">
                                    <TextBlock Text="{Binding MinSize, StringFormat={}{0:F0}px}" 
                                              FontSize="11"
                                              Foreground="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding MaxSize, StringFormat={}{0:F0}px}" 
                                              FontSize="11"
                                              Foreground="{StaticResource MutedText}"
                                              HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right Column: MRT One Widget Configuration -->
                        <Border Grid.Column="2"
                               Background="{StaticResource DarkSurface}"
                               CornerRadius="10"
                               Padding="20"
                               Visibility="{Binding IsMRTOneWidget, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Widget Configuration" 
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource LightText}"
                                          Margin="0,0,0,15"/>
                                
                                <!-- Top Section -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Top Section" 
                                              FontSize="12"
                                              Foreground="{StaticResource LightText}"
                                              Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding AvailableTelemetryFields}"
                                             SelectedItem="{Binding TopSelectedField, Mode=TwoWay}"
                                             IsEnabled="{Binding IsActive}"/>
                                </StackPanel>
                                
                                <!-- Center Section -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Center Section (Large)" 
                                              FontSize="12"
                                              Foreground="{StaticResource LightText}"
                                              Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding AvailableTelemetryFields}"
                                             SelectedItem="{Binding CenterSelectedField, Mode=TwoWay}"
                                             IsEnabled="{Binding IsActive}"/>
                                </StackPanel>
                                
                                <!-- Bottom Section -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Bottom Section" 
                                              FontSize="12"
                                              Foreground="{StaticResource LightText}"
                                              Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding AvailableTelemetryFields}"
                                             SelectedItem="{Binding BottomSelectedField, Mode=TwoWay}"
                                             IsEnabled="{Binding IsActive}"/>
                                </StackPanel>
                                
                                <!-- Left Side Box -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Left Side Box" 
                                              FontSize="12"
                                              Foreground="{StaticResource LightText}"
                                              Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding AvailableSideBoxFields}"
                                             SelectedItem="{Binding LeftSelectedField, Mode=TwoWay}"
                                             IsEnabled="{Binding IsActive}"/>
                                </StackPanel>
                                
                                <!-- Right Side Box -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Right Side Box" 
                                              FontSize="12"
                                              Foreground="{StaticResource LightText}"
                                              Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding AvailableSideBoxFields}"
                                             SelectedItem="{Binding RightSelectedField, Mode=TwoWay}"
                                             IsEnabled="{Binding IsActive}"/>
                                </StackPanel>
                                
                                <!-- Info: Changes apply instantly -->
                                <TextBlock Text="✨ Changes apply instantly"
                                          FontSize="11"
                                          FontStyle="Italic"
                                          Foreground="{StaticResource MutedText}"
                                          HorizontalAlignment="Center"
                                          Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                            <!-- Action Buttons -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Position Actions" 
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource LightText}"
                                          Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Row 1: Center buttons -->
                                    <Button Grid.Row="0" Grid.Column="0"
                                           Content="Center Horizontally" 
                                           Command="{Binding CenterHorizontallyCommand}"
                                           Style="{StaticResource MRT.Button.Secondary}"
                                           IsEnabled="{Binding IsActive}"
                                           Padding="15,8"/>
                                    <Button Grid.Row="0" Grid.Column="2"
                                           Content="Center Vertically" 
                                           Command="{Binding CenterVerticallyCommand}"
                                           Style="{StaticResource MRT.Button.Secondary}"
                                           IsEnabled="{Binding IsActive}"
                                           Padding="15,8"/>
                                    
                                    <!-- Row 2: Reset buttons -->
                                    <Button Grid.Row="2" Grid.Column="0"
                                           Content="Reset Position" 
                                           Command="{Binding ResetPositionCommand}"
                                           Style="{StaticResource MRT.Button.Secondary}"
                                           IsEnabled="{Binding IsActive}"
                                           Padding="15,8"/>
                                    <Button Grid.Row="2" Grid.Column="2"
                                           Content="Reset All" 
                                           Command="{Binding ResetAllCommand}"
                                           Style="{StaticResource MRT.Button.Secondary}"
                                           IsEnabled="{Binding IsActive}"
                                           Padding="15,8"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
