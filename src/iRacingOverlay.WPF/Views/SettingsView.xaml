<UserControl x:Class="iRacingOverlay.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:iRacingOverlay.WPF.Converters"
             xmlns:controls="clr-namespace:iRacingOverlay.WPF.Controls"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{StaticResource DarkBackground}">

    <UserControl.Resources>
        <!-- Converters -->
        <converters:TabVisibilityConverter x:Key="TabVisibilityConverter"/>
        <converters:TabActiveConverter x:Key="TabActiveConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <!-- Tab Button Style -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MRT.White}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2F2F2F"/>
                    <Setter Property="BorderThickness" Value="0,0,3,0"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OrangePrimary}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Active">
                    <Setter Property="Background" Value="#1E3A3A"/>
                    <Setter Property="BorderThickness" Value="0,0,3,0"/>
                    <Setter Property="BorderBrush" Value="{StaticResource TealPrimary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TealPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- Setting Label Style -->
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource MRT.White}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Setting Description Style -->
        <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Panel -->
        <Border Grid.Column="0" 
                Background="{StaticResource DarkSurface}"
                BorderBrush="{StaticResource TealPrimary}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="⚙️ Settings" 
                          FontSize="22" 
                          FontWeight="Bold"
                          Foreground="{StaticResource TealPrimary}"
                          Margin="20,0,20,30"
                          HorizontalAlignment="Left"/>

                <Button Content="🌐 General" 
                        Style="{StaticResource TabButtonStyle}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="General"
                        Tag="{Binding SelectedTab, Converter={StaticResource TabActiveConverter}, ConverterParameter=General}"/>

                <Button Content="🎮 Widgets" 
                        Style="{StaticResource TabButtonStyle}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="Widgets"
                        Tag="{Binding SelectedTab, Converter={StaticResource TabActiveConverter}, ConverterParameter=Widgets}"/>

                <Button Content="🖥️ Manager" 
                        Style="{StaticResource TabButtonStyle}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="Manager"
                        Tag="{Binding SelectedTab, Converter={StaticResource TabActiveConverter}, ConverterParameter=Manager}"/>

                <Button Content="ℹ️ About" 
                        Style="{StaticResource TabButtonStyle}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="About"
                        Tag="{Binding SelectedTab, Converter={StaticResource TabActiveConverter}, ConverterParameter=About}"/>
            </StackPanel>
        </Border>

        <!-- Right Content Panel -->
        <ScrollViewer Grid.Column="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="40">
            <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                <!-- General Settings Tab -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=General}">
                    <TextBlock Text="General Settings" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Unit System -->
                    <Border Background="{StaticResource DarkSurface}"
                            BorderBrush="{StaticResource TealPrimary}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Unit System" Style="{StaticResource SettingLabelStyle}"/>
                            
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <RadioButton Grid.Column="0"
                                           Content="⚡ Metric (km/h, L, °C)" 
                                           IsChecked="{Binding UseMetric}"
                                           Style="{StaticResource MRT.RadioButton}"
                                           VerticalAlignment="Center"/>
                                <RadioButton Grid.Column="2"
                                           Content="🦅 Imperial (mph, gal, °F)" 
                                           IsChecked="{Binding UseMetric, Converter={StaticResource InverseBoolConverter}}"
                                           Style="{StaticResource MRT.RadioButton}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="{Binding UnitSystemText, StringFormat='Current: {0}'}"
                                     Style="{StaticResource SettingDescriptionStyle}"/>
                            <TextBlock Text="Changes apply to all widgets immediately"
                                     Style="{StaticResource SettingDescriptionStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Widgets Settings Tab -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Widgets}">
                    <TextBlock Text="Widget Controls" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Toggle Lock Hotkey with Lock Checkbox -->
                    <Border Background="{StaticResource DarkSurface}"
                            BorderBrush="{StaticResource TealPrimary}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Header with Lock Status -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                         Text="Lock Widgets"
                                         Style="{StaticResource SettingLabelStyle}"
                                         Margin="0"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LockStatusIcon}"
                                             FontSize="24"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding LockWidgets}"
                                            Style="{StaticResource MRT.ToggleButton}"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Hotkey Configuration -->
                            <TextBlock Text="Hotkey"
                                     FontSize="12"
                                     Foreground="{StaticResource MutedText}"
                                     Margin="0,0,0,5"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <controls:HotkeyCapture Grid.Column="0"
                                                       ModifierKey="{Binding ToggleLockModifier, Mode=TwoWay}"
                                                       MainKey="{Binding ToggleLockKey, Mode=TwoWay}"
                                                       HotkeyChanged="HotkeyCapture_HotkeyChanged"
                                                       Width="200"
                                                       Margin="0,0,15,0"/>

                                <TextBlock Grid.Column="1"
                                         Text="Toggle lock/unlock globally"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource SettingLabelStyle}"
                                         Margin="0"/>
                            </Grid>

                            <TextBlock Text="Prevent widgets from being moved or clicked. Works even when racing in iRacing."
                                     Style="{StaticResource SettingDescriptionStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Toggle Visibility Hotkey with Show/Hide Checkbox -->
                    <Border Background="{StaticResource DarkSurface}"
                            BorderBrush="{StaticResource TealPrimary}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Header with Visibility Status -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                         Text="Widget Visibility"
                                         Style="{StaticResource SettingLabelStyle}"
                                         Margin="0"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VisibilityStatusIcon}"
                                             FontSize="24"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding ShowWidgets}"
                                            Style="{StaticResource MRT.ToggleButton}"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Hotkey Configuration -->
                            <TextBlock Text="Hotkey"
                                     FontSize="12"
                                     Foreground="{StaticResource MutedText}"
                                     Margin="0,0,0,5"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <controls:HotkeyCapture Grid.Column="0"
                                                       ModifierKey="{Binding ToggleVisibilityModifier, Mode=TwoWay}"
                                                       MainKey="{Binding ToggleVisibilityKey, Mode=TwoWay}"
                                                       HotkeyChanged="HotkeyCapture_HotkeyChanged"
                                                       Width="200"
                                                       Margin="0,0,15,0"/>

                                <TextBlock Grid.Column="1"
                                         Text="Toggle show/hide globally"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource SettingLabelStyle}"
                                         Margin="0"/>
                            </Grid>

                            <TextBlock Text="Show or hide all widgets instantly. Works even when racing in iRacing."
                                     Style="{StaticResource SettingDescriptionStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Snap-to-Grid (Phase 3.1) -->
                    <Border Background="{StaticResource DarkSurface}"
                            BorderBrush="{StaticResource TealPrimary}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="📐 Snap-to-Grid (Phase 3.1)" 
                                     FontSize="16"
                                     FontWeight="Bold"
                                     Foreground="{StaticResource TealPrimary}"
                                     Margin="0,0,0,15"/>

                            <!-- Enable Snap-to-Grid -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Enable Snap-to-Grid" Style="{StaticResource SettingLabelStyle}"/>
                                    <TextBlock Text="Automatically align widgets to grid points when dragging"
                                             Style="{StaticResource SettingDescriptionStyle}"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                        IsChecked="{Binding SnapToGridEnabled}"
                                        Style="{StaticResource MRT.ToggleButton}"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Grid Size -->
                            <Grid Margin="0,0,0,15" IsEnabled="{Binding SnapToGridEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Grid Size" Style="{StaticResource SettingLabelStyle}"/>
                                    <TextBlock Text="Distance between grid points (pixels)"
                                             Style="{StaticResource SettingDescriptionStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider Width="150"
                                          Minimum="10"
                                          Maximum="50"
                                          Value="{Binding SnapToGridSize}"
                                          TickFrequency="5"
                                          IsSnapToTickEnabled="True"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding SnapToGridSize, StringFormat={}{0}px}"
                                             FontWeight="Bold"
                                             Foreground="{StaticResource TealPrimary}"
                                             VerticalAlignment="Center"
                                             MinWidth="45"/>
                                </StackPanel>
                            </Grid>

                            <!-- Show Grid Overlay -->
                            <Grid Margin="0,0,0,0" IsEnabled="{Binding SnapToGridEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Show Grid Overlay" Style="{StaticResource SettingLabelStyle}"/>
                                    <TextBlock Text="Display visual grid lines while dragging widgets (future feature)"
                                             Style="{StaticResource SettingDescriptionStyle}"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                        IsChecked="{Binding ShowGridOverlay}"
                                        Style="{StaticResource MRT.ToggleButton}"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Fuel Widget Phase 3: Pit Strategy -->
                    <Border Background="{StaticResource DarkSurface}"
                            BorderBrush="{StaticResource OrangePrimary}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="⛽ Fuel Pit Strategy (Phase 3)" 
                                     FontSize="16"
                                     FontWeight="Bold"
                                     Foreground="{StaticResource OrangePrimary}"
                                     Margin="0,0,0,15"/>

                            <!-- Fuel Saving Mode -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Enable Fuel Saving Mode" Style="{StaticResource SettingLabelStyle}"/>
                                    <TextBlock Text="Show fuel saving target, progress, and strategic alerts"
                                             Style="{StaticResource SettingDescriptionStyle}"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                        IsChecked="{Binding FuelWidget_EnableFuelSaving}"
                                        Style="{StaticResource MRT.ToggleButton}"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Show Lift Points -->
                            <Grid Margin="0,0,0,10"
                                  IsEnabled="{Binding FuelWidget_EnableFuelSaving}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Show Lift Point Suggestions" Style="{StaticResource SettingLabelStyle}"/>
                                    <TextBlock Text="Display where to lift to save fuel"
                                             Style="{StaticResource SettingDescriptionStyle}"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                        IsChecked="{Binding FuelWidget_ShowLiftPoints}"
                                        Style="{StaticResource MRT.ToggleButton}"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Show Saving Alerts -->
                            <Grid Margin="0,0,0,10"
                                  IsEnabled="{Binding FuelWidget_EnableFuelSaving}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Show Strategic Alerts" Style="{StaticResource SettingLabelStyle}"/>
                                    <TextBlock Text="Display alerts like 'PIT THIS LAP' or 'INCREASE SAVING'"
                                             Style="{StaticResource SettingDescriptionStyle}"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                        IsChecked="{Binding FuelWidget_ShowSavingAlerts}"
                                        Style="{StaticResource MRT.ToggleButton}"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Optimal Pit Calculator -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Optimal Pit Lap Calculator" Style="{StaticResource SettingLabelStyle}"/>
                                    <TextBlock Text="Calculate best lap to pit (considers yellow flags)"
                                             Style="{StaticResource SettingDescriptionStyle}"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                        IsChecked="{Binding FuelWidget_OptimalPitCalculator}"
                                        Style="{StaticResource MRT.ToggleButton}"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Dynamic Buffer Laps -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🎯 Dynamic Buffer Laps (Enhanced)" Style="{StaticResource SettingLabelStyle}"/>
                                    <TextBlock Text="Auto-adjust buffer based on consistency, position, weather, yellow probability"
                                             Style="{StaticResource SettingDescriptionStyle}"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                        IsChecked="{Binding FuelWidget_EnableDynamicBuffer}"
                                        Style="{StaticResource MRT.ToggleButton}"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <Separator Background="#404040" Margin="0,10"/>

                            <!-- NOTE: Race Strategy Widget moved to Overlay Manager (Phase 10) -->
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Manager Settings Tab -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Manager}">
                    <TextBlock Text="Manager Window" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Always On Top -->
                    <Border Background="{StaticResource DarkSurface}"
                            BorderBrush="{StaticResource TealPrimary}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Always On Top" Style="{StaticResource SettingLabelStyle}"/>
                                <TextBlock Text="Keep manager window above all other windows"
                                         Style="{StaticResource SettingDescriptionStyle}"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1"
                                    IsChecked="{Binding AlwaysOnTop}"
                                    Style="{StaticResource MRT.ToggleButton}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Start Minimized -->
                    <Border Background="{StaticResource DarkSurface}"
                            BorderBrush="{StaticResource TealPrimary}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Start Minimized" Style="{StaticResource SettingLabelStyle}"/>
                                <TextBlock Text="Launch manager to taskbar (widgets still visible)"
                                         Style="{StaticResource SettingDescriptionStyle}"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1"
                                    IsChecked="{Binding StartMinimized}"
                                    Style="{StaticResource MRT.ToggleButton}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- About Tab -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=About}">
                    <TextBlock Text="About MRT UI" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Version Info -->
                    <Border Background="{StaticResource DarkSurface}"
                            BorderBrush="{StaticResource TealPrimary}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="🏎️ Mokka Racing Team UI" 
                                     FontSize="20"
                                     FontWeight="Bold"
                                     Foreground="{StaticResource TealPrimary}"
                                     Margin="0,0,0,15"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Application:" Style="{StaticResource SettingLabelStyle}"/>
                                <TextBlock Grid.Column="1" 
                                         Text="{Binding AppVersion}"
                                         FontWeight="Bold"
                                         Foreground="{StaticResource OrangePrimary}"
                                         Style="{StaticResource SettingLabelStyle}"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="iRacing SDK:" Style="{StaticResource SettingLabelStyle}"/>
                                <TextBlock Grid.Column="1" 
                                         Text="{Binding IracingSdkVersion}"
                                         Style="{StaticResource SettingLabelStyle}"/>
                            </Grid>

                            <TextBlock Text="Modern overlay system for iRacing telemetry"
                                     Style="{StaticResource SettingDescriptionStyle}"
                                     Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Links -->
                    <Border Background="{StaticResource DarkSurface}"
                            BorderBrush="{StaticResource TealPrimary}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Resources" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,15"/>

                            <Button Content="📖 Documentation"
                                  Style="{StaticResource MRT.Button.Secondary}"
                                  Margin="0,0,0,10"
                                  HorizontalAlignment="Left"
                                  Padding="15,8"/>

                            <Button Content="🐛 Report Issue"
                                  Style="{StaticResource MRT.Button.Secondary}"
                                  HorizontalAlignment="Left"
                                  Padding="15,8"/>

                            <TextBlock Text="Links will open your default browser"
                                     Style="{StaticResource SettingDescriptionStyle}"
                                     Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Reset All Button (visible on all tabs) -->
                <Border Background="{StaticResource DarkSurface}"
                        BorderBrush="#FF4444"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,20,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="⚠️ Reset All Settings" 
                                     FontSize="14"
                                     FontWeight="Bold"
                                     Foreground="#FF4444"/>
                            <TextBlock Text="Restore all settings to default values"
                                     Style="{StaticResource SettingDescriptionStyle}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                              Content="Reset All"
                              Command="{Binding ResetAllCommand}"
                              Background="#FF4444"
                              Foreground="White"
                              BorderThickness="0"
                              Padding="15,8"
                              FontWeight="Bold"
                              Cursor="Hand"
                              VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                      CornerRadius="4"
                                                      Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#CC0000"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
