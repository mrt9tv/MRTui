<core:WidgetBase x:Class="iRacingOverlay.WPF.Widgets.FuelWidget.FuelWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:iRacingOverlay.WPF.Core"
        Title="Fuel Assist"
        Width="240"
        SizeToContent="Height">

    <Border x:Name="RootBorder"
            Background="#DD000000"
            BorderBrush="#008080"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">
        <Grid x:Name="MainGrid">
            <Grid.RowDefinitions>
                <!-- Row 0: Header -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Separator -->
                <RowDefinition Height="8"/>

                <!-- Row 2-4: Current Fuel Section -->
                <RowDefinition Height="Auto" x:Name="FuelBarRow"/> <!-- Fuel bar with E/F -->
                <RowDefinition Height="Auto"/> <!-- Current fuel value + % -->
                <RowDefinition Height="Auto"/> <!-- Sparklines -->
                <!-- Row 5: Separator -->
                <RowDefinition Height="8"/>

                <!-- Row 6-9: Consumption Section -->
                <RowDefinition Height="Auto"/> <!-- LAST lap -->
                <RowDefinition Height="Auto"/> <!-- L5 average -->
                <RowDefinition Height="Auto" x:Name="L10Row"/> <!-- L10 average (optional) -->
                <RowDefinition Height="Auto" x:Name="SessionRow"/> <!-- SESSION average (optional) -->
                <!-- Row 10: Separator -->
                <RowDefinition Height="8"/>

                <!-- Row 11-12: Strategy Section -->
                <RowDefinition Height="Auto" x:Name="LapsRemainingRow"/> <!-- LAPS remaining -->
                <RowDefinition Height="Auto" x:Name="CanFinishRow"/> <!-- TO GO (optional) -->

                <!-- Row 13-15: Additional Info Section (no separator before) -->
                <RowDefinition Height="Auto" x:Name="PressureRow"/> <!-- PRESS (optional) -->
                <RowDefinition Height="Auto" x:Name="PitFuelRow"/> <!-- PIT (optional) -->
                <RowDefinition Height="Auto" x:Name="PitWindowRow"/> <!-- PIT IN (optional) -->
                
                <!-- Row 16-21: Phase 3 Fuel Saving Section (optional) -->
                <RowDefinition Height="8" x:Name="FuelSavingSeparatorRow"/> <!-- Separator -->
                <RowDefinition Height="Auto" x:Name="FuelSavingHeaderRow"/> <!-- Header -->
                <RowDefinition Height="Auto" x:Name="FuelSavingTargetRow"/> <!-- Target + Progress -->
                <RowDefinition Height="Auto" x:Name="FuelSavingLiftRow"/> <!-- Lift points -->
                <RowDefinition Height="Auto" x:Name="FuelSavingAlertRow"/> <!-- Strategic alert -->
                <RowDefinition Height="Auto" x:Name="OptimalPitLapRow"/> <!-- Optimal pit lap -->
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="⛽ FUEL ASSIST"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#008080"
                       HorizontalAlignment="Center"/>

            <!-- Current Fuel + Percentage -->
            <Grid Grid.Row="2" x:Name="FuelBarGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- E (Empty) indicator -->
                <TextBlock Grid.Column="0"
                           Text="E"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#888888"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>

                <!-- Fuel Bar Graph (moved here, more prominent) -->
                <Border Grid.Column="1"
                        Background="#222222"
                        CornerRadius="3"
                        Padding="1"
                        VerticalAlignment="Center"
                        Height="12">
                    <Grid>
                        <!-- Background bar -->
                        <Rectangle Fill="#333333" RadiusX="2" RadiusY="2"/>
                        
                        <!-- Fuel level indicator (will be updated via code) -->
                        <Rectangle x:Name="FuelBarFill"
                                   Fill="#00FF00"
                                   RadiusX="2"
                                   RadiusY="2"
                                   HorizontalAlignment="Left"
                                   Width="0"/>
                    </Grid>
                </Border>

                <!-- Tank capacity -->
                <TextBlock Grid.Column="2"
                           x:Name="TankCapacityText"
                           Text="60L"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#888888"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>
            </Grid>

            <!-- Fuel Level + Percentage (moved under bar, centered) -->
            <TextBlock Grid.Row="3"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,2,0,0">
                <Run x:Name="CurrentFuelRun"
                     Text="0.00 L"
                     FontSize="12"
                     FontWeight="Bold"
                     Foreground="#008080"/>
                <Run Text=" "
                     FontSize="12"/>
                <Run x:Name="FuelPercentageRun"
                     Text="(0%)"
                     FontSize="12"
                     Foreground="#AAAAAA"/>
            </TextBlock>

            <!-- Sparklines: Fuel Usage Trends -->
            <Grid Grid.Row="4" Margin="8,6,8,0" x:Name="SparklineGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>

                <!-- Live Usage Label -->
                <TextBlock Grid.Row="0"
                           Text="LIVE (5s)"
                           FontSize="8"
                           Foreground="#666666"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,2"/>

                <!-- Live Usage Sparkline with Min/Max -->
                <Border Grid.Row="1"
                        Background="#1A1A1A"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        CornerRadius="2">
                    <Grid>
                        <Canvas x:Name="LiveSparklineCanvas"
                                ClipToBounds="True">
                            <!-- Floor line (bottom) -->
                            <Line x:Name="LiveFloorLine"
                                  X1="0" Y1="22" X2="1000" Y2="22"
                                  Stroke="#2A2A2A"
                                  StrokeThickness="1"
                                  StrokeDashArray="2,2"/>
                            
                            <!-- Middle guide line -->
                            <Line x:Name="LiveMiddleLine"
                                  X1="0" Y1="12" X2="1000" Y2="12"
                                  Stroke="#404040"
                                  StrokeThickness="0.5"
                                  StrokeDashArray="1,2"/>
                            
                            <!-- Ceiling line (top) -->
                            <Line x:Name="LiveCeilingLine"
                                  X1="0" Y1="2" X2="1000" Y2="2"
                                  Stroke="#2A2A2A"
                                  StrokeThickness="1"
                                  StrokeDashArray="2,2"/>
                            
                            <Polyline x:Name="LiveSparkline"
                                      Stroke="#FF8000"
                                      StrokeThickness="1.5"
                                      Points="0,12 10,10 20,14"/>
                        </Canvas>
                        <!-- Min/Max labels -->
                        <TextBlock x:Name="LiveMinText"
                                   Text="--"
                                   FontSize="7"
                                   Foreground="#666666"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Bottom"
                                   Margin="2,0,0,1"/>
                        <TextBlock x:Name="LiveMaxText"
                                   Text="--"
                                   FontSize="7"
                                   Foreground="#666666"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Margin="0,1,2,0"/>
                    </Grid>
                </Border>

                <!-- Lap History Label -->
                <TextBlock Grid.Row="3"
                           Text="LAPS (5)"
                           FontSize="8"
                           Foreground="#666666"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,2"/>

                <!-- Lap History Sparkline with Min/Max -->
                <Border Grid.Row="4"
                        Background="#1A1A1A"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        CornerRadius="2">
                    <Grid>
                        <Canvas x:Name="LapSparklineCanvas"
                                ClipToBounds="True">
                            <!-- Floor line (bottom) -->
                            <Line x:Name="LapFloorLine"
                                  X1="0" Y1="22" X2="1000" Y2="22"
                                  Stroke="#2A2A2A"
                                  StrokeThickness="1"
                                  StrokeDashArray="2,2"/>
                            
                            <!-- Middle guide line -->
                            <Line x:Name="LapMiddleLine"
                                  X1="0" Y1="12" X2="1000" Y2="12"
                                  Stroke="#404040"
                                  StrokeThickness="0.5"
                                  StrokeDashArray="1,2"/>
                            
                            <!-- Ceiling line (top) -->
                            <Line x:Name="LapCeilingLine"
                                  X1="0" Y1="2" X2="1000" Y2="2"
                                  Stroke="#2A2A2A"
                                  StrokeThickness="1"
                                  StrokeDashArray="2,2"/>
                            
                            <Polyline x:Name="LapSparkline"
                                      Stroke="#008080"
                                      StrokeThickness="1.5"
                                      Points="0,12 10,10 20,14"/>
                        </Canvas>
                        <!-- Min/Max labels -->
                        <TextBlock x:Name="LapMinText"
                                   Text="--"
                                   FontSize="7"
                                   Foreground="#666666"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Bottom"
                                   Margin="2,0,0,1"/>
                        <TextBlock x:Name="LapMaxText"
                                   Text="--"
                                   FontSize="7"
                                   Foreground="#666666"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Margin="0,1,2,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================ -->
            <!-- CONSUMPTION SECTION (Rows 6-9) -->
            <!-- ============================================ -->
            
            <!-- Last Lap (with delta indicator) -->
            <Grid Grid.Row="6" x:Name="LastLapGrid" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="LAST"
                           FontSize="10"
                           FontWeight="Normal"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           x:Name="LastLapTrendArrow"
                           Text=""
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,6,0"
                           Visibility="Collapsed"/>

                <TextBlock Grid.Column="2"
                           x:Name="LastLapText"
                           Text="--"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#666666"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- L5 Average -->
            <Grid Grid.Row="7" x:Name="L5Grid" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="L5"
                           FontSize="10"
                           FontWeight="Normal"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           x:Name="L5AvgText"
                           Text="--"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#666666"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- L10 Average (optional) -->
            <Grid Grid.Row="8" x:Name="L10Grid" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="L10"
                           FontSize="10"
                           FontWeight="Normal"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           x:Name="L10AvgText"
                           Text="--"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#666666"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- Session Average (optional) -->
            <Grid Grid.Row="9" x:Name="SessionGrid" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="SESSION"
                           FontSize="10"
                           FontWeight="Normal"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           x:Name="SessionAvgText"
                           Text="--"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#666666"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- ============================================ -->
            <!-- STRATEGY SECTION (Rows 11-12) -->
            <!-- ============================================ -->

            <!-- Laps Remaining -->
            <Grid Grid.Row="11" x:Name="LapsRemainingGrid" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="LAPS"
                           FontSize="10"
                           FontWeight="Normal"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           x:Name="LapsRemainingText"
                           Text="--"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#008080"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- Fuel Needed for Reference Distance (FUEL NEED) -->
            <Grid Grid.Row="12" x:Name="CanFinishGrid" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="FUEL NEED"
                           FontSize="10"
                           FontWeight="Normal"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           x:Name="CanFinishText"
                           Text="--"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#008080"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- ============================================ -->
            <!-- ADDITIONAL INFO SECTION (Rows 13-15) -->
            <!-- ============================================ -->

            <!-- Fuel Pressure (optional) -->
            <Grid Grid.Row="13" x:Name="PressureGrid" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="PRESS"
                           FontSize="10"
                           FontWeight="Normal"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           x:Name="PressureText"
                           Text="0.00 bar"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#008080"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- Pit Fuel Required (optional) -->
            <Grid Grid.Row="14" x:Name="PitFuelGrid" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="PitFuelLabel"
                           Text="ADD"
                           FontSize="10"
                           FontWeight="Normal"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           x:Name="PitFuelText"
                           Text="---"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#FF8000"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- Pit Window (laps until pit required) (optional) -->
            <Grid Grid.Row="15" x:Name="PitWindowGrid" Margin="0,2,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Main PIT WINDOW -->
                    <RowDefinition Height="Auto"/> <!-- Pit exit position -->
                    <RowDefinition Height="Auto"/> <!-- Pitting cars -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0: Main PIT WINDOW display -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="PIT WINDOW"
                           FontSize="10"
                           FontWeight="Normal"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="0" Grid.Column="1"
                           x:Name="PitWindowText"
                           Text="--"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#008080"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
                
                <!-- Row 1: Pit exit position (Option C format with confidence icon) -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           x:Name="PitExitPositionText"
                           Text="↳ Exit P12: 4s to #14, 10s from #9"
                           FontSize="9"
                           FontStyle="Italic"
                           Foreground="#888888"
                           Margin="10,2,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
                
                <!-- Row 2: Pitting cars (Option B format) -->
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                           x:Name="PittingCarsText"
                           Text="Pitting: #14, #23, #8"
                           FontSize="9"
                           FontStyle="Italic"
                           Foreground="#666666"
                           Margin="10,2,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- Phase 3: Fuel Saving Section -->
            
            <!-- Row 16: Separator (using row definition with Height="8") -->

            <!-- Row 17: Fuel Saving Header -->
            <TextBlock Grid.Row="17"
                       x:Name="FuelSavingHeader"
                       Text="💡 FUEL SAVING"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#FFA500"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"
                       Visibility="Collapsed"/>

            <!-- Row 18: Fuel Saving Target + Progress -->
            <Grid Grid.Row="18" x:Name="FuelSavingTargetGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Target line: SAVE: 0.25L/lap → Target: 1:45.2 -->
                <Grid Grid.Row="0" Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="SAVE:"
                               FontSize="9"
                               FontWeight="Normal"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="FuelSavingTargetText"
                                   Text="0.25L/lap"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#FF6B00"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <TextBlock Text="→"
                                   FontSize="10"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"
                                   Margin="0,0,3,0"/>
                        <TextBlock x:Name="TargetLapTimeText"
                                   Text="1:45.2"
                                   FontSize="10"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Progress bar -->
                <Border Grid.Row="1" 
                        Background="#222222"
                        CornerRadius="3"
                        Padding="1"
                        Height="8"
                        Margin="0,2,0,2">
                    <Grid>
                        <Rectangle Fill="#333333" RadiusX="2" RadiusY="2"/>
                        <Rectangle x:Name="SavingProgressBar"
                                   Fill="#4CAF50"
                                   RadiusX="2"
                                   RadiusY="2"
                                   HorizontalAlignment="Left"
                                   Width="0"/>
                    </Grid>
                </Border>

                <!-- Current saving rate + percentage -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Current:"
                               FontSize="9"
                               FontWeight="Normal"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="CurrentSavingRateText"
                                   Text="0.18L/lap"
                                   FontSize="10"
                                   Foreground="#4CAF50"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock x:Name="SavingProgressText"
                                   Text="(72%)"
                                   FontSize="9"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Row 20: Lift Points -->
            <Grid Grid.Row="19" x:Name="FuelSavingLiftGrid" Visibility="Collapsed" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="LIFT:"
                           FontSize="9"
                           FontWeight="Normal"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           x:Name="LiftPointsText"
                           Text="Fast corners, straights"
                           FontSize="9"
                           FontStyle="Italic"
                           Foreground="#FFA500"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           TextWrapping="Wrap"
                           TextAlignment="Right"/>
            </Grid>

            <!-- Row 20: Strategic Alert (color-coded, can blink) -->
            <Border Grid.Row="20" 
                    x:Name="StrategicAlertBorder"
                    Background="#1B5E20"
                    CornerRadius="4"
                    Padding="4,3"
                    Margin="0,3,0,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="StrategicAlertText"
                           Text="✅ FUEL SAVING WORKING"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </Border>

            <!-- Row 22: Optimal Pit Lap -->
            <Grid Grid.Row="21" x:Name="OptimalPitLapGrid" Visibility="Collapsed" Margin="0,3,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="OPTIMAL LAP:"
                               FontSize="9"
                               FontWeight="Normal"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               x:Name="OptimalPitLapText"
                               Text="Lap 28"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#00D9FF"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextWrapping="Wrap"
                               TextAlignment="Right"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           x:Name="OptimalPitReasonText"
                           Text="(maximize stint)"
                           FontSize="8"
                           FontStyle="Italic"
                           Foreground="#888888"
                           HorizontalAlignment="Right"
                           TextWrapping="Wrap"
                           TextAlignment="Right"
                           Margin="0,1,0,0"/>
            </Grid>
        </Grid>
    </Border>
</core:WidgetBase>
