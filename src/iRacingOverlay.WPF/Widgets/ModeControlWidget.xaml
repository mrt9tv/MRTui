<core:WidgetBase x:Class="iRacingOverlay.WPF.Widgets.ModeControlWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:iRacingOverlay.WPF.Core"
        Title="MRT Overlay - Mode Control"
        Width="320" Height="160"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None">
    <Window.Resources>
        <!-- Mode button style -->
        <Style x:Key="ModeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#E0000000" CornerRadius="10" BorderBrush="#40FFFFFF" BorderThickness="1">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="MRT OVERLAY" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="ModeIndicator" 
                           Text="🏁 DRIVING" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           Foreground="#00FF00" 
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- Mode Switch Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                <Button x:Name="SetupButton" 
                        Content="🔧 Setup" 
                        Style="{StaticResource ModeButtonStyle}"
                        Background="#80FF6B00"
                        BorderBrush="#FFFF6B00"
                        Foreground="White"
                        Click="SetupButton_Click"/>
                <Button x:Name="StrategyButton" 
                        Content="📊 Strategy" 
                        Style="{StaticResource ModeButtonStyle}"
                        Background="#800066FF"
                        BorderBrush="#FF0066FF"
                        Foreground="White"
                        Click="StrategyButton_Click"/>
                <Button x:Name="DrivingButton" 
                        Content="🏁 Drive" 
                        Style="{StaticResource ModeButtonStyle}"
                        Background="#8000AA00"
                        BorderBrush="#FF00AA00"
                        Foreground="White"
                        Click="DrivingButton_Click"/>
            </StackPanel>

            <!-- Session Info -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock x:Name="SessionInfo" 
                           Text="Session: Not Connected" 
                           FontSize="10" 
                           Foreground="#A0FFFFFF" 
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="SectorInfo" 
                           Text="Sector Learning: 0 tracks" 
                           FontSize="9" 
                           Foreground="#60FFFFFF" 
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</core:WidgetBase>
