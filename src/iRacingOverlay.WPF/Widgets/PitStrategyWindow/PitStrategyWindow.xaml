<Window x:Class="iRacingOverlay.WPF.Widgets.PitStrategyWindow.PitStrategyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pit Strategy"
        Width="800" Height="600"
        MinWidth="600" MinHeight="400"
        Background="#CC000000"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Style for section headers -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#00D9FF"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Style for data labels -->
        <Style x:Key="DataLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Style for data values -->
        <Style x:Key="DataValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Style for lap timeline items -->
        <Style x:Key="LapItemStyle" TargetType="Border">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#404040"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#00D9FF" BorderThickness="2" CornerRadius="8">
        <Grid Margin="10">
            <!-- Window Header with Close Button -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="#1A1A1A" Margin="-10,-10,-10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="⛽ PIT STRATEGY" 
                          FontSize="16" FontWeight="Bold" 
                          Foreground="#00D9FF"
                          VerticalAlignment="Center"
                          Margin="10,8"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                <Button Grid.Column="1" Content="✕" 
                       FontSize="16" FontWeight="Bold"
                       Width="30" Height="30"
                       Background="Transparent"
                       Foreground="#A0A0A0"
                       BorderThickness="0"
                       Cursor="Hand"
                       Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF4444"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Main Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <StackPanel>
                    <!-- Current Strategy Summary -->
                    <Border Background="#1A1A1A" Padding="12" CornerRadius="6" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Current Lap -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CURRENT LAP" Style="{StaticResource DataLabelStyle}"/>
                                <TextBlock x:Name="CurrentLapText" Text="12 / 45" 
                                          Style="{StaticResource DataValueStyle}" FontSize="18"/>
                            </StackPanel>

                            <!-- Fuel Remaining -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="FUEL REMAINING" Style="{StaticResource DataLabelStyle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="FuelRemainingText" Text="8.5L" 
                                              Style="{StaticResource DataValueStyle}" FontSize="18"/>
                                    <TextBlock x:Name="LapsRemainingText" Text="(15.3 laps)" 
                                              Style="{StaticResource DataLabelStyle}" 
                                              FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Optimal Pit Lap -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="OPTIMAL PIT" Style="{StaticResource DataLabelStyle}"/>
                                <TextBlock x:Name="OptimalPitText" Text="Lap 28" 
                                          Style="{StaticResource DataValueStyle}" FontSize="18"/>
                                <TextBlock x:Name="OptimalPitReasonText" Text="Maximize stint length" 
                                          Style="{StaticResource DataLabelStyle}" FontSize="10"/>
                            </StackPanel>

                            <!-- Track Position -->
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="POSITION" Style="{StaticResource DataLabelStyle}"/>
                                <TextBlock x:Name="PositionText" Text="P8 / 24" 
                                          Style="{StaticResource DataValueStyle}" FontSize="18"/>
                                <TextBlock x:Name="PositionCostText" Text="(15s pit cost)" 
                                          Style="{StaticResource DataLabelStyle}" FontSize="10"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Pit Window Visualization -->
                    <Border Background="#1A1A1A" Padding="12" CornerRadius="6" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="PIT WINDOW" Style="{StaticResource SectionHeaderStyle}"/>
                            
                            <!-- Visual pit window bar -->
                            <Border Background="#222222" Height="40" CornerRadius="4" Margin="0,0,0,8">
                                <Grid>
                                    <!-- Earliest marker (left edge of green zone) -->
                                    <Line x:Name="EarliestLine"
                                         X1="0" Y1="0" X2="0" Y2="40"
                                         Stroke="#FFB300"
                                         StrokeThickness="2"
                                         HorizontalAlignment="Left"/>
                                    
                                    <!-- Green optimal window -->
                                    <Rectangle x:Name="OptimalWindowRect"
                                              Fill="#4CAF50"
                                              Opacity="0.4"
                                              HorizontalAlignment="Left"
                                              Margin="0"/>
                                    
                                    <!-- Latest marker (right edge of green zone) -->
                                    <Line x:Name="LatestLine"
                                         X1="0" Y1="0" X2="0" Y2="40"
                                         Stroke="#FF5722"
                                         StrokeThickness="2"
                                         HorizontalAlignment="Left"/>
                                    
                                    <!-- Current lap indicator -->
                                    <Line x:Name="CurrentLapLine"
                                         X1="0" Y1="0" X2="0" Y2="40"
                                         Stroke="#00D9FF"
                                         StrokeThickness="3"
                                         HorizontalAlignment="Left"/>
                                    
                                    <!-- Optimal pit lap marker -->
                                    <Ellipse x:Name="OptimalPitMarker"
                                            Width="12" Height="12"
                                            Fill="#4CAF50"
                                            Stroke="White"
                                            StrokeThickness="2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"/>
                                    
                                    <!-- Lap labels -->
                                    <TextBlock x:Name="EarliestLapLabel" 
                                              Text="L20"
                                              FontSize="9" Foreground="#FFB300"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Top"
                                              Margin="2,2,0,0"/>
                                    
                                    <TextBlock x:Name="OptimalLapLabel" 
                                              Text="L28"
                                              FontSize="11" FontWeight="Bold" Foreground="White"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    
                                    <TextBlock x:Name="LatestLapLabel" 
                                              Text="L35"
                                              FontSize="9" Foreground="#FF5722"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Top"
                                              Margin="2,2,0,0"/>
                                    
                                    <TextBlock x:Name="CurrentLapLabel" 
                                              Text="NOW: L12"
                                              FontSize="10" FontWeight="Bold" Foreground="#00D9FF"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Bottom"
                                              Margin="2,0,0,2"/>
                                </Grid>
                            </Border>
                            
                            <!-- Pit window legend and delta estimation -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Legend -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="#FFB300" Margin="0,0,4,0"/>
                                    <TextBlock Text="Earliest" Style="{StaticResource DataLabelStyle}" FontSize="10" Margin="0,0,12,0"/>
                                    
                                    <Rectangle Width="16" Height="10" Fill="#4CAF50" Opacity="0.6" Margin="0,0,4,0"/>
                                    <TextBlock Text="Optimal Window" Style="{StaticResource DataLabelStyle}" FontSize="10" Margin="0,0,12,0"/>
                                    
                                    <Ellipse Width="10" Height="10" Fill="#FF5722" Margin="0,0,4,0"/>
                                    <TextBlock Text="Latest" Style="{StaticResource DataLabelStyle}" FontSize="10" Margin="0,0,12,0"/>
                                    
                                    <Line X1="0" Y1="0" X2="0" Y2="10" Stroke="#00D9FF" StrokeThickness="3" Margin="0,0,4,0"/>
                                    <TextBlock Text="Current" Style="{StaticResource DataLabelStyle}" FontSize="10"/>
                                </StackPanel>
                                
                                <!-- Pit Delta Estimation -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="Pit Now vs +5 laps:" Style="{StaticResource DataLabelStyle}" FontSize="10" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="PitDeltaText" Text="+8.5s" 
                                              Style="{StaticResource DataValueStyle}" FontSize="12" Foreground="#4CAF50"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Multi-Stint Timeline -->
                    <Border Background="#1A1A1A" Padding="12" CornerRadius="6" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="RACE TIMELINE" Style="{StaticResource SectionHeaderStyle}"/>
                            
                            <!-- Timeline ScrollViewer -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="TimelineItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource LapItemStyle}"
                                                   Background="{Binding Background}"
                                                   Width="{Binding Width}"
                                                   ToolTip="{Binding Tooltip}">
                                                <Grid>
                                                    <TextBlock Text="{Binding LapNumber}" 
                                                              FontSize="10" 
                                                              Foreground="White"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                    <!-- Pit Stop Marker -->
                                                    <Path Data="M 0,0 L 8,10 L 16,0 Z" 
                                                         Fill="#FF6B00"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Top"
                                                         Visibility="{Binding IsPitStop, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Timeline Legend -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Width="16" Height="16" Background="#4CAF50" Margin="0,0,6,0"/>
                                <TextBlock Text="Current Stint" Style="{StaticResource DataLabelStyle}" Margin="0,0,16,0"/>
                                
                                <Border Width="16" Height="16" Background="#2196F3" Margin="0,0,6,0"/>
                                <TextBlock Text="Projected" Style="{StaticResource DataLabelStyle}" Margin="0,0,16,0"/>
                                
                                <Border Width="16" Height="16" Background="#FFC107" Margin="0,0,6,0"/>
                                <TextBlock Text="Yellow Flag" Style="{StaticResource DataLabelStyle}" Margin="0,0,16,0"/>
                                
                                <Path Data="M 0,0 L 8,10 L 16,0 Z" Fill="#FF6B00" 
                                     Width="16" Height="10" Stretch="Fill" Margin="0,3,6,3"/>
                                <TextBlock Text="Pit Stop" Style="{StaticResource DataLabelStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- What-If Scenario Calculator -->
                    <Border Background="#1A1A1A" Padding="12" CornerRadius="6" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="WHAT-IF SCENARIOS" Style="{StaticResource SectionHeaderStyle}"/>
                            
                            <!-- Buffer Laps Slider -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="Buffer Laps:" 
                                          Style="{StaticResource DataLabelStyle}" 
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Slider Grid.Column="1" x:Name="BufferLapsSlider"
                                       Minimum="0.5" Maximum="3.0" Value="1.5" 
                                       TickFrequency="0.5" IsSnapToTickEnabled="True"
                                       VerticalAlignment="Center"
                                       ValueChanged="BufferLapsSlider_ValueChanged"/>
                                <TextBlock Grid.Column="2" x:Name="BufferLapsText" Text="1.5" 
                                          Style="{StaticResource DataValueStyle}" 
                                          VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>

                            <!-- Strategy Comparison Grid -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 1-Stop Strategy -->
                                <Border Grid.Column="0" Background="#0D1F2D" Padding="10" 
                                       CornerRadius="6" Margin="0,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="1-STOP STRATEGY" 
                                                  FontSize="14" FontWeight="Bold" 
                                                  Foreground="#00D9FF" Margin="0,0,0,8"/>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Pit Lap:" Style="{StaticResource DataLabelStyle}"/>
                                            <TextBlock x:Name="OneStopPitLapText" Text="28" 
                                                      Style="{StaticResource DataValueStyle}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Fuel:" Style="{StaticResource DataLabelStyle}"/>
                                            <TextBlock x:Name="OneStopFuelText" Text="18.5L" 
                                                      Style="{StaticResource DataValueStyle}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Time Loss:" Style="{StaticResource DataLabelStyle}"/>
                                            <TextBlock x:Name="OneStopTimeText" Text="~45s" 
                                                      Style="{StaticResource DataValueStyle}"/>
                                        </StackPanel>
                                        
                                        <Border x:Name="OneStopRecommended" 
                                               Background="#1B5E20" Padding="4" 
                                               CornerRadius="4" Margin="0,8,0,0"
                                               Visibility="Collapsed">
                                            <TextBlock Text="✓ RECOMMENDED" 
                                                      FontSize="11" FontWeight="Bold" 
                                                      Foreground="#4CAF50" 
                                                      HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 2-Stop Strategy -->
                                <Border Grid.Column="1" Background="#0D1F2D" Padding="10" 
                                       CornerRadius="6" Margin="3,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="2-STOP STRATEGY" 
                                                  FontSize="14" FontWeight="Bold" 
                                                  Foreground="#00D9FF" Margin="0,0,0,8"/>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Pit Laps:" Style="{StaticResource DataLabelStyle}"/>
                                            <TextBlock x:Name="TwoStopPitLapsText" Text="18, 36" 
                                                      Style="{StaticResource DataValueStyle}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Fuel Each:" Style="{StaticResource DataLabelStyle}"/>
                                            <TextBlock x:Name="TwoStopFuelText" Text="10.5L" 
                                                      Style="{StaticResource DataValueStyle}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Time Loss:" Style="{StaticResource DataLabelStyle}"/>
                                            <TextBlock x:Name="TwoStopTimeText" Text="~90s" 
                                                      Style="{StaticResource DataValueStyle}"/>
                                        </StackPanel>
                                        
                                        <Border x:Name="TwoStopRecommended" 
                                               Background="#1B5E20" Padding="4" 
                                               CornerRadius="4" Margin="0,8,0,0"
                                               Visibility="Collapsed">
                                            <TextBlock Text="✓ RECOMMENDED" 
                                                      FontSize="11" FontWeight="Bold" 
                                                      Foreground="#4CAF50" 
                                                      HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 3-Stop Strategy -->
                                <Border Grid.Column="2" Background="#0D1F2D" Padding="10" 
                                       CornerRadius="6" Margin="3,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="3-STOP STRATEGY" 
                                                  FontSize="14" FontWeight="Bold" 
                                                  Foreground="#00D9FF" Margin="0,0,0,8"/>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Pit Laps:" Style="{StaticResource DataLabelStyle}"/>
                                            <TextBlock x:Name="ThreeStopPitLapsText" Text="12, 24, 36" 
                                                      Style="{StaticResource DataValueStyle}" FontSize="12"/>
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Fuel Each:" Style="{StaticResource DataLabelStyle}"/>
                                            <TextBlock x:Name="ThreeStopFuelText" Text="7.2L" 
                                                      Style="{StaticResource DataValueStyle}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Time Loss:" Style="{StaticResource DataLabelStyle}"/>
                                            <TextBlock x:Name="ThreeStopTimeText" Text="~135s" 
                                                      Style="{StaticResource DataValueStyle}"/>
                                        </StackPanel>
                                        
                                        <Border x:Name="ThreeStopRecommended" 
                                               Background="#1B5E20" Padding="4" 
                                               CornerRadius="4" Margin="0,8,0,0"
                                               Visibility="Collapsed">
                                            <TextBlock Text="✓ RECOMMENDED" 
                                                      FontSize="11" FontWeight="Bold" 
                                                      Foreground="#4CAF50" 
                                                      HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            
                            <!-- Undercut/Overcut Strategy Recommendations -->
                            <Border Background="#0F1F2D" Padding="10" CornerRadius="6" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="POSITION STRATEGY" 
                                              FontSize="12" FontWeight="Bold" 
                                              Foreground="#FFB300" Margin="0,0,0,6"/>
                                    
                                    <TextBlock x:Name="UndercutText" Text="UNDERCUT: Pit 2 laps before P7 for fresh tire advantage" 
                                              Style="{StaticResource DataLabelStyle}" FontSize="11" 
                                              Foreground="White" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    
                                    <TextBlock x:Name="OvercutText" Text="OVERCUT: Stay out 3 laps longer than leaders for track position" 
                                              Style="{StaticResource DataLabelStyle}" FontSize="11" 
                                              Foreground="White" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Lap Time Projections -->
                    <Border Background="#1A1A1A" Padding="12" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="LAP TIME PROJECTIONS" Style="{StaticResource SectionHeaderStyle}"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Stint 1 -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="STINT 1 (Laps 1-28)" 
                                              Style="{StaticResource DataLabelStyle}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="Stint1AvgTimeText" Text="1:45.2" 
                                              Style="{StaticResource DataValueStyle}"/>
                                    <TextBlock Text="Avg. lap time" 
                                              Style="{StaticResource DataLabelStyle}" FontSize="10"/>
                                </StackPanel>

                                <!-- Stint 2 -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="STINT 2 (Laps 29-45)" 
                                              Style="{StaticResource DataLabelStyle}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="Stint2AvgTimeText" Text="1:44.8" 
                                              Style="{StaticResource DataValueStyle}"/>
                                    <TextBlock Text="Avg. lap time (lighter fuel)" 
                                              Style="{StaticResource DataLabelStyle}" FontSize="10"/>
                                </StackPanel>

                                <!-- Total Race Time -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TOTAL RACE TIME" 
                                              Style="{StaticResource DataLabelStyle}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TotalRaceTimeText" Text="1:19:45" 
                                              Style="{StaticResource DataValueStyle}"/>
                                    <TextBlock x:Name="TimeMarginText" Text="(+2:15 to session end)" 
                                              Style="{StaticResource DataLabelStyle}" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
