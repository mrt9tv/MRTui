<Window x:Class="iRacingOverlay.WPF.Widgets.RaceStrategy.RaceStrategyWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:iRacingOverlay.WPF.Controls"
        Title="Race Strategy"
        Width="800" Height="600"
        MinWidth="600" MinHeight="400"
        Background="#1A1A1A"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    
    <!-- Window Resources -->
    <Window.Resources>
        <!-- Brushes -->
        <SolidColorBrush x:Key="BrushTeal" Color="#008080"/>
        <SolidColorBrush x:Key="BrushOrange" Color="#FF8000"/>
        <SolidColorBrush x:Key="BrushRed" Color="#FF3333"/>
        <SolidColorBrush x:Key="BrushGreen" Color="#4CAF50"/>
        <SolidColorBrush x:Key="BrushGray" Color="#666666"/>
        <SolidColorBrush x:Key="BrushBackground" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="BrushBorder" Color="#333333"/>
        <SolidColorBrush x:Key="BrushHeaderBackground" Color="#252525"/>
    </Window.Resources>
    
    <!-- Main Border with Drop Shadow -->
    <Border Background="{StaticResource BrushBackground}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="2"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                            Direction="315" 
                            ShadowDepth="5" 
                            BlurRadius="15" 
                            Opacity="0.8"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/> <!-- Header -->
                <RowDefinition Height="*"/>  <!-- Content -->
            </Grid.RowDefinitions>
            
            <!-- Header with Title and Controls -->
            <Grid Grid.Row="0" 
                  Background="{StaticResource BrushHeaderBackground}"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Title -->
                <StackPanel Grid.Column="0" 
                           Orientation="Horizontal" 
                           VerticalAlignment="Center"
                           Margin="15,0,0,0">
                    <TextBlock Text="🏁" 
                              FontSize="18" 
                              Margin="0,0,10,0"/>
                    <TextBlock Text="RACE STRATEGY" 
                              FontSize="16" 
                              FontWeight="Bold" 
                              Foreground="{StaticResource BrushTeal}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText"
                              Text="● Active"
                              FontSize="11"
                              Foreground="{StaticResource BrushGreen}"
                              Margin="15,0,0,0"
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Close Button -->
                <Button Grid.Column="1"
                       x:Name="CloseButton"
                       Content="✕"
                       Width="40" Height="40"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="#AAAAAA"
                       FontSize="18"
                       FontWeight="Bold"
                       Click="CloseButton_Click"
                       Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF3333"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            
            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Status Bar -->
                    <RowDefinition Height="*"/>    <!-- Strategy Content -->
                    <RowDefinition Height="Auto"/> <!-- Footer -->
                </Grid.RowDefinitions>
                
                <!-- Status Bar with Current Situation -->
                <Border Grid.Row="0" 
                       Background="#252525" 
                       BorderBrush="{StaticResource BrushBorder}"
                       BorderThickness="1"
                       CornerRadius="4"
                       Padding="10"
                       Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Current Lap -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="LAP" 
                                      FontSize="10" 
                                      Foreground="#888888"
                                      HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CurrentLapText" 
                                      Text="5 / 45"
                                      FontSize="18"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource BrushTeal}"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Position -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="POSITION" 
                                      FontSize="10" 
                                      Foreground="#888888"
                                      HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PositionText" 
                                      Text="P3"
                                      FontSize="18"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource BrushOrange}"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Fuel Remaining -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="FUEL" 
                                      FontSize="10" 
                                      Foreground="#888888"
                                      HorizontalAlignment="Center"/>
                            <TextBlock x:Name="FuelRemainingText" 
                                      Text="45.3L"
                                      FontSize="18"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource BrushGreen}"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Tire Life -->
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="TIRES" 
                                      FontSize="10" 
                                      Foreground="#888888"
                                      HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TireLifeText" 
                                      Text="65%"
                                      FontSize="18"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource BrushTeal}"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Strategy Content -->
                <TabControl Grid.Row="1" 
                           Background="Transparent"
                           BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="#252525"/>
                            <Setter Property="Foreground" Value="#AAAAAA"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="15,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Border"
                                               Background="{TemplateBinding Background}"
                                               BorderBrush="{StaticResource BrushBorder}"
                                               BorderThickness="1,1,1,0"
                                               CornerRadius="4,4,0,0"
                                               Margin="2,0,2,0">
                                            <ContentPresenter x:Name="ContentSite"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            ContentSource="Header"
                                                            Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BrushHeaderBackground}"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushTeal}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#2A2A2A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    
                    <!-- Tab 1: Overview -->
                    <TabItem Header="OVERVIEW">
                        <Grid Background="#1E1E1E" Margin="0,5,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Strategy Summary -->
                            <ScrollViewer Grid.Row="0" 
                                        VerticalScrollBarVisibility="Auto"
                                        Margin="10">
                                <StackPanel>
                                    <TextBlock Text="Current Strategy" 
                                              FontSize="16" 
                                              FontWeight="Bold"
                                              Foreground="{StaticResource BrushTeal}"
                                              Margin="0,0,0,10"/>
                                    
                                    <Border Background="#252525" 
                                           BorderBrush="{StaticResource BrushBorder}"
                                           BorderThickness="1"
                                           CornerRadius="4"
                                           Padding="15"
                                           Margin="0,0,0,15">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                                      Text="Pit Window:" 
                                                      Foreground="#AAAAAA" 
                                                      Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                                      x:Name="PitWindowOverviewText"
                                                      Text="L12-16 (opt L14)"
                                                      Foreground="{StaticResource BrushTeal}"
                                                      FontWeight="Bold"
                                                      Margin="0,0,0,8"/>
                                            
                                            <TextBlock Grid.Row="1" Grid.Column="0" 
                                                      Text="Laps on Fuel:" 
                                                      Foreground="#AAAAAA" 
                                                      Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                                      x:Name="LapsOnFuelText"
                                                      Text="18 laps"
                                                      Foreground="{StaticResource BrushTeal}"
                                                      FontWeight="Bold"
                                                      Margin="0,0,0,8"
                                                      ToolTip="Laps you can complete on current fuel (driver capacity)"/>
                                            
                                            <TextBlock Grid.Row="2" Grid.Column="0" 
                                                      Text="Fuel at Pit:" 
                                                      Foreground="#AAAAAA" 
                                                      Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" 
                                                      x:Name="FuelAtPitText"
                                                      Text="Add 32.5L"
                                                      Foreground="{StaticResource BrushOrange}"
                                                      FontWeight="Bold"
                                                      Margin="0,0,0,8"/>
                                            
                                            <TextBlock Grid.Row="3" Grid.Column="0" 
                                                      Text="Strategy:" 
                                                      Foreground="#AAAAAA"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" 
                                                      x:Name="StrategyDescriptionText"
                                                      Text="1-stop optimal (10.2s faster than 2-stop)"
                                                      Foreground="{StaticResource BrushGreen}"
                                                      FontWeight="Bold"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Gap to Leader (Phase 10.6: Competitor Intelligence) -->
                                    <Border Background="#252525" 
                                           BorderBrush="{StaticResource BrushOrange}"
                                           BorderThickness="2"
                                           CornerRadius="4"
                                           Padding="12"
                                           Margin="0,0,0,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                                <TextBlock Text="GAP TO LEADER" 
                                                          FontSize="10" 
                                                          Foreground="#888888"
                                                          Margin="0,0,0,5"/>
                                                <TextBlock x:Name="GapToLeaderText"
                                                          Text="+ 12.4s"
                                                          FontSize="28"
                                                          FontWeight="Bold"
                                                          Foreground="{StaticResource BrushOrange}"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="LeaderNameText"
                                                          Text="P1: Lewis Hamilton"
                                                          FontSize="13"
                                                          FontWeight="Bold"
                                                          Foreground="{StaticResource BrushTeal}"
                                                          Margin="0,0,0,3"/>
                                                <TextBlock x:Name="LeaderLastLapText"
                                                          Text="Last lap: 1:24.532"
                                                          FontSize="11"
                                                          Foreground="#AAAAAA"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Multi-Stint Timeline (Phase 10.2) -->
                                    <TextBlock Text="Race Timeline" 
                                              FontSize="14" 
                                              FontWeight="Bold"
                                              Foreground="{StaticResource BrushTeal}"
                                              Margin="0,20,0,10"/>
                                    
                                    <controls:StintTimelineControl x:Name="StintTimeline"
                                                                  Height="200"
                                                                  Margin="0,0,0,15"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    
                    <!-- Tab 2: Scenarios -->
                    <TabItem Header="SCENARIOS">
                        <Grid Background="#1E1E1E" Margin="0,5,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                                <StackPanel>
                                    <!-- Header -->
                                    <TextBlock Text="Strategy Comparison" 
                                              FontSize="16" 
                                              FontWeight="Bold"
                                              Foreground="{StaticResource BrushTeal}"
                                              Margin="0,0,0,15"/>
                                    
                                    <!-- Description -->
                                    <TextBlock Text="Compare different pit strategies to find the optimal approach. Times shown are estimates based on current pace and fuel usage."
                                              FontSize="11"
                                              Foreground="#AAAAAA"
                                              TextWrapping="Wrap"
                                              Margin="0,0,0,20"/>
                                    
                                    <!-- Scenario Cards Grid -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- No-Stop Strategy -->
                                        <Border x:Name="NoStopBorder"
                                               Grid.Row="0"
                                               Background="#252525"
                                               BorderBrush="{StaticResource BrushBorder}"
                                               BorderThickness="2"
                                               CornerRadius="4"
                                               Padding="15">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Header -->
                                                <Grid Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🏁 " FontSize="16" VerticalAlignment="Center"/>
                                                        <TextBlock Text="NO-STOP" 
                                                                  FontSize="14" 
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource BrushTeal}"/>
                                                        <TextBlock x:Name="NoStopBadge"
                                                                  Text="CURRENT"
                                                                  FontSize="9"
                                                                  FontWeight="Bold"
                                                                  Foreground="#1A1A1A"
                                                                  Background="{StaticResource BrushGreen}"
                                                                  Padding="4,2"
                                                                  Margin="10,0,0,0"
                                                                  Visibility="Collapsed"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="NoStopTime"
                                                              Text="+ 0.0s"
                                                              FontSize="18"
                                                              FontWeight="Bold"
                                                              Foreground="{StaticResource BrushGreen}"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"/>
                                                </Grid>
                                                
                                                <!-- Details -->
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="PIT STOPS" FontSize="9" Foreground="#888888"/>
                                                        <TextBlock Text="0" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="FUEL SAVING" FontSize="9" Foreground="#888888"/>
                                                        <TextBlock x:Name="NoStopFuelSaving" Text="Required: 0.5L/lap" FontSize="11" Foreground="{StaticResource BrushOrange}"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="FEASIBILITY" FontSize="9" Foreground="#888888"/>
                                                        <TextBlock x:Name="NoStopFeasibility" Text="Possible" FontSize="11" Foreground="{StaticResource BrushGreen}" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Grid>
                                                
                                                <!-- Notes -->
                                                <TextBlock Grid.Row="4" 
                                                          x:Name="NoStopNotes"
                                                          Text="Requires careful fuel management and consistent pace."
                                                          FontSize="10"
                                                          Foreground="#888888"
                                                          FontStyle="Italic"
                                                          TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                        
                                        <!-- 1-Stop Strategy -->
                                        <Border x:Name="OneStopBorder"
                                               Grid.Row="2"
                                               Background="#252525"
                                               BorderBrush="{StaticResource BrushTeal}"
                                               BorderThickness="2"
                                               CornerRadius="4"
                                               Padding="15">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Header -->
                                                <Grid Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⛽ " FontSize="16" VerticalAlignment="Center"/>
                                                        <TextBlock Text="1-STOP" 
                                                                  FontSize="14" 
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource BrushTeal}"/>
                                                        <TextBlock x:Name="OneStopBadge"
                                                                  Text="OPTIMAL"
                                                                  FontSize="9"
                                                                  FontWeight="Bold"
                                                                  Foreground="#1A1A1A"
                                                                  Background="{StaticResource BrushTeal}"
                                                                  Padding="4,2"
                                                                  Margin="10,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="OneStopTime"
                                                              Text="+ 0.0s"
                                                              FontSize="18"
                                                              FontWeight="Bold"
                                                              Foreground="{StaticResource BrushTeal}"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"/>
                                                </Grid>
                                                
                                                <!-- Details -->
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="PIT LAP" FontSize="9" Foreground="#888888"/>
                                                        <TextBlock x:Name="OneStopLap" Text="L14" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="FUEL TO ADD" FontSize="9" Foreground="#888888"/>
                                                        <TextBlock x:Name="OneStopFuel" Text="32.5L" FontSize="11" Foreground="{StaticResource BrushOrange}"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="PIT TIME" FontSize="9" Foreground="#888888"/>
                                                        <TextBlock x:Name="OneStopPitTime" Text="45.0s" FontSize="11" Foreground="#AAAAAA"/>
                                                    </StackPanel>
                                                </Grid>
                                                
                                                <!-- Notes -->
                                                <TextBlock Grid.Row="4" 
                                                          x:Name="OneStopNotes"
                                                          Text="Best balance of speed and consistency. Minimal fuel saving required."
                                                          FontSize="10"
                                                          Foreground="#888888"
                                                          FontStyle="Italic"
                                                          TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                        
                                        <!-- 2-Stop Strategy -->
                                        <Border x:Name="TwoStopBorder"
                                               Grid.Row="4"
                                               Background="#252525"
                                               BorderBrush="{StaticResource BrushBorder}"
                                               BorderThickness="2"
                                               CornerRadius="4"
                                               Padding="15">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Header -->
                                                <Grid Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⛽⛽ " FontSize="16" VerticalAlignment="Center"/>
                                                        <TextBlock Text="2-STOP" 
                                                                  FontSize="14" 
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource BrushOrange}"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="TwoStopTime"
                                                              Text="+ 15.3s"
                                                              FontSize="18"
                                                              FontWeight="Bold"
                                                              Foreground="{StaticResource BrushOrange}"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"/>
                                                </Grid>
                                                
                                                <!-- Details -->
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="PIT LAPS" FontSize="9" Foreground="#888888"/>
                                                        <TextBlock x:Name="TwoStopLaps" Text="L10, L28" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="FUEL/STOP" FontSize="9" Foreground="#888888"/>
                                                        <TextBlock x:Name="TwoStopFuel" Text="18L each" FontSize="11" Foreground="{StaticResource BrushOrange}"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="TOTAL PIT TIME" FontSize="9" Foreground="#888888"/>
                                                        <TextBlock x:Name="TwoStopPitTime" Text="90.0s" FontSize="11" Foreground="#AAAAAA"/>
                                                    </StackPanel>
                                                </Grid>
                                                
                                                <!-- Notes -->
                                                <TextBlock Grid.Row="4" 
                                                          x:Name="TwoStopNotes"
                                                          Text="More flexibility but slower overall. Consider for tire management."
                                                          FontSize="10"
                                                          Foreground="#888888"
                                                          FontStyle="Italic"
                                                          TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                        
                                        <!-- 3-Stop Strategy -->
                                        <Border x:Name="ThreeStopBorder"
                                               Grid.Row="6"
                                               Background="#252525"
                                               BorderBrush="{StaticResource BrushBorder}"
                                               BorderThickness="2"
                                               CornerRadius="4"
                                               Padding="15">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Header -->
                                                <Grid Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⛽⛽⛽ " FontSize="16" VerticalAlignment="Center"/>
                                                        <TextBlock Text="3-STOP" 
                                                                  FontSize="14" 
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource BrushRed}"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="ThreeStopTime"
                                                              Text="+ 35.8s"
                                                              FontSize="18"
                                                              FontWeight="Bold"
                                                              Foreground="{StaticResource BrushRed}"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"/>
                                                </Grid>
                                                
                                                <!-- Details -->
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="PIT LAPS" FontSize="9" Foreground="#888888"/>
                                                        <TextBlock x:Name="ThreeStopLaps" Text="L8, L18, L32" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="FUEL/STOP" FontSize="9" Foreground="#888888"/>
                                                        <TextBlock x:Name="ThreeStopFuel" Text="12L each" FontSize="11" Foreground="{StaticResource BrushOrange}"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="TOTAL PIT TIME" FontSize="9" Foreground="#888888"/>
                                                        <TextBlock x:Name="ThreeStopPitTime" Text="135.0s" FontSize="11" Foreground="#AAAAAA"/>
                                                    </StackPanel>
                                                </Grid>
                                                
                                                <!-- Notes -->
                                                <TextBlock Grid.Row="4" 
                                                          x:Name="ThreeStopNotes"
                                                          Text="Not recommended for this race. Only viable with multiple cautions."
                                                          FontSize="10"
                                                          Foreground="#888888"
                                                          FontStyle="Italic"
                                                          TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    
                                    <!-- Assumptions Footer -->
                                    <Border Background="#1A1A1A"
                                           BorderBrush="{StaticResource BrushBorder}"
                                           BorderThickness="1"
                                           CornerRadius="4"
                                           Padding="12"
                                           Margin="0,20,0,0">
                                        <StackPanel>
                                            <TextBlock Text="⚙️ Calculation Assumptions"
                                                      FontSize="11"
                                                      FontWeight="Bold"
                                                      Foreground="{StaticResource BrushTeal}"
                                                      Margin="0,0,0,8"/>
                                            <TextBlock FontSize="10" Foreground="#888888" TextWrapping="Wrap">
                                                <Run Text="• Pit stop time: 45s base + fuel time (2.5s per 10L)"/><LineBreak/>
                                                <Run Text="• Current pace maintained throughout race"/><LineBreak/>
                                                <Run Text="• No yellow flags or incidents"/><LineBreak/>
                                                <Run Text="• Times update live as conditions change"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    
                    <!-- Tab 3: Position Tracking -->
                    <TabItem Header="POSITIONS">
                        <Grid Background="#1E1E1E" Margin="0,5,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                                <StackPanel>
                                    <!-- Header -->
                                    <TextBlock Text="Position Tracking" 
                                              FontSize="16" 
                                              FontWeight="Bold"
                                              Foreground="{StaticResource BrushTeal}"
                                              Margin="0,0,0,15"/>
                                    
                                    <!-- Current Position Summary -->
                                    <Border Background="#252525"
                                           BorderBrush="{StaticResource BrushTeal}"
                                           BorderThickness="2"
                                           CornerRadius="4"
                                           Padding="15"
                                           Margin="0,0,0,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Your Position -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="YOUR POSITION" 
                                                          FontSize="10" 
                                                          Foreground="#888888"
                                                          HorizontalAlignment="Center"
                                                          Margin="0,0,0,5"/>
                                                <TextBlock x:Name="YourPositionText"
                                                          Text="P3"
                                                          FontSize="32"
                                                          FontWeight="Bold"
                                                          Foreground="{StaticResource BrushTeal}"
                                                          HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="PositionChangeText"
                                                          Text="▲ 2 since start"
                                                          FontSize="11"
                                                          Foreground="{StaticResource BrushGreen}"
                                                          HorizontalAlignment="Center"
                                                          Margin="0,5,0,0"/>
                                            </StackPanel>
                                            
                                            <!-- Gap Ahead -->
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="GAP AHEAD" 
                                                          FontSize="10" 
                                                          Foreground="#888888"
                                                          HorizontalAlignment="Center"
                                                          Margin="0,0,0,5"/>
                                                <TextBlock x:Name="GapAheadText"
                                                          Text="2.4s"
                                                          FontSize="24"
                                                          FontWeight="Bold"
                                                          Foreground="{StaticResource BrushOrange}"
                                                          HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="CarAheadText"
                                                          Text="to P2: --"
                                                          FontSize="11"
                                                          Foreground="#AAAAAA"
                                                          HorizontalAlignment="Center"
                                                          Margin="0,5,0,0"/>
                                            </StackPanel>
                                            
                                            <!-- Gap Behind -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="GAP BEHIND" 
                                                          FontSize="10" 
                                                          Foreground="#888888"
                                                          HorizontalAlignment="Center"
                                                          Margin="0,0,0,5"/>
                                                <TextBlock x:Name="GapBehindText"
                                                          Text="3.8s"
                                                          FontSize="24"
                                                          FontWeight="Bold"
                                                          Foreground="{StaticResource BrushGreen}"
                                                          HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="CarBehindText"
                                                          Text="to P4: --"
                                                          FontSize="11"
                                                          Foreground="#AAAAAA"
                                                          HorizontalAlignment="Center"
                                                          Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Pit Strategy Impact -->
                                    <TextBlock Text="Pit Strategy Impact" 
                                              FontSize="14" 
                                              FontWeight="Bold"
                                              Foreground="{StaticResource BrushTeal}"
                                              Margin="0,10,0,10"/>
                                    
                                    <Border Background="#252525"
                                           BorderBrush="{StaticResource BrushBorder}"
                                           BorderThickness="1"
                                           CornerRadius="4"
                                           Padding="15"
                                           Margin="0,0,0,15">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- If You Pit Now -->
                                            <Grid Grid.Row="0">
                                                <TextBlock Text="If you pit now:"
                                                          FontSize="12"
                                                          Foreground="#AAAAAA"
                                                          VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="Estimated exit: "
                                                              FontSize="12"
                                                              Foreground="#888888"/>
                                                    <TextBlock x:Name="PitNowPositionText"
                                                              Text="P5"
                                                              FontSize="14"
                                                              FontWeight="Bold"
                                                              Foreground="{StaticResource BrushRed}"/>
                                                    <TextBlock x:Name="PitNowChangeText"
                                                              Text=" (▼ 2)"
                                                              FontSize="12"
                                                              Foreground="{StaticResource BrushRed}"
                                                              Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            
                                            <!-- If You Pit at Optimal Lap -->
                                            <Grid Grid.Row="2">
                                                <TextBlock x:Name="OptimalPitLapLabel"
                                                          Text="If you pit at lap 14:"
                                                          FontSize="12"
                                                          Foreground="#AAAAAA"
                                                          VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="Estimated exit: "
                                                              FontSize="12"
                                                              Foreground="#888888"/>
                                                    <TextBlock x:Name="OptimalPitPositionText"
                                                              Text="P3"
                                                              FontSize="14"
                                                              FontWeight="Bold"
                                                              Foreground="{StaticResource BrushGreen}"/>
                                                    <TextBlock x:Name="OptimalPitChangeText"
                                                              Text=" (same)"
                                                              FontSize="12"
                                                              Foreground="{StaticResource BrushGreen}"
                                                              Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            
                                            <!-- Undercut/Overcut Opportunities -->
                                            <Border Grid.Row="4"
                                                   Background="#1A1A1A"
                                                   BorderBrush="{StaticResource BrushBorder}"
                                                   BorderThickness="1"
                                                   CornerRadius="3"
                                                   Padding="10">
                                                <StackPanel>
                                                    <TextBlock Text="💡 Strategic Note"
                                                              FontSize="11"
                                                              FontWeight="Bold"
                                                              Foreground="{StaticResource BrushTeal}"
                                                              Margin="0,0,0,5"/>
                                                    <TextBlock x:Name="StrategicNoteText"
                                                              Text="Calculating position predictions..."
                                                              FontSize="10"
                                                              Foreground="#AAAAAA"
                                                              TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Recent Pit Activity (Phase 10.6: Competitor Intelligence) -->
                                    <TextBlock Text="Recent Pit Activity" 
                                              FontSize="14" 
                                              FontWeight="Bold"
                                              Foreground="{StaticResource BrushTeal}"
                                              Margin="0,20,0,10"/>
                                    
                                    <Border Background="#252525"
                                           BorderBrush="{StaticResource BrushBorder}"
                                           BorderThickness="1"
                                           CornerRadius="4"
                                           Padding="10"
                                           MaxHeight="200">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="RecentPitActivityList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1A1A1A"
                                                               BorderBrush="{StaticResource BrushBorder}"
                                                               BorderThickness="1"
                                                               CornerRadius="3"
                                                               Padding="10"
                                                               Margin="0,0,0,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                
                                                                <!-- Position Badge -->
                                                                <Border Grid.Column="0"
                                                                       Background="{StaticResource BrushOrange}"
                                                                       CornerRadius="3"
                                                                       Padding="5,2"
                                                                       Margin="0,0,10,0">
                                                                    <TextBlock Text="{Binding Position, StringFormat='P{0}'}"
                                                                              FontSize="11"
                                                                              FontWeight="Bold"
                                                                              Foreground="Black"/>
                                                                </Border>
                                                                
                                                                <!-- Driver Info -->
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding DriverName}"
                                                                              FontSize="12"
                                                                              FontWeight="Bold"
                                                                              Foreground="White"/>
                                                                    <TextBlock FontSize="10" Foreground="#AAAAAA">
                                                                        <Run Text="Car #"/><Run Text="{Binding CarNumber}"/>
                                                                        <Run Text=" • "/><Run Text="{Binding Status}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                
                                                                <!-- Lap Badge -->
                                                                <Border Grid.Column="2"
                                                                       Background="#333333"
                                                                       CornerRadius="3"
                                                                       Padding="8,4"
                                                                       Margin="10,0,0,0">
                                                                    <TextBlock Text="{Binding PitLap, StringFormat='L{0}'}"
                                                                              FontSize="11"
                                                                              Foreground="{StaticResource BrushTeal}"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    
                                    <!-- Lap Time Comparison (Phase 10.6: Competitor Intelligence) -->
                                    <TextBlock Text="Lap Time Comparison" 
                                              FontSize="14" 
                                              FontWeight="Bold"
                                              Foreground="{StaticResource BrushTeal}"
                                              Margin="0,20,0,10"/>
                                    
                                    <Border Background="#252525"
                                           BorderBrush="{StaticResource BrushBorder}"
                                           BorderThickness="1"
                                           CornerRadius="4"
                                           Padding="10"
                                           MaxHeight="250">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="LapTimeComparisonList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1A1A1A"
                                                               BorderBrush="{StaticResource BrushBorder}"
                                                               BorderThickness="1"
                                                               CornerRadius="3"
                                                               Padding="8,6"
                                                               Margin="0,0,0,3">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="35"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                </Grid.ColumnDefinitions>
                                                                
                                                                <!-- Position -->
                                                                <TextBlock Grid.Column="0"
                                                                          Text="{Binding Position, StringFormat='P{0}'}"
                                                                          FontSize="12"
                                                                          FontWeight="Bold"
                                                                          Foreground="{StaticResource BrushTeal}"
                                                                          VerticalAlignment="Center"/>
                                                                
                                                                <!-- Driver Name -->
                                                                <TextBlock Grid.Column="1"
                                                                          Text="{Binding DriverName}"
                                                                          FontSize="11"
                                                                          Foreground="White"
                                                                          VerticalAlignment="Center"
                                                                          Margin="10,0,0,0"/>
                                                                
                                                                <!-- Last Lap Time -->
                                                                <TextBlock Grid.Column="2"
                                                                          Text="{Binding LastLapTime}"
                                                                          FontSize="11"
                                                                          Foreground="#AAAAAA"
                                                                          VerticalAlignment="Center"
                                                                          HorizontalAlignment="Right"/>
                                                                
                                                                <!-- Best Lap Time -->
                                                                <TextBlock Grid.Column="3"
                                                                          Text="{Binding BestLapTime}"
                                                                          FontSize="11"
                                                                          FontWeight="Bold"
                                                                          Foreground="{StaticResource BrushGreen}"
                                                                          VerticalAlignment="Center"
                                                                          HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    
                                    <!-- Info Footer -->
                                    <Border Background="#1A1A1A"
                                           BorderBrush="{StaticResource BrushBorder}"
                                           BorderThickness="1"
                                           CornerRadius="4"
                                           Padding="12"
                                           Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ℹ️ Position Data"
                                                      FontSize="11"
                                                      FontWeight="Bold"
                                                      Foreground="{StaticResource BrushTeal}"
                                                      Margin="0,0,0,8"/>
                                            <TextBlock FontSize="10" Foreground="#888888" TextWrapping="Wrap">
                                                <Run Text="• Position tracking requires live telemetry data"/><LineBreak/>
                                                <Run Text="• Pit predictions include 45s base + fuel time"/><LineBreak/>
                                                <Run Text="• Gap calculations update in real-time"/><LineBreak/>
                                                <Run Text="• Strategic notes consider nearby car strategies"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    
                    <!-- Tab 4: Weather, Track & Pit Intelligence (Phase 10.7 & 10.8) -->
                    <TabItem Header="CONDITIONS">
                        <Grid Background="#1E1E1E" Margin="0,5,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                                <StackPanel>
                                    <!-- Header -->
                                    <TextBlock Text="Weather &amp; Track Conditions" 
                                              FontSize="16" 
                                              FontWeight="Bold"
                                              Foreground="{StaticResource BrushTeal}"
                                              Margin="0,0,0,15"/>
                                    
                                    <!-- Current Conditions -->
                                    <Border Background="#252525"
                                           BorderBrush="{StaticResource BrushTeal}"
                                           BorderThickness="2"
                                           CornerRadius="4"
                                           Padding="15"
                                           Margin="0,0,0,15">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Air Temperature -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                                      Text="Air Temperature:" 
                                                      Foreground="#AAAAAA" 
                                                      Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                                      x:Name="AirTempText"
                                                      Text="22.5°C"
                                                      Foreground="White"
                                                      FontWeight="Bold"
                                                      Margin="0,0,0,8"/>
                                            
                                            <!-- Track Temperature -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" 
                                                      Text="Track Temperature:" 
                                                      Foreground="#AAAAAA" 
                                                      Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                                      x:Name="TrackTempText"
                                                      Text="35.2°C"
                                                      Foreground="{StaticResource BrushOrange}"
                                                      FontWeight="Bold"
                                                      Margin="0,0,0,8"/>
                                            
                                            <!-- Temperature Trend -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" 
                                                      Text="Trend:" 
                                                      Foreground="#AAAAAA" 
                                                      Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" 
                                                      x:Name="TempTrendText"
                                                      Text="Track warming +1.2°C/10min"
                                                      Foreground="{StaticResource BrushGreen}"
                                                      Margin="0,0,0,8"/>
                                            
                                            <!-- Grip Estimate -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" 
                                                      Text="Grip Level:" 
                                                      Foreground="#AAAAAA"
                                                      Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" 
                                                      x:Name="GripLevelText"
                                                      Text="Optimal (Warm Track)"
                                                      Foreground="{StaticResource BrushGreen}"
                                                      FontWeight="Bold"
                                                      Margin="0,0,0,8"/>
                                            
                                            <!-- Sky Conditions -->
                                            <TextBlock Grid.Row="4" Grid.Column="0" 
                                                      Text="Sky:" 
                                                      Foreground="#AAAAAA"
                                                      Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" 
                                                      x:Name="SkyConditionText"
                                                      Text="Clear"
                                                      Foreground="White"
                                                      Margin="0,0,0,8"/>
                                            
                                            <!-- Track Surface -->
                                            <TextBlock Grid.Row="5" Grid.Column="0" 
                                                      Text="Track Surface:" 
                                                      Foreground="#AAAAAA"
                                                      Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" 
                                                      x:Name="TrackWetnessText"
                                                      Text="Dry"
                                                      Foreground="{StaticResource BrushGreen}"
                                                      FontWeight="Bold"
                                                      Margin="0,0,0,8"/>
                                            
                                            <!-- Wind -->
                                            <TextBlock Grid.Row="6" Grid.Column="0" 
                                                      Text="Wind:" 
                                                      Foreground="#AAAAAA"
                                                      Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="6" Grid.Column="1" 
                                                      x:Name="WindText"
                                                      Text="--"
                                                      Foreground="White"
                                                      Margin="0,0,0,8"/>
                                            
                                            <!-- Humidity -->
                                            <TextBlock Grid.Row="7" Grid.Column="0" 
                                                      Text="Humidity:" 
                                                      Foreground="#AAAAAA"
                                                      Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="7" Grid.Column="1" 
                                                      x:Name="HumidityText"
                                                      Text="--"
                                                      Foreground="White"
                                                      Margin="0,0,0,8"/>
                                            
                                            <!-- Pressure -->
                                            <TextBlock Grid.Row="8" Grid.Column="0" 
                                                      Text="Pressure:" 
                                                      Foreground="#AAAAAA"
                                                      Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="8" Grid.Column="1" 
                                                      x:Name="PressureText"
                                                      Text="--"
                                                      Foreground="White"
                                                      Margin="0,0,0,8"/>
                                            
                                            <!-- Air Density -->
                                            <TextBlock Grid.Row="9" Grid.Column="0" 
                                                      Text="Air Density:" 
                                                      Foreground="#AAAAAA"/>
                                            <TextBlock Grid.Row="9" Grid.Column="1" 
                                                      x:Name="AirDensityText"
                                                      Text="--"
                                                      Foreground="White"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Pit Intelligence -->
                                    <TextBlock Text="Pit Stop Intelligence" 
                                              FontSize="14" 
                                              FontWeight="Bold"
                                              Foreground="{StaticResource BrushTeal}"
                                              Margin="0,10,0,10"/>
                                    
                                    <!-- Damage Assessment -->
                                    <Border Background="#252525"
                                           BorderBrush="{StaticResource BrushBorder}"
                                           BorderThickness="1"
                                           CornerRadius="4"
                                           Padding="12"
                                           Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="🔧 Damage Assessment"
                                                      FontSize="12"
                                                      FontWeight="Bold"
                                                      Foreground="{StaticResource BrushTeal}"
                                                      Margin="0,0,0,8"/>
                                            <TextBlock x:Name="DamageStatusText"
                                                      Text="No damage detected"
                                                      FontSize="11"
                                                      Foreground="#AAAAAA"
                                                      Margin="0,0,0,5"/>
                                            <TextBlock x:Name="DamageRecommendationText"
                                                      Text="Vehicle in good condition"
                                                      FontSize="10"
                                                      Foreground="#888888"
                                                      TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Pit Service Estimate -->
                                    <Border Background="#252525"
                                           BorderBrush="{StaticResource BrushBorder}"
                                           BorderThickness="1"
                                           CornerRadius="4"
                                           Padding="12"
                                           Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="⏱️ Next Pit Stop Estimate"
                                                      FontSize="12"
                                                      FontWeight="Bold"
                                                      Foreground="{StaticResource BrushTeal}"
                                                      Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                                          Text="Fuel Time:" 
                                                          FontSize="10" 
                                                          Foreground="#888888"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" 
                                                          x:Name="PitFuelTimeText"
                                                          Text="16.3s"
                                                          FontSize="10" 
                                                          Foreground="White"/>
                                                
                                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                                          Text="Total Time:" 
                                                          FontSize="10" 
                                                          Foreground="#888888"
                                                          Margin="0,3,0,0"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" 
                                                          x:Name="PitTotalTimeText"
                                                          Text="31.3s"
                                                          FontSize="11" 
                                                          FontWeight="Bold"
                                                          Foreground="{StaticResource BrushOrange}"
                                                          Margin="0,3,0,0"/>
                                                
                                                <TextBlock Grid.Row="2" Grid.Column="0" 
                                                          Text="Action:" 
                                                          FontSize="10" 
                                                          Foreground="#888888"
                                                          Margin="0,3,0,0"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" 
                                                          x:Name="PitActionText"
                                                          Text="Fuel + Tire change"
                                                          FontSize="10" 
                                                          Foreground="{StaticResource BrushTeal}"
                                                          Margin="0,3,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Info Footer -->
                                    <Border Background="#1A1A1A"
                                           BorderBrush="{StaticResource BrushBorder}"
                                           BorderThickness="1"
                                           CornerRadius="4"
                                           Padding="12"
                                           Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ℹ️ Conditions Monitoring"
                                                      FontSize="11"
                                                      FontWeight="Bold"
                                                      Foreground="{StaticResource BrushTeal}"
                                                      Margin="0,0,0,8"/>
                                            <TextBlock FontSize="10" Foreground="#888888" TextWrapping="Wrap">
                                                <Run Text="• Weather tracking updates every telemetry tick"/><LineBreak/>
                                                <Run Text="• Grip estimates based on track temperature"/><LineBreak/>
                                                <Run Text="• Pit service times are estimates"/><LineBreak/>
                                                <Run Text="• Damage assessment uses incident count"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
                
                <!-- Footer with Last Update -->
                <Border Grid.Row="2" 
                       Background="#252525" 
                       BorderBrush="{StaticResource BrushBorder}"
                       BorderThickness="1"
                       CornerRadius="4"
                       Padding="10"
                       Margin="0,10,0,0">
                    <Grid>
                        <TextBlock x:Name="LastUpdateText" 
                                  Text="Last update: --"
                                  FontSize="10"
                                  Foreground="#666666"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="Press ESC to close" 
                                  FontSize="10"
                                  Foreground="#666666"
                                  HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
