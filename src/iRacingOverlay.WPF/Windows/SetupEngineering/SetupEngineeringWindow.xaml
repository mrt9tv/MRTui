<Window x:Class="iRacingOverlay.WPF.Windows.SetupEngineering.SetupEngineeringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Setup Engineering Mode - MRT Overlay"
        Width="1200" Height="800"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#1E1E1E"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="14">
    
    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- TextBlock Header Style -->
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#00D4FF"/>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3E3E42"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#2D2D30"/>
            <Setter Property="RowBackground" Value="#252526"/>
        </Style>
        
        <!-- DataGrid Column Header Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#00D4FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="🔧 SETUP ENGINEERING MODE" Style="{StaticResource HeaderText}"/>
            <TextBlock x:Name="TrackCarText" Text="" Margin="20,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="#888"/>
        </StackPanel>

        <!-- Session Info Bar -->
        <Border Grid.Row="1" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Session: " FontWeight="SemiBold"/>
                    <TextBlock x:Name="SessionNameText" Text="No Active Session"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Laps: " FontWeight="SemiBold"/>
                    <TextBlock x:Name="LapCountText" Text="0"/>
                    <TextBlock Text=" | Valid: " Margin="10,0,0,0" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ValidLapCountText" Text="0"/>
                    <TextBlock Text=" | Outliers: " Margin="10,0,0,0" FontWeight="SemiBold"/>
                    <TextBlock x:Name="OutlierCountText" Text="0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="StartSessionButton" Content="Start Session" Style="{StaticResource ModernButton}" Click="StartSessionButton_Click" Margin="0,0,5,0"/>
                    <Button x:Name="EndSessionButton" Content="End Session" Style="{StaticResource ModernButton}" Click="EndSessionButton_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Setup Comparison -->
            <GroupBox Grid.Column="0" Header="SETUP COMPARISON">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Baseline Setup -->
                    <StackPanel Grid.Row="0" Margin="0,5">
                        <TextBlock Text="Baseline Setup:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="BaselineSetupCombo" Height="30" Background="#2D2D30" Foreground="White" SelectionChanged="BaselineSetupCombo_SelectionChanged"/>
                    </StackPanel>

                    <!-- Modified Setup -->
                    <StackPanel Grid.Row="1" Margin="0,10">
                        <TextBlock Text="Modified Setup:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ModifiedSetupCombo" Height="30" Background="#2D2D30" Foreground="White" SelectionChanged="ModifiedSetupCombo_SelectionChanged"/>
                    </StackPanel>

                    <!-- Compare Button -->
                    <Button Grid.Row="2" x:Name="CompareButton" Content="Compare Setups" Style="{StaticResource ModernButton}" Click="CompareButton_Click" Margin="0,10" Height="35" IsEnabled="False"/>

                    <!-- Comparison Results -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel x:Name="ComparisonResultsPanel">
                            <TextBlock Text="Select two setups to compare" Foreground="#888" TextAlignment="Center" Margin="0,20"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Actions -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="ExportCSVButton" Content="Export CSV" Style="{StaticResource ModernButton}" Click="ExportCSVButton_Click" Margin="0,0,5,0" IsEnabled="False"/>
                        <Button x:Name="LoadSetupFileButton" Content="Load .sto File" Style="{StaticResource ModernButton}" Click="LoadSetupFileButton_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Right Panel: Tabs -->
            <TabControl x:Name="MainTabControl" Grid.Column="1" Background="#1E1E1E" BorderBrush="#3E3E42" Margin="5,0,0,0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Padding="10,5" Margin="2,0,0,0">
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#007ACC"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- Sector Analysis Tab -->
                <TabItem Header="Sector Analysis">
                    <Grid Margin="10">
                        <DataGrid x:Name="SectorDataGrid" ItemsSource="{Binding SectorComparisons}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sector" Binding="{Binding SectorNumber}" Width="80"/>
                                <DataGridTextColumn Header="Baseline (s)" Binding="{Binding BaselineAvg, StringFormat=F3}" Width="*"/>
                                <DataGridTextColumn Header="Modified (s)" Binding="{Binding ModifiedAvg, StringFormat=F3}" Width="*"/>
                                <DataGridTextColumn Header="Delta (s)" Binding="{Binding DeltaSeconds, StringFormat=+0.000;-0.000}" Width="*"/>
                                <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, StringFormat=P0}" Width="*"/>
                                <DataGridTextColumn Header="Significant" Binding="{Binding IsSignificant}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Lap Data Tab -->
                <TabItem Header="Lap Data">
                    <Grid Margin="10">
                        <DataGrid x:Name="LapDataGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Lap #" Binding="{Binding LapNumber}" Width="60"/>
                                <DataGridTextColumn Header="Lap Time" Binding="{Binding LapTime, StringFormat=F3}" Width="100"/>
                                <DataGridTextColumn Header="S1" Binding="{Binding Sector1, StringFormat=F3}" Width="80"/>
                                <DataGridTextColumn Header="S2" Binding="{Binding Sector2, StringFormat=F3}" Width="80"/>
                                <DataGridTextColumn Header="S3" Binding="{Binding Sector3, StringFormat=F3}" Width="80"/>
                                <DataGridTextColumn Header="Fuel Used" Binding="{Binding FuelUsed, StringFormat=F2}" Width="90"/>
                                <DataGridTextColumn Header="Valid" Binding="{Binding IsValid}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Live Behavior Analysis Tab (Phase 3.7) -->
                <TabItem Header="🔍 Live Analysis">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="🧠 Neural Network Setup Advisor" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="Automatic handling detection - no user input required!" FontSize="12" Foreground="#00D4FF"/>
                        </StackPanel>

                        <!-- Status Summary -->
                        <Border Grid.Row="1" Background="#1E1E1E" Padding="15" CornerRadius="5" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Laps Analyzed" FontSize="11" Foreground="#888" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="LiveAnalysisLapCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="#00D4FF"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Primary Issue" FontSize="11" Foreground="#888" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="LiveAnalysisPrimaryIssue" Text="--" FontSize="14" FontWeight="Bold" Foreground="#FFA500"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Oversteer" FontSize="11" Foreground="#888" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="LiveAnalysisOversteer" Text="0.0/10" FontSize="14" FontWeight="Bold" Foreground="#FF6B6B"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Understeer" FontSize="11" Foreground="#888" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="LiveAnalysisUndersteer" Text="0.0/10" FontSize="14" FontWeight="Bold" Foreground="#FF6B6B"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Recommendations List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="LiveBehaviorPanel">
                                <TextBlock Text="🏁 Run 5-10 laps, then click 'Analyze Driving' below" Foreground="#888" TextAlignment="Center" Margin="0,40" FontSize="14"/>
                                <TextBlock Text="System will automatically detect oversteer, understeer, and lockups" Foreground="#666" TextAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Action Button -->
                        <Button Grid.Row="3" x:Name="AnalyzeDrivingButton" Content="🔍 Analyze Driving Behavior (Last 10 Laps)" Style="{StaticResource ModernButton}" Click="AnalyzeDrivingButton_Click" Margin="0,10,0,0" Height="40" IsEnabled="True" FontWeight="Bold"/>
                    </Grid>
                </TabItem>

                <!-- ML Recommendations Tab -->
                <TabItem Header="ML Recommendations">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="🤖 Next Test Suggestions" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="MLRecommendationsPanel">
                                <TextBlock Text="💡 Click 'Generate ML Recommendations' to analyze live telemetry data" Foreground="#888" TextAlignment="Center" Margin="0,20"/>
                                <TextBlock Text="No .sto files required - works with live session data!" Foreground="#00D4FF" FontSize="12" TextAlignment="Center" Margin="0,10"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="2" x:Name="GenerateMLButton" Content="🤖 Generate ML Recommendations (Live Data)" Style="{StaticResource ModernButton}" Click="GenerateMLButton_Click" Margin="0,10,0,0" Height="35" IsEnabled="True"/>
                    </Grid>
                </TabItem>

                <!-- Setup Changes Tab -->
                <TabItem Header="Setup Changes">
                    <Grid Margin="10">
                        <DataGrid x:Name="SetupChangesDataGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                                <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="*"/>
                                <DataGridTextColumn Header="Baseline" Binding="{Binding BaselineValue}" Width="100"/>
                                <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedValue}" Width="100"/>
                                <DataGridTextColumn Header="Delta" Binding="{Binding Delta}" Width="100"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#007ACC" Padding="10" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Text="Ready. Start a session to begin setup engineering." FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
